      .adm-form legend { padding: 0 8px; font-family: var(--font-label); font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--yellow); }
      .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px 20px; }
      .grid-2 .wide { grid-column: 1 / -1; }
      .adm-form label { display: flex; flex-direction: column; gap: 6px; font-size: 13px; color: var(--text-muted); }
      .adm-form input:not([type='checkbox']):not([type='file']), .adm-form select, .adm-form textarea {
        width: 100%; font: inherit; font-size: 15px; color: var(--text); background: var(--surface);
        border: 1px solid var(--line-strong); border-radius: var(--radius); padding: 9px 11px;
      }
      .adm-form input:focus, .adm-form select:focus, .adm-form textarea:focus { outline: 2px solid var(--yellow); outline-offset: 0; border-color: transparent; }
      .adm-form textarea { resize: vertical; line-height: 1.5; }
      .adm-form .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 14px; }
      .prefix { display: flex; align-items: stretch; }
      .prefix > span { display: flex; align-items: center; padding: 0 10px; background: var(--surface-2); border: 1px solid var(--line-strong); border-right: 0; border-radius: var(--radius) 0 0 var(--radius); color: var(--text-dim); font-size: 14px; }
      .prefix input { border-radius: 0 var(--radius) var(--radius) 0 !important; }
      .checks { display: flex; flex-direction: column; gap: 10px; justify-content: flex-end; }
      .adm-form .check { flex-direction: row; align-items: center; gap: 8px; font-size: 15px; color: var(--text); }
      .check input { accent-color: var(--yellow); width: 18px; height: 18px; }
      .hint { margin: 0 0 14px; font-size: 13px; color: var(--text-dim); }
      .hint code, .adm-note code { color: var(--text-muted); }

      .img-row { display: grid; grid-template-columns: 260px 1fr; gap: 20px; align-items: start; }
      #img-preview { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius); background: var(--surface); }
      .img-fields { display: flex; flex-direction: column; gap: 14px; }
      .upload input { font-size: 14px; color: var(--text-muted); }

      .fechas { margin-bottom: 12px; }
      .fechas td { padding: 6px 6px 6px 0; border: 0; }
      .fechas td:nth-child(3) { width: 40%; }
      .icon-btn { background: none; border: 1px solid var(--line-strong); color: var(--text-muted); border-radius: var(--radius); width: 38px; height: 38px; cursor: pointer; }
      .icon-btn:hover { color: #ff6b5b; border-color: #ff6b5b; }

      .btn-danger { background: transparent; border: 2px solid rgba(255, 107, 91, 0.5); color: #ff8a7d; }
      .btn-danger:hover { background: rgba(255, 107, 91, 0.12); }

      .adm-savebar {
        position: sticky; bottom: 0; display: flex; justify-content: flex-end; align-items: center; gap: 16px;
        padding: 16px 0 20px; margin-top: -4px; background: linear-gradient(transparent, var(--bg-2) 30%);
      }
      [role='status'][data-tipo='ok'] { color: #7bd88f; }
      [role='status'][data-tipo='err'] { color: #ff8a7d; }

      .adm-head .hint { max-width: 70ch; margin: 10px 0 0; }
      .lista { grid-column: 1 / -1; margin: 18px 0 4px; }
      .lista-titulo { margin: 0 0 8px; font-family: var(--font-label); font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; font-size: 13px; color: var(--text-muted); }
      .lista-items { display: flex; flex-direction: column; gap: 8px; margin-bottom: 10px; }
      .item { border: 1px solid var(--line-strong); border-radius: var(--radius); background: var(--bg-2); }
      .item[open] { border-color: rgba(247, 196, 0, 0.45); }
      .item summary { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 8px 8px 8px 14px; cursor: pointer; list-style: none; }
      .item summary::-webkit-details-marker { display: none; }
      .item summary::before { content: '▸'; color: var(--yellow); margin-right: -4px; }
      .item[open] > summary::before { content: '▾'; }
      .item-titulo { flex: 1; font-weight: 600; color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .item-cuerpo { padding: 4px 14px 16px; border-top: 1px solid var(--line); }
      .item-cuerpo > .grid-2 { margin-top: 12px; }
      .item-acciones { display: flex; gap: 4px; flex-shrink: 0; }
      .item-acciones .icon-btn { width: 32px; height: 32px; }
      .icon-btn:disabled { opacity: 0.3; cursor: default; }
      .icon-btn:disabled:hover { color: var(--text-muted); border-color: var(--line-strong); }
      .item-texto { display: flex; gap: 8px; align-items: center; }
      .item-texto input { flex: 1; }
      .adm-form fieldset fieldset { background: var(--bg-2); margin: 18px 0 0; }
      .adm-form fieldset.raiz { padding-top: 4px; }
      .adm-form input:disabled { opacity: 0.6; }
      img.mini { width: 160px; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius); background: var(--surface); }

      @media (max-width: 820px) {
        .adm { grid-template-columns: 1fr; }
        .adm-side { position: static; height: auto; flex-direction: row; flex-wrap: wrap; align-items: center; padding: 16px; }
        .adm-side nav { flex-direction: row; }
        .adm-note { display: none; }
        .grid-2, .img-row { grid-template-columns: 1fr; }
        .adm-table.fechas thead { display: none; }
        .adm-table.fechas tr { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; padding-bottom: 12px; border-bottom: 1px solid var(--line); }
        .fechas td:nth-child(3) { width: auto; }
      }
    </style>
  </body>
</html>
