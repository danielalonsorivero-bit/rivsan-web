---
// Panel de administración: en local con `npm run dev` o publicado en Vercel. Ver admin/integration.mjs.
// Con `demo` (página /panel-demo/) funciona sin servidor: los datos de la web se incrustan al
// compilar y los cambios se guardan solo en el navegador (sessionStorage), sin tocar archivos.
import '../../src/styles/global.css';
import { getImage } from 'astro:assets';
import Gate from '../../src/components/Gate.astro';
import empresa from '../../src/data/empresa.json';
import { parseCurso } from '../api.mjs';
import { SECCIONES } from '../esquemas.mjs';

interface Props {
  demo?: boolean;
}
const { demo = false } = Astro.props;

let seed = '';
if (demo) {
  const raws = import.meta.glob<string>('/src/content/cursos/*.md', { query: '?raw', import: 'default', eager: true });
  const cursos = Object.entries(raws).map(([path, texto]) => ({ slug: path.split('/').pop()!.slice(0, -3), ...parseCurso(texto) }));
  const files = import.meta.glob<ImageMetadata>('/src/assets/img/*.{jpg,jpeg,png,webp,avif}', { import: 'default', eager: true });
  const imagenes: Record<string, string> = {};
  for (const [path, img] of Object.entries(files)) {
    imagenes[path.split('/').pop()!] = (await getImage({ src: img, width: 520, format: 'webp' })).src;
  }
  // Escapado de «<» para que el texto de los cursos no pueda cerrar la etiqueta <script>
  const jsons = import.meta.glob('/src/data/contenido/*.json', { import: 'default', eager: true });
  const contenido = Object.fromEntries(Object.entries(jsons).map(([path, d]) => [path.split('/').pop()!.slice(0, -5), d]));
  seed = JSON.stringify({ cursos, empresa, imagenes, contenido }).replace(/</g, '\\u003c');
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{demo ? 'Demo del panel · RIVSAN' : 'Panel · RIVSAN'}</title>
  </head>
  <body data-demo={demo ? '' : undefined}>
    {demo && <Gate />}
    {demo && <script type="application/json" id="demo-seed" set:html={seed} />}
    <div class="adm">
      <aside class="adm-side">
        <a class="adm-brand" href={demo ? '/panel-demo/' : '/admin/'}>RIVSAN <span>Panel</span></a>
        <nav aria-label="Secciones del panel">
          <a href="#/cursos" data-tab="cursos">Cursos</a>
          {SECCIONES.map((sec) => <a href={`#/contenido/${sec.id}`} data-tab={sec.id}>{sec.titulo}</a>)}
          <a href="#/empresa" data-tab="empresa">Datos de empresa</a>
        </nav>
        {
          demo ? (
            <p class="adm-note">Demostración. Los cambios se guardan solo en este navegador y no modifican la web. En la versión final el panel será privado, con acceso por usuario.</p>
          ) : (
            <p class="adm-note" id="adm-nota" />
          )
        }
        {!demo && <button type="button" class="adm-salir" id="adm-salir" hidden>Cerrar sesión</button>}
        <a class="adm-site" href="/" target="_blank" rel="noopener">Ver la web ↗</a>
      </aside>

      <main class="adm-main" id="main">
        {
          demo && (
            <div class="demo-bar" role="note">
              <span><strong>Modo demostración.</strong> Prueba a editar cualquier sección: los cambios no salen de tu navegador.</span>
              <button type="button" class="demo-reset" id="demo-reset">Restablecer datos</button>
            </div>
          )
        }
        <!-- Acceso (solo si el servidor pide contraseña) -->
        <section id="v-login" hidden>
          <header class="adm-head"><h1>Acceso al panel</h1></header>
          <form class="adm-form adm-login" id="f-login">
            <fieldset>
              <label>
                Contraseña
                <span class="clave">
                  <input type="password" name="clave" required autocomplete="current-password" />
                  <button type="button" class="clave-ver" id="clave-ver" aria-label="Mostrar contraseña" aria-pressed="false">
                    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z" />
                      <circle cx="12" cy="12" r="3" />
                      <path class="tachado" d="M4 4l16 16" />
                    </svg>
                  </button>
                </span>
              </label>
              <button class="btn btn-primary" type="submit">Entrar</button>
              <span id="login-estado" role="status"></span>
              <details class="olvido">
                <summary>¿Has olvidado la contraseña?</summary>
                <p>
                  Hay una única contraseña para el panel. Quien administra el proyecto en Vercel puede cambiarla en
                  <em>Settings → Environment Variables → ADMIN_PASSWORD</em> y volver a desplegar
                  (<em>Deployments → ⋯ → Redeploy</em>). Al cambiarla se cierran todas las sesiones abiertas.
                </p>
              </details>
            </fieldset>
          </form>
        </section>

        <!-- Lista de cursos -->
        <section id="v-lista" hidden>
          <header class="adm-head">
            <h1>Cursos</h1>
            <a class="btn btn-primary" href="#/cursos/nuevo">Nuevo curso</a>
          </header>
          <table class="adm-table">
            <thead>
              <tr><th>Curso</th><th>Categoría</th><th>Próximas fechas</th><th>Orden</th><th><span class="visually-hidden">Acciones</span></th></tr>
            </thead>
            <tbody id="lista-cursos"></tbody>
          </table>
        </section>

        <!-- Editor de curso -->
        <section id="v-curso" hidden>
          <header class="adm-head">
            <div>
              <a class="adm-back" href="#/cursos">← Cursos</a>
              <h1 id="curso-titulo">Curso</h1>
            </div>
            <div class="adm-actions">
              <a class="btn btn-ghost" id="curso-ver" target="_blank" rel="noopener">Ver en la web ↗</a>
              <button type="button" class="btn btn-danger" id="curso-borrar">Borrar</button>
            </div>
          </header>

          <form id="f-curso" class="adm-form" novalidate>
            <fieldset>
              <legend>General</legend>
              <div class="grid-2">
                <label class="wide">Título<input name="titulo" required /></label>
                <label>URL (identificador)
                  <span class="prefix"><span>/formacion/</span><input name="slug" required pattern="[a-z0-9]+(-[a-z0-9]+)*" /></span>
                </label>
                <label>Categoría
                  <select name="categoria" required>
                    <option value="simulador">Simulador VR</option>
                    <option value="auxilios">Primeros auxilios tácticos</option>
                    <option value="fuerza">Uso de la fuerza no letal</option>
                  </select>
                </label>
                <label class="wide">Resumen<textarea name="resumen" rows="2" required></textarea></label>
              </div>
            </fieldset>

            <fieldset>
              <legend>Imagen</legend>
              <div class="img-row">
                <img id="img-preview" alt="" />
                <div class="img-fields">
                  <label>Archivo<select name="imagen" id="img-select" required></select></label>
                  <label class="upload">o sube una nueva<input type="file" id="img-upload" accept="image/jpeg,image/png,image/webp,image/avif" /></label>
                  <label>Texto alternativo (describe la foto)<input name="imagenAlt" required /></label>
                </div>
              </div>
            </fieldset>

            <fieldset>
              <legend>Ficha</legend>
              <div class="grid-2">
                <label>Duración<input name="duracion" required placeholder="12 h" /></label>
                <label>Plazas por convocatoria<input name="asistentes" type="number" min="1" required /></label>
                <label>Modalidad<input name="modalidad" required /></label>
                <label>Dirigido a<input name="dirigidoA" required /></label>
                <label class="wide">Acreditación<input name="acreditacion" required /></label>
                <label>Orden en el catálogo<input name="orden" type="number" /></label>
                <div class="checks">
                  <label class="check"><input type="checkbox" name="aDemanda" /> Se imparte también a demanda</label>
                  <label class="check"><input type="checkbox" name="ejemplo" /> Contenido de ejemplo (muestra aviso)</label>
                </div>
              </div>
            </fieldset>

            <fieldset>
              <legend>Convocatorias</legend>
              <p class="hint">Las fechas pasadas no se muestran en la web. Deja «plazas libres» vacío si no quieres indicarlo; 0 = completo.</p>
              <table class="adm-table fechas">
                <thead><tr><th>Inicio</th><th>Fin (opcional)</th><th>Lugar</th><th>Plazas libres</th><th><span class="visually-hidden">Quitar</span></th></tr></thead>
                <tbody id="fechas"></tbody>
              </table>
              <button type="button" class="btn btn-ghost" id="add-fecha">+ Añadir convocatoria</button>
            </fieldset>

            <fieldset>
              <legend>Contenido</legend>
              <p class="hint">Markdown: <code>## Título</code> para apartados, <code>- </code> para listas, <code>**negrita**</code>.</p>
              <textarea name="body" rows="18" class="mono"></textarea>
            </fieldset>

            <div class="adm-savebar">
              <span id="curso-estado" role="status"></span>
              <button type="submit" class="btn btn-primary">Guardar</button>
            </div>
          </form>
        </section>

        <!-- Datos de empresa -->
        <section id="v-empresa" hidden>
          <header class="adm-head"><h1>Datos de empresa</h1></header>
          <form id="f-empresa" class="adm-form">
            <fieldset>
              <legend>Contacto</legend>
              <div class="grid-2">
                <label>Email<input name="email" type="email" /></label>
                <label>Teléfono<input name="phone" /></label>
                <label>Email de privacidad<input name="privacyEmail" type="email" /></label>
              </div>
            </fieldset>
            <fieldset>
              <legend>Datos fiscales y dirección</legend>
              <div class="grid-2">
                <label>Razón social<input name="legalName" /></label>
                <label>CIF<input name="cif" /></label>
                <label class="wide">Dirección<input name="street" /></label>
                <label>Código postal<input name="postalCode" /></label>
                <label>Ciudad<input name="city" /></label>
                <label class="wide">Registro mercantil<input name="registry" /></label>
              </div>
            </fieldset>
            <fieldset>
              <legend>Textos generales</legend>
              <div class="grid-2">
                <label class="wide">Lema<input name="tagline" /></label>
                <label class="wide">Descripción (buscadores y redes)<textarea name="description" rows="3"></textarea></label>
              </div>
            </fieldset>
            <div class="adm-savebar">
              <span id="empresa-estado" role="status"></span>
              <button type="submit" class="btn btn-primary">Guardar</button>
            </div>
          </form>
        </section>

        <!-- Secciones de contenido (esquemas en admin/esquemas.mjs) -->
        <section id="v-contenido" hidden>
          <header class="adm-head">
            <div>
              <h1 id="contenido-titulo"></h1>
              <p class="hint" id="contenido-desc"></p>
            </div>
            <div class="adm-actions">
              <a class="btn btn-ghost" id="contenido-ver" target="_blank" rel="noopener">Ver en la web ↗</a>
            </div>
          </header>
          <form id="f-contenido" class="adm-form" novalidate>
            <div id="contenido-campos"></div>
            <div class="adm-savebar">
              <span id="contenido-estado" role="status"></span>
              <button type="submit" class="btn btn-primary">Guardar</button>
            </div>
          </form>
        </section>
      </main>
    </div>

    <template id="tpl-fecha">
      <tr>
        <td><input type="date" data-k="inicio" required aria-label="Inicio" /></td>
        <td><input type="date" data-k="fin" aria-label="Fin" /></td>
        <td><input data-k="lugar" required aria-label="Lugar" /></td>
        <td><input type="number" min="0" data-k="plazasLibres" aria-label="Plazas libres" /></td>
        <td><button type="button" class="icon-btn" data-quitar aria-label="Quitar convocatoria">✕</button></td>
      </tr>
    </template>

    <script>
      import { normalizar, seccion } from '../esquemas.mjs';

      type Fecha = { inicio: string; fin?: string; lugar: string; plazasLibres?: number | string };
      type Curso = Record<string, any> & { slug: string; fechas: Fecha[] };

      const $ = <T extends Element = HTMLElement>(s: string, el: ParentNode = document) => el.querySelector(s) as T;
      const CATEGORIAS: Record<string, string> = { simulador: 'Simulador VR', auxilios: 'Primeros auxilios', fuerza: 'Fuerza no letal' };
      const DEMO = document.body.hasAttribute('data-demo');
      const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');

      // ---------- Modo demostración: API simulada en el navegador ----------
      type DemoCurso = { slug: string; data: Record<string, any>; body: string };
      type DemoState = { cursos: DemoCurso[]; empresa: Record<string, string>; imagenes: Record<string, string>; contenido: Record<string, any> };
      const DEMO_KEY = 'rivsan-panel-demo';
      const SEED: DemoState | null = DEMO ? JSON.parse(document.getElementById('demo-seed')!.textContent!) : null;
      const SLUGS_WEB = new Set(SEED?.cursos.map((c) => c.slug) ?? []);
      // Las imágenes subidas solo viven en memoria (pesan demasiado para sessionStorage)
      const subidas: Record<string, string> = {};

      function demoLeer(): DemoState {
        try {
          const s = sessionStorage.getItem(DEMO_KEY);
          // Las sesiones de antes de las secciones de contenido no las traen
          if (s) return { contenido: structuredClone(SEED!.contenido), ...JSON.parse(s) };
        } catch {}
        return structuredClone(SEED!);
      }
      function demoGuardar(st: DemoState) {
        try {
          sessionStorage.setItem(DEMO_KEY, JSON.stringify(st));
        } catch {}
      }

      async function demoApi(path: string, opts: RequestInit): Promise<any> {
        await new Promise((r) => setTimeout(r, 120)); // simula la ida y vuelta al servidor
        const st = demoLeer();
        const m = opts.method ?? 'GET';
        const [recurso, rawId] = path.split('/');
        const id = rawId ? decodeURIComponent(rawId) : '';
        const body = opts.body ? JSON.parse(String(opts.body)) : {};

        if (recurso === 'cursos' && !id) {
          return st.cursos
            .map((c) => ({ slug: c.slug, ...c.data }))
            .sort((a, b) => (a.orden ?? 100) - (b.orden ?? 100) || a.titulo.localeCompare(b.titulo));
        }
        if (recurso === 'cursos' && m === 'GET') {
          const c = st.cursos.find((x) => x.slug === id);
          if (!c) throw new Error('Curso no encontrado');
          return c;
        }
        if (recurso === 'cursos' && m === 'PUT') {
          const destino = body.nuevoSlug || id;
          if (!/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(destino)) throw new Error('Identificador no válido (solo minúsculas, números y guiones)');
          if ((body.crear || destino !== id) && st.cursos.some((c) => c.slug === destino)) throw new Error(`Ya existe un curso con la URL «${destino}»`);
          const data = { ...body.data, fechas: (body.data.fechas ?? []).filter((f: Fecha) => f.inicio && f.lugar) };
          st.cursos = st.cursos.filter((c) => c.slug !== id && c.slug !== destino);
          st.cursos.push({ slug: destino, data, body: body.body ?? '' });
          demoGuardar(st);
          return { slug: destino };
        }
        if (recurso === 'cursos' && m === 'DELETE') {
          st.cursos = st.cursos.filter((c) => c.slug !== id);
          demoGuardar(st);
          return { ok: true };
        }
        if (recurso === 'imagenes' && m === 'GET') return [...Object.keys(st.imagenes), ...Object.keys(subidas)].sort();
        if (recurso === 'imagenes' && m === 'POST') {
          const ext = (body.nombre?.match(/\.(jpe?g|png|webp|avif)$/i)?.[0] ?? '').toLowerCase();
          if (!ext) throw new Error('Sube una imagen JPG, PNG, WebP o AVIF');
          const base = slugify(body.nombre.slice(0, -ext.length)) || 'imagen';
          let nombre = base + ext;
          for (let i = 2; nombre in st.imagenes || nombre in subidas; i++) nombre = `${base}-${i}${ext}`;
          subidas[nombre] = `data:image/${ext.slice(1).replace('jpg', 'jpeg')};base64,${body.base64}`;
          return { nombre };
        }
        if (recurso === 'contenido' && seccion(id)) {
          if (m === 'GET') return st.contenido[id];
          const { datos, errores } = normalizar(seccion(id).campos, body, st.contenido[id]);
          if (errores.length) throw new Error(`Revisa: ${errores.slice(0, 3).join(' · ')}`);
          st.contenido[id] = datos;
          demoGuardar(st);
          return datos;
        }
        if (recurso === 'empresa' && m === 'GET') return st.empresa;
        if (recurso === 'empresa' && m === 'PUT') {
          for (const k of Object.keys(st.empresa)) if (typeof body[k] === 'string') st.empresa[k] = body[k].trim();
          demoGuardar(st);
          return st.empresa;
        }
        throw new Error('Ruta no encontrada');
      }

      const IMG_URL = (f: string) =>
        DEMO ? (subidas[f] ?? SEED!.imagenes[f] ?? '') : `/admin/api/imagen/?f=${encodeURIComponent(f)}`;

      // Guardado en GitHub (Vercel): la web tarda un poco en volver a publicarse
      let REMOTO = false;
      const GUARDADO = () => (REMOTO ? 'Guardado ✓ · la web se actualiza en 1–2 minutos' : 'Guardado ✓');

      async function api<T = any>(path: string, opts: RequestInit = {}): Promise<T> {
        if (DEMO) return demoApi(path, opts);
        const res = await fetch(`/admin/api/${path}/`, {
          ...opts,
          headers: { 'x-rivsan-admin': '1', 'Content-Type': 'application/json', ...opts.headers },
        });
        const json = await res.json().catch(() => ({}));
        // Sesión caducada a mitad de trabajo: se vuelve a pedir la contraseña
        if (res.status === 401 && path !== 'login') {
          mostrarLogin();
          throw new Error('Tu sesión ha caducado. Vuelve a entrar.');
        }
        if (res.status === 413) throw new Error('El archivo es demasiado grande');
        if (!res.ok) throw new Error(json.error ?? res.statusText);
        return json;
      }

      const esc = (s: unknown) => String(s ?? '').replace(/[&<>"]/g, (c) => `&${{ '&': 'amp', '<': 'lt', '>': 'gt', '"': 'quot' }[c]};`);
      const hoy = new Date().toISOString().slice(0, 10);
      const slugify = (s: string) =>
        s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

      function estado(el: HTMLElement, msg: string, tipo: 'ok' | 'err' | '' = '') {
        el.textContent = msg;
        el.dataset.tipo = tipo;
        // Astro recarga la página al cambiar un curso: se guarda el aviso unos segundos para mostrarlo tras recargar.
        if (tipo === 'ok') {
          try {
            sessionStorage.setItem('adm-aviso', JSON.stringify({ msg, t: Date.now() }));
          } catch {}
        }
      }

      function avisoPendiente() {
        try {
          const a = JSON.parse(sessionStorage.getItem('adm-aviso') ?? 'null');
          sessionStorage.removeItem('adm-aviso');
          const el = document.querySelector<HTMLElement>('section:not([hidden]) [role="status"]');
          if (a && el && Date.now() - a.t < 5000) estado(el, a.msg, 'ok');
        } catch {}
      }

      // ---------- Vistas ----------
      const vistas = ['v-login', 'v-lista', 'v-curso', 'v-empresa', 'v-contenido'];
      function mostrar(id: string, tab: string) {
        for (const v of vistas) $(`#${v}`).hidden = v !== id;
        document.querySelectorAll('[data-tab]').forEach((a) => a.toggleAttribute('aria-current', (a as HTMLElement).dataset.tab === tab));
      }

      async function router() {
        const [, parte, id] = location.hash.split('/');
        try {
          if (parte === 'empresa') {
            mostrar('v-empresa', 'empresa');
            await cargarEmpresa();
          } else if (parte === 'contenido' && id) {
            mostrar('v-contenido', id);
            await cargarContenido(decodeURIComponent(id));
          } else if (parte === 'cursos' && id) {
            mostrar('v-curso', 'cursos');
            await cargarCurso(id === 'nuevo' ? null : decodeURIComponent(id));
          } else {
            mostrar('v-lista', 'cursos');
            await cargarLista();
          }
        } catch (e) {
          alert((e as Error).message);
        }
        avisoPendiente();
        $('#main').scrollTo?.(0, 0);
      }

      // ---------- Lista ----------
      async function cargarLista() {
        const cursos = await api<Curso[]>('cursos');
        $('#lista-cursos').innerHTML = cursos
          .map((c) => {
            const futuras = c.fechas.filter((f) => (f.fin || f.inicio) >= hoy).sort((a, b) => a.inicio.localeCompare(b.inicio));
            const fechas = futuras.length
              ? futuras.map((f) => `${f.inicio.split('-').reverse().join('/')} · ${esc(f.lugar)}`).join('<br>')
              : '<span class="muted">Sin fechas</span>';
            return `<tr>
              <td><a class="adm-link" href="#/cursos/${encodeURIComponent(c.slug)}">${esc(c.titulo)}</a>${c.ejemplo ? ' <span class="tag">Ejemplo</span>' : ''}</td>
              <td>${esc(CATEGORIAS[c.categoria] ?? c.categoria)}</td>
              <td class="small">${fechas}</td>
              <td>${esc(c.orden ?? '')}</td>
              <td><a class="adm-link" href="#/cursos/${encodeURIComponent(c.slug)}">Editar</a></td>
            </tr>`;
          })
          .join('');
      }

      // ---------- Editor de curso ----------
      const fCurso = $<HTMLFormElement>('#f-curso');
      const imgSelect = $<HTMLSelectElement>('#img-select');
      let slugActual: string | null = null;
      let slugTocado = false;

      async function cargarImagenes(seleccion?: string) {
        const imgs = await api<string[]>('imagenes');
        imgSelect.innerHTML = imgs.map((f) => `<option>${esc(f)}</option>`).join('');
        if (seleccion) imgSelect.value = seleccion;
        previewImg();
      }
      function previewImg() {
        const img = $<HTMLImageElement>('#img-preview');
        img.src = imgSelect.value ? IMG_URL(imgSelect.value) : '';
      }

      function filaFecha(f: Partial<Fecha> = {}) {
        const tr = ($<HTMLTemplateElement>('#tpl-fecha').content.cloneNode(true) as DocumentFragment).firstElementChild!;
        tr.querySelectorAll<HTMLInputElement>('[data-k]').forEach((i) => (i.value = String(f[i.dataset.k as keyof Fecha] ?? '')));
        $('#fechas').append(tr);
      }

      async function cargarCurso(slug: string | null) {
        slugActual = slug;
        slugTocado = !!slug;
        fCurso.reset();
        $('#fechas').innerHTML = '';
        estado($('#curso-estado'), '');
        const c: Curso = slug
          ? await api('cursos/' + encodeURIComponent(slug)).then((r) => ({ slug: r.slug, ...r.data, body: r.body }))
          : { slug: '', categoria: 'simulador', fechas: [], asistentes: 20, modalidad: 'Presencial', aDemanda: true, orden: 100, body: '## Objetivos\n\n\n## Programa\n\n- ' };

        const els = fCurso.elements as any;
        for (const k of ['titulo', 'slug', 'categoria', 'resumen', 'imagenAlt', 'duracion', 'asistentes', 'modalidad', 'acreditacion', 'dirigidoA', 'orden', 'body']) {
          if (els[k]) els[k].value = c[k] ?? '';
        }
        els.aDemanda.checked = c.aDemanda !== false;
        els.ejemplo.checked = !!c.ejemplo;
        [...c.fechas].sort((a, b) => a.inicio.localeCompare(b.inicio)).forEach(filaFecha);
        await cargarImagenes(c.imagen);

        $('#curso-titulo').textContent = slug ? c.titulo : 'Nuevo curso';
        $('#curso-borrar').hidden = !slug;
        const ver = $<HTMLAnchorElement>('#curso-ver');
        // En la demo solo existen en la web los cursos originales
        ver.hidden = !slug || (DEMO && !SLUGS_WEB.has(slug));
        if (slug) ver.href = `${BASE}formacion/${slug}/`;
      }

      (fCurso.elements as any).titulo.addEventListener('input', () => {
        if (!slugTocado) (fCurso.elements as any).slug.value = slugify((fCurso.elements as any).titulo.value);
      });
      (fCurso.elements as any).slug.addEventListener('input', () => (slugTocado = true));
      imgSelect.addEventListener('change', previewImg);
      $('#add-fecha').addEventListener('click', () => filaFecha());
      $('#fechas').addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest('[data-quitar]');
        if (b) b.closest('tr')!.remove();
      });

      $<HTMLInputElement>('#img-upload').addEventListener('change', async (e) => {
        const input = e.target as HTMLInputElement;
        const file = input.files?.[0];
        if (!file) return;
        // Límite de las funciones de Vercel (4,5 MB por petición, y el base64 ocupa un tercio más)
        if (file.size > 3 * 1024 * 1024) {
          estado($('#curso-estado'), 'La imagen pesa más de 3 MB: redúcela antes de subirla', 'err');
          input.value = '';
          return;
        }
        const base64 = await new Promise<string>((ok) => {
          const r = new FileReader();
          r.onload = () => ok(String(r.result).split(',')[1]);
          r.readAsDataURL(file);
        });
        try {
          const { nombre } = await api('imagenes', { method: 'POST', body: JSON.stringify({ nombre: file.name, base64 }) });
          await cargarImagenes(nombre);
          estado($('#curso-estado'), `Imagen «${nombre}» subida`, 'ok');
        } catch (err) {
          estado($('#curso-estado'), (err as Error).message, 'err');
        }
        input.value = '';
      });

      fCurso.addEventListener('submit', async (e) => {
        e.preventDefault();
        const st = $('#curso-estado');
        if (!fCurso.checkValidity()) {
          fCurso.reportValidity();
          return;
        }
        const els = fCurso.elements as any;
        const num = (v: string) => (v === '' ? undefined : Number(v));
        const fechas = [...$('#fechas').querySelectorAll('tr')].map((tr) => {
          const g = (k: string) => (tr.querySelector(`[data-k="${k}"]`) as HTMLInputElement).value.trim();
          return { inicio: g('inicio'), fin: g('fin') || undefined, lugar: g('lugar'), plazasLibres: num(g('plazasLibres')) };
        });
        const data = {
          titulo: els.titulo.value.trim(),
          categoria: els.categoria.value,
          resumen: els.resumen.value.trim(),
          imagen: els.imagen.value,
          imagenAlt: els.imagenAlt.value.trim(),
          duracion: els.duracion.value.trim(),
          asistentes: Number(els.asistentes.value),
          modalidad: els.modalidad.value.trim(),
          acreditacion: els.acreditacion.value.trim(),
          dirigidoA: els.dirigidoA.value.trim(),
          fechas,
          aDemanda: els.aDemanda.checked ? undefined : false, // true es el valor por defecto
          orden: num(els.orden.value),
          ejemplo: els.ejemplo.checked || undefined,
        };
        const nuevoSlug = els.slug.value.trim();
        try {
          const { slug } = await api('cursos/' + encodeURIComponent(slugActual ?? nuevoSlug), {
            method: 'PUT',
            body: JSON.stringify({ data, body: els.body.value, nuevoSlug, crear: !slugActual }),
          });
          estado(st, GUARDADO(), 'ok');
          if (slug !== slugActual) {
            history.replaceState(null, '', `#/cursos/${encodeURIComponent(slug)}`);
            await cargarCurso(slug);
            estado(st, GUARDADO(), 'ok');
          } else {
            $('#curso-titulo').textContent = data.titulo;
          }
        } catch (err) {
          estado(st, (err as Error).message, 'err');
        }
      });

      $('#curso-borrar').addEventListener('click', async () => {
        if (!slugActual || !confirm(`¿Borrar el curso «${(fCurso.elements as any).titulo.value}»? Se elimina su archivo .md.`)) return;
        try {
          await api('cursos/' + encodeURIComponent(slugActual), { method: 'DELETE' });
          location.hash = '#/cursos';
        } catch (err) {
          estado($('#curso-estado'), (err as Error).message, 'err');
        }
      });

      // ---------- Empresa ----------
      const fEmpresa = $<HTMLFormElement>('#f-empresa');
      async function cargarEmpresa() {
        const d = await api<Record<string, string>>('empresa');
        for (const [k, v] of Object.entries(d)) {
          const el = fEmpresa.elements.namedItem(k) as HTMLInputElement | null;
          if (el) el.value = v;
        }
        estado($('#empresa-estado'), '');
      }
      fEmpresa.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!fEmpresa.reportValidity()) return;
        try {
          await api('empresa', { method: 'PUT', body: JSON.stringify(Object.fromEntries(new FormData(fEmpresa))) });
          estado($('#empresa-estado'), GUARDADO(), 'ok');
        } catch (err) {
          estado($('#empresa-estado'), (err as Error).message, 'err');
        }
      });


      // ---------- Secciones de contenido: formulario pintado a partir del esquema ----------
      // El formulario edita directamente `datosSeccion`; las listas se vuelven a pintar al añadir,
      // quitar o mover elementos (las fichas abiertas siguen abiertas).
      type Campo = Record<string, any>;
      const fContenido = $<HTMLFormElement>('#f-contenido');
      let seccionActual: Campo | null = null;
      let datosSeccion: Record<string, any> = {};
      let imagenesDisponibles: string[] = [];
      const abiertas = new WeakSet<object>();

      const el = <K extends keyof HTMLElementTagNameMap>(tag: K, clase = '', texto = '') => {
        const e = document.createElement(tag);
        if (clase) e.className = clase;
        if (texto) e.textContent = texto;
        return e;
      };
      const vacio = (c: Campo): any =>
        c.tipo === 'lista' ? [] : c.tipo === 'grupo' ? nuevo(c.campos) : c.tipo === 'check' ? false : '';
      const nuevo = (campos: Campo[]) => Object.fromEntries(campos.map((c) => [c.k, vacio(c)]));

      function pintarCampos(campos: Campo[], obj: Record<string, any>, cont: HTMLElement) {
        let grid: HTMLElement | null = null;
        for (const c of campos) {
          if (c.tipo === 'lista' || c.tipo === 'grupo') {
            grid = null;
            cont.append(c.tipo === 'lista' ? pintarLista(c, obj) : pintarGrupo(c, obj));
            continue;
          }
          if (!grid) cont.append((grid = el('div', 'grid-2')));
          grid.append(pintarCampo(c, obj));
        }
      }

      function pintarGrupo(c: Campo, obj: Record<string, any>) {
        const fs = el('fieldset');
        fs.append(el('legend', '', c.etiqueta));
        obj[c.k] ??= nuevo(c.campos);
        pintarCampos(c.campos, obj[c.k], fs);
        return fs;
      }

      function pintarCampo(c: Campo, obj: Record<string, any>) {
        if (c.tipo === 'check') {
          const lab = el('label', 'check wide');
          const i = el('input');
          i.type = 'checkbox';
          i.checked = !!obj[c.k];
          i.addEventListener('change', () => (obj[c.k] = i.checked));
          lab.append(i, ' ' + c.etiqueta);
          return lab;
        }
        const lab = el('label', c.ancho === 'wide' || c.tipo === 'area' ? 'wide' : '', c.etiqueta);
        let input: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;
        if (c.tipo === 'area') {
          input = el('textarea');
          input.rows = c.filas ?? 3;
        } else if (c.tipo === 'opcion' || c.tipo === 'imagen') {
          input = el('select');
          const opciones = c.tipo === 'opcion' ? c.opciones : imagenesDisponibles.map((f) => ({ valor: f, texto: f }));
          if (!c.requerido) input.append(new Option('—', ''));
          for (const o of opciones) input.append(new Option(o.texto, o.valor));
        } else {
          input = el('input');
          input.type = c.tipo === 'numero' ? 'number' : c.tipo === 'fecha' ? 'date' : 'text';
          if (c.max) input.maxLength = c.max;
        }
        if (c.max && input instanceof HTMLTextAreaElement) input.maxLength = c.max;
        input.value = obj[c.k] ?? '';
        input.required = !!c.requerido;
        if (c.fijo) input.disabled = true;
        input.addEventListener('input', () => (obj[c.k] = input.value));
        lab.append(input);
        if (c.tipo === 'imagen') {
          const img = el('img', 'mini');
          img.alt = '';
          const ver = () => (img.src = input.value ? IMG_URL(input.value) : '');
          input.addEventListener('change', ver);
          ver();
          lab.append(img);
        }
        return lab;
      }

      function botonera(arr: any[], i: number, redibujar: () => void, quitarTexto: string) {
        const caja = el('span', 'item-acciones');
        const boton = (txt: string, etiqueta: string, accion: () => void, deshabilitado = false) => {
          const b = el('button', 'icon-btn', txt);
          b.type = 'button';
          b.setAttribute('aria-label', etiqueta);
          b.title = etiqueta;
          b.disabled = deshabilitado;
          b.addEventListener('click', (e) => {
            e.preventDefault();
            accion();
            redibujar();
          });
          caja.append(b);
        };
        boton('↑', 'Subir', () => arr.splice(i - 1, 0, ...arr.splice(i, 1)), i === 0);
        boton('↓', 'Bajar', () => arr.splice(i + 1, 0, ...arr.splice(i, 1)), i === arr.length - 1);
        boton('✕', quitarTexto, () => {
          if (typeof arr[i] !== 'object' || confirm(`¿${quitarTexto}?`)) arr.splice(i, 1);
        });
        return caja;
      }

      function pintarLista(c: Campo, obj: Record<string, any>) {
        const caja = el('div', 'lista');
        caja.append(el('p', 'lista-titulo', c.etiqueta));
        const items = el('div', 'lista-items');
        const arr: any[] = (obj[c.k] ??= []);
        const anadir = el('button', 'btn btn-ghost', `+ Añadir ${c.singular ?? 'elemento'}`);
        anadir.type = 'button';
        const redibujar = () => {
          items.replaceChildren(...arr.map((_, i) => (c.de === 'texto' ? filaTexto(c, arr, i, redibujar) : ficha(c, arr, i, redibujar))));
          anadir.hidden = !!c.fija || arr.length >= (c.max ?? 200);
        };
        anadir.addEventListener('click', () => {
          const n = c.de === 'texto' ? '' : nuevo(c.campos);
          arr.push(n);
          if (typeof n === 'object') abiertas.add(n);
          redibujar();
          items.lastElementChild?.querySelector<HTMLElement>('input, textarea, select')?.focus();
        });
        redibujar();
        caja.append(items, anadir);
        return caja;
      }

      function filaTexto(c: Campo, arr: string[], i: number, redibujar: () => void) {
        const fila = el('div', 'item-texto');
        const input = el('input');
        input.value = arr[i];
        input.maxLength = 300;
        input.setAttribute('aria-label', `${c.singular ?? 'Elemento'} ${i + 1}`);
        input.addEventListener('input', () => (arr[i] = input.value));
        fila.append(input, botonera(arr, i, redibujar, `Quitar ${c.singular ?? 'elemento'}`));
        return fila;
      }

      function ficha(c: Campo, arr: Record<string, any>[], i: number, redibujar: () => void) {
        const item = arr[i];
        const d = el('details', 'item');
        d.open = abiertas.has(item);
        d.addEventListener('toggle', () => (d.open ? abiertas.add(item) : abiertas.delete(item)));
        const sum = el('summary');
        const titulo = el('span', 'item-titulo');
        const rotulo = () => {
          const v = c.resumen ? item[c.resumen] : '';
          titulo.textContent = v ? (c.campos.find((x: Campo) => x.k === c.resumen)?.tipo === 'fecha' ? fechaLarga(v) : v) : `${c.singular ?? 'Elemento'} ${i + 1}`;
        };
        rotulo();
        sum.append(titulo);
        if (!c.fija) sum.append(botonera(arr, i, redibujar, `Quitar ${c.singular ?? 'elemento'}`));
        const cuerpo = el('div', 'item-cuerpo');
        pintarCampos(c.campos, item, cuerpo);
        cuerpo.addEventListener('input', rotulo);
        d.append(sum, cuerpo);
        return d;
      }

      const fechaLarga = (iso: string) =>
        new Date(`${iso}T12:00:00`).toLocaleDateString('es-ES', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });

      async function cargarContenido(id: string) {
        const sec = seccion(id);
        if (!sec) throw new Error('Sección no encontrada');
        const [datos, imgs] = await Promise.all([api('contenido/' + encodeURIComponent(id)), api<string[]>('imagenes')]);
        seccionActual = sec;
        datosSeccion = datos ?? {};
        imagenesDisponibles = imgs;
        $('#contenido-titulo').textContent = sec.titulo;
        $('#contenido-desc').textContent = sec.descripcion ?? '';
        const ver = $<HTMLAnchorElement>('#contenido-ver');
        ver.hidden = !sec.ver;
        if (sec.ver) ver.href = BASE + sec.ver.replace(/^\//, '');
        const cont = $('#contenido-campos');
        cont.replaceChildren();
        // Los campos sueltos y las listas de primer nivel van en una caja como el resto del panel
        const fs = el('fieldset', 'raiz');
        pintarCampos(sec.campos, datosSeccion, fs);
        cont.append(fs);
        estado($('#contenido-estado'), '');
      }

      fContenido.addEventListener('submit', async (e) => {
        e.preventDefault();
        const st = $('#contenido-estado');
        // Abre las fichas con campos sin rellenar para que el navegador pueda señalarlos
        fContenido.querySelectorAll(':invalid').forEach((i) => {
          for (let d = i.closest('details'); d; d = d.parentElement!.closest('details')) d.open = true;
        });
        if (!fContenido.reportValidity()) return;
        try {
          datosSeccion = await api('contenido/' + encodeURIComponent(seccionActual!.id), { method: 'PUT', body: JSON.stringify(datosSeccion) });
          await cargarContenido(seccionActual!.id);
          estado(st, GUARDADO(), 'ok');
        } catch (err) {
          estado(st, (err as Error).message, 'err');
        }
      });

      document.getElementById('demo-reset')?.addEventListener('click', () => {
        try {
          sessionStorage.removeItem(DEMO_KEY);
        } catch {}
        for (const k of Object.keys(subidas)) delete subidas[k];
        location.hash = '#/cursos';
        router();
      });

      // ---------- Acceso ----------
      const navPanel = $('.adm-side nav');
      function mostrarLogin() {
        mostrar('v-login', '');
        navPanel.hidden = true;
        $<HTMLInputElement>('#f-login [name="clave"]').focus();
      }
      $('#clave-ver').addEventListener('click', (e) => {
        const b = e.currentTarget as HTMLButtonElement;
        const input = $<HTMLInputElement>('#f-login [name="clave"]');
        const ver = input.type === 'password';
        input.type = ver ? 'text' : 'password';
        b.setAttribute('aria-pressed', String(ver));
        b.setAttribute('aria-label', ver ? 'Ocultar contraseña' : 'Mostrar contraseña');
        input.focus();
      });
      $('#f-login').addEventListener('submit', async (e) => {
        e.preventDefault();
        const f = e.target as HTMLFormElement;
        try {
          await api('login', { method: 'POST', body: JSON.stringify({ clave: (f.elements as any).clave.value }) });
          f.reset();
          (f.elements as any).clave.type = 'password';
          $('#clave-ver').setAttribute('aria-pressed', 'false');
          estado($('#login-estado'), '');
          iniciar();
        } catch (err) {
          estado($('#login-estado'), (err as Error).message, 'err');
        }
      });
      document.getElementById('adm-salir')?.addEventListener('click', async () => {
        await api('logout', { method: 'POST' }).catch(() => {});
        $('#adm-salir').hidden = true;
        mostrarLogin();
      });

      let enMarcha = false;
      async function iniciar() {
        if (!DEMO) {
          try {
            const s = await api<{ remoto: boolean; login: boolean }>('sesion');
            REMOTO = s.remoto;
            $('#adm-salir').hidden = !s.login;
            $('#adm-nota').textContent = REMOTO
              ? 'Los cambios se guardan en GitHub y la web se vuelve a publicar sola en 1–2 minutos.'
              : 'Solo en tu ordenador. Los cambios se guardan en los archivos del proyecto: revísalos en la web local y publícalos con el siguiente build.';
          } catch (e) {
            if (!$('#v-login').hidden) return; // pide contraseña
            alert((e as Error).message);
            return;
          }
        }
        navPanel.hidden = false;
        if (!enMarcha) window.addEventListener('hashchange', router);
        enMarcha = true;
        router();
      }
      iniciar();
    </script>

    <style is:global>
