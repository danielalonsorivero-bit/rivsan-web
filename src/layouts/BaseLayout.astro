---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import bebasLatin from '@fontsource/bebas-neue/files/bebas-neue-latin-400-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Crosshair from '../components/Crosshair.astro';
import { site } from '../data/site';
import { indexable, organizationLd } from '../data/seo';
import defaultShare from '../assets/img/hero-binomio.jpg';

interface Props {
  title?: string;
  description?: string;
  /** Imagen para compartir en redes (por defecto, la del hero de la home) */
  image?: ImageMetadata;
  /** Datos estructurados adicionales de la página (schema.org) */
  jsonLd?: Record<string, unknown>;
}
const { title, description = site.description, image = defaultShare, jsonLd } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);

// 1200×630 en JPG: el formato que mejor admiten las redes sociales y apps de mensajería
const share = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const shareUrl = new URL(share.src, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <!-- Marca que hay JS: las animaciones .reveal solo ocultan contenido si pueden mostrarlo después -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- La fuente de titulares se precarga para evitar saltos en los textos grandes -->
    <link rel="preload" href={bebasLatin} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#0b0b0b" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    {!indexable && <meta name="robots" content="noindex, nofollow" />}

    <script type="application/ld+json" set:html={JSON.stringify(organizationLd)} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Crosshair />

    <script>
      // Aparición progresiva de bloques con .reveal
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -10% 0px' },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: 16px;
    top: -100px;
    z-index: 100;
    background: var(--yellow);
    color: var(--ink);
    padding: 0.6em 1em;
    font-weight: 600;
    text-decoration: none;
  }

  .skip-link:focus {
    top: 16px;
  }
</style>
