---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RequestForm from '../../components/RequestForm.astro';
import CourseCard from '../../components/CourseCard.astro';
import {
  categorias,
  convocatoriasDe,
  estadoPlazas,
  ordenarCursos,
  rangoCorto,
  rangoLargo,
  type Curso,
} from '../../data/formacion';

export async function getStaticPaths() {
  const cursos = await getCollection('cursos');
  return cursos.map((curso) => ({ params: { curso: curso.id }, props: { curso, todos: cursos } }));
}

interface Props {
  curso: Curso;
  todos: Curso[];
}

const { curso, todos } = Astro.props;
const { data } = curso;
const { Content } = await render(curso);
const cat = categorias[data.categoria];
const convocatorias = convocatoriasDe(curso);
const relacionados = ordenarCursos(todos.filter((c) => c.id !== curso.id && c.data.categoria === data.categoria)).slice(0, 3);

const opciones = convocatorias.map((c) => {
  const estado = estadoPlazas(c.plazasLibres);
  return {
    id: c.id,
    label: `${rangoLargo(c.inicio, c.fin)} · ${c.lugar}${estado.tone === 'full' ? ' (completo)' : ''}`,
    disabled: estado.tone === 'full',
  };
});

// Datos estructurados del curso (schema.org Course) para buscadores
const courseLd = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: data.titulo,
  description: data.resumen,
  inLanguage: 'es',
  url: new URL(`/formacion/${curso.id}/`, Astro.site).href,
  provider: { '@id': `${Astro.site?.origin}/#organizacion` },
  hasCourseInstance: convocatorias.map((c) => ({
    '@type': 'CourseInstance',
    courseMode: 'onsite',
    startDate: c.inicio.toISOString().slice(0, 10),
    ...(c.fin && { endDate: c.fin.toISOString().slice(0, 10) }),
    location: {
      '@type': 'Place',
      name: c.lugar,
      address: { '@type': 'PostalAddress', addressLocality: c.lugar, addressCountry: 'ES' },
    },
  })),
};

// Fecha corta y lugar de cada convocatoria para la credencial de la ventana de inscripción
const ticketConv = Object.fromEntries(
  convocatorias.map((c) => [c.id, { fecha: `${rangoCorto(c.inicio, c.fin)} ${c.inicio.getUTCFullYear()}`, lugar: c.lugar }]),
);
const ticketRef = `RIV-${curso.id
  .split('-')
  .filter((w) => w.length > 2 || /\d/.test(w))
  .map((w) => (/\d/.test(w) ? w : w[0]))
  .join('')
  .toUpperCase()}`;

const ficha = [
  { k: 'Duración', v: data.duracion },
  { k: 'Plazas', v: `${data.asistentes} por convocatoria` },
  { k: 'Modalidad', v: data.modalidad },
  { k: 'Dirigido a', v: data.dirigidoA },
  { k: 'Acreditación', v: data.acreditacion },
];
---

<BaseLayout title={data.titulo} description={data.resumen} image={data.imagen} jsonLd={courseLd}>
  <section class="course-hero">
    <Image src={data.imagen} alt={data.imagenAlt} class="bg" widths={[800, 1600]} sizes="100vw" loading="eager" fetchpriority="high" />
    <div class="shade" aria-hidden="true"></div>
    <div class="container content">
      <nav class="crumbs" aria-label="Ruta">
        <a href="/formacion/">Formación</a>
        <span aria-hidden="true">/</span>
        <a href={`/formacion/#${data.categoria}`}>{cat.label}</a>
      </nav>
      {data.ejemplo && <p class="sample">Curso de ejemplo · contenido provisional</p>}
      <p class="eyebrow">{cat.partner}</p>
      <h1 class="h-xl">{data.titulo}</h1>
      <p class="lead">{data.resumen}</p>
      <div class="actions">
        <button type="button" class="btn btn-primary" data-open-request>+ Info y solicitud <span class="arrow">→</span></button>
        {convocatorias.length > 0 && <a href="#convocatorias" class="btn btn-ghost">Ver convocatorias</a>}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container layout">
      <article class="prose">
        <Content />
      </article>

      <aside class="sidebar">
        <div class="panel hud">
          <h2 class="panel-title">Ficha del curso</h2>
          <dl class="ficha">
            {
              ficha.map((f) => (
                <div>
                  <dt>{f.k}</dt>
                  <dd>{f.v}</dd>
                </div>
              ))
            }
          </dl>
        </div>

        <div class="panel" id="convocatorias">
          <h2 class="panel-title">Convocatorias</h2>
          {
            convocatorias.length > 0 ? (
              <ul class="sessions">
                {convocatorias.map((c) => {
                  const estado = estadoPlazas(c.plazasLibres);
                  return (
                    <li>
                      <div class="when">
                        <strong>{rangoCorto(c.inicio, c.fin)}</strong>
                        <span>{c.lugar}</span>
                      </div>
                      <span class:list={['pill', `pill--${estado.tone}`]}>{estado.label}</span>
                      {estado.tone !== 'full' && (
                        <button type="button" class="link-arrow" data-open-request data-convocatoria={c.id}>
                          Solicitar plaza →
                        </button>
                      )}
                    </li>
                  );
                })}
              </ul>
            ) : (
              <p class="muted">No hay convocatorias abiertas ahora mismo.</p>
            )
          }
          {
            data.aDemanda && (
              <p class="on-demand">
                ¿Prefieres formar a tu unidad en tus instalaciones? Lo organizamos <strong>a demanda</strong>.
              </p>
            )
          }
          <button type="button" class="btn btn-primary block" data-open-request>+ Info y solicitud</button>
        </div>
      </aside>
    </div>
  </section>

  {
    relacionados.length > 0 && (
      <section class="section related">
        <div class="container">
          <p class="eyebrow">También te puede interesar</p>
          <div class="related-grid">
            {relacionados.map((c) => (
              <CourseCard curso={c} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <dialog class="request-dialog" data-request-dialog data-conv={JSON.stringify(ticketConv)} aria-labelledby="request-title">
    <div class="enroll">
      <!-- Ficha del curso, a modo de credencial: se actualiza con la convocatoria elegida -->
      <aside class="ticket">
        <Image src={data.imagen} alt="" class="ticket-bg" widths={[600]} sizes="400px" />
        <div class="ticket-body">
          <p class="ticket-eyebrow data">Ficha de inscripción · {cat.label}</p>
          <h2 id="request-title" class="ticket-title">{data.titulo}</h2>
          <div class="ticket-conv">
            <span class="data">Convocatoria</span>
            <strong data-ticket-date>—</strong>
            <span data-ticket-place></span>
          </div>
          <dl class="ticket-data">
            {
              ficha.slice(0, 3).map((f) => (
                <div>
                  <dt class="data">{f.k}</dt>
                  <dd>{f.v}</dd>
                </div>
              ))
            }
          </dl>
          <p class="ticket-ref data">REF · {ticketRef}</p>
        </div>
      </aside>

      <div class="enroll-form">
        <div class="enroll-head">
          <p class="eyebrow">Solicitud de plaza</p>
          <button type="button" class="close" data-close-request aria-label="Cerrar">✕</button>
        </div>
        <RequestForm
          curso={{ titulo: data.titulo, id: curso.id }}
          convocatorias={opciones}
          aDemanda={data.aDemanda}
          variant="ficha"
          submitLabel="Solicitar plaza"
        />
      </div>
    </div>
  </dialog>
</BaseLayout>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-request-dialog]')!;
  const select = dialog.querySelector<HTMLSelectElement>('select[name="convocatoria"]')!;

  // La credencial de la izquierda refleja la convocatoria elegida («fecha · lugar»)
  const ticketDate = dialog.querySelector('[data-ticket-date]')!;
  const ticketPlace = dialog.querySelector('[data-ticket-place]')!;
  const conv: Record<string, { fecha: string; lugar: string }> = JSON.parse(dialog.dataset.conv || '{}');
  const syncTicket = () => {
    const c = conv[select.value];
    ticketDate.textContent = c ? c.fecha : 'A demanda';
    ticketPlace.textContent = c ? c.lugar : 'En tus instalaciones o en otra fecha';
  };
  select.addEventListener('change', syncTicket);

  const open = (convocatoria?: string | null) => {
    if (convocatoria && [...select.options].some((o) => o.value === convocatoria && !o.disabled)) {
      select.value = convocatoria;
    }
    syncTicket();
    dialog.showModal();
    document.body.style.overflow = 'hidden';
  };

  document.querySelectorAll<HTMLElement>('[data-open-request]').forEach((btn) =>
    btn.addEventListener('click', () => open(btn.dataset.convocatoria)),
  );
  dialog.querySelector('[data-close-request]')!.addEventListener('click', () => dialog.close());
  dialog.addEventListener('close', () => (document.body.style.overflow = ''));
  // Cerrar al pulsar fuera del cuadro
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });

  // Desde el calendario se llega con ?convocatoria=AAAA-MM-DD
  const fromUrl = new URLSearchParams(location.search).get('convocatoria');
  if (fromUrl) open(fromUrl);
</script>

<style>
  .course-hero {
    position: relative;
    min-height: 72svh;
    display: flex;
    align-items: flex-end;
    padding: calc(var(--header-h) + 48px) 0 64px;
    isolation: isolate;
    overflow: hidden;
  }

  .bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
    filter: grayscale(0.3);
  }

  .shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgba(11, 11, 11, 0.94) 0%, rgba(11, 11, 11, 0.6) 60%, rgba(11, 11, 11, 0.35) 100%),
      linear-gradient(0deg, var(--bg) 0%, transparent 45%);
  }

  .content h1 {
    font-size: clamp(2.75rem, 6vw, 5.5rem);
    max-width: 13em;
    margin-bottom: 1.25rem;
  }

  .content .lead {
    color: #d6d6d0;
  }

  .crumbs {
    display: flex;
    gap: 10px;
    font-family: var(--font-label);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 28px;
  }

  /* Relleno vertical: en móvil cada enlace de la ruta llega a 24 px de alto para el dedo */
  .crumbs a {
    padding-block: 4px;
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--yellow);
  }

  .sample {
    display: inline-block;
    font-family: var(--font-label);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.75rem;
    padding: 4px 10px;
    border: 1px dashed var(--yellow);
    color: var(--yellow);
    margin-bottom: 20px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 1.75rem;
  }

  .layout {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: clamp(40px, 6vw, 88px);
    align-items: start;
  }

  /* Contenido markdown del curso */
  .prose :global(h2) {
    font-size: clamp(2rem, 3.4vw, 2.75rem);
    margin: 2.2em 0 0.6em;
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(p),
  .prose :global(li) {
    color: #cfcfc9;
  }

  .prose :global(strong) {
    color: var(--text);
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 0;
    list-style: none;
    display: grid;
    gap: 10px;
    margin: 0 0 1em;
  }

  .prose :global(ul li) {
    position: relative;
    padding-left: 24px;
  }

  .prose :global(ul li::before) {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 8px;
    height: 8px;
    background: var(--text-dim);
  }

  .prose :global(ol) {
    counter-reset: paso;
  }

  .prose :global(ol li) {
    counter-increment: paso;
    position: relative;
    padding-left: 44px;
  }

  .prose :global(ol li::before) {
    content: counter(paso, decimal-leading-zero);
    position: absolute;
    left: 0;
    font-family: var(--font-label);
    font-weight: 600;
    color: var(--yellow);
    letter-spacing: 0.1em;
  }

  .sidebar {
    display: grid;
    gap: 20px;
    position: sticky;
    top: calc(var(--header-h) + 24px);
  }

  .panel {
    background: var(--surface);
    border: 1px solid var(--line);
    padding: 28px;
  }

  .panel-title {
    font-family: var(--font-label);
    font-weight: 600;
    letter-spacing: 0.22em;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 18px;
  }

  .ficha {
    margin: 0;
    display: grid;
    gap: 14px;
  }

  .ficha div {
    display: grid;
    gap: 2px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
  }

  .ficha div:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .ficha dt {
    font-size: 0.85rem;
    color: var(--text-dim);
  }

  .ficha dd {
    margin: 0;
  }

  .sessions {
    list-style: none;
    margin: 0 0 20px;
    padding: 0;
    display: grid;
  }

  .sessions li {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 6px 12px;
    align-items: center;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }

  .sessions li:first-child {
    padding-top: 0;
  }

  .when {
    display: flex;
    flex-direction: column;
  }

  .when strong {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.6rem;
    line-height: 1;
    text-transform: uppercase;
  }

  .when span {
    color: var(--text-muted);
    font-size: 0.925rem;
  }

  .sessions .link-arrow {
    grid-column: 1 / -1;
    background: none;
    border: 0;
    padding: 6px 0;
    cursor: pointer;
    justify-self: start;
  }

  .on-demand {
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  .on-demand strong {
    color: var(--text);
  }

  .btn.block {
    width: 100%;
  }

  .related {
    background: var(--bg-2);
    border-top: 1px solid var(--line);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  /* Ventana modal de solicitud: ficha horizontal (credencial + formulario) */
  .request-dialog {
    width: min(1120px, calc(100vw - 32px));
    max-height: calc(100dvh - 32px);
    padding: 0;
    background: var(--bg-2);
    color: var(--text);
    border: 1px solid rgba(247, 196, 0, 0.4);
    overflow: hidden;
    /* Al llegar al final del scroll interno no se desplaza la página de detrás */
    overscroll-behavior: contain;
  }

  .request-dialog[open] {
    animation: ficha-in 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  @keyframes ficha-in {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.98);
    }
  }

  .request-dialog::backdrop {
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(4px);
  }

  .enroll {
    display: grid;
    grid-template-columns: minmax(280px, 0.8fr) 2fr;
    max-height: calc(100dvh - 34px);
  }

  .ticket {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    border-right: 2px dashed rgba(247, 196, 0, 0.45);
  }

  /* Muescas de troquel en el borde perforado */
  .ticket::before,
  .ticket::after {
    content: '';
    position: absolute;
    right: -13px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #050505;
    border: 1px solid rgba(247, 196, 0, 0.4);
    z-index: 2;
  }

  .ticket::before {
    top: -13px;
  }

  .ticket::after {
    bottom: -13px;
  }

  .ticket-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
    filter: grayscale(0.6) contrast(1.1);
  }

  .ticket-body {
    position: relative;
    width: 100%;
    padding: 28px;
    display: grid;
    gap: 18px;
  }

  .ticket-body::before {
    content: '';
    position: absolute;
    inset: -60% 0 0;
    z-index: -1;
    background:
      linear-gradient(0deg, rgba(11, 11, 11, 0.97) 55%, rgba(11, 11, 11, 0.4)),
      repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.03) 0 1px, transparent 1px 3px);
  }

  .ticket-eyebrow {
    margin: 0;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .ticket-title {
    font-size: clamp(1.9rem, 2.6vw, 2.5rem);
  }

  .ticket-conv {
    display: grid;
    gap: 2px;
    padding: 14px 16px;
    border: 1px solid rgba(247, 196, 0, 0.45);
    background: rgba(247, 196, 0, 0.06);
  }

  .ticket-conv .data {
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .ticket-conv strong {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.6rem;
    line-height: 1.05;
    color: var(--yellow);
    text-transform: uppercase;
  }

  .ticket-conv span:last-child {
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .ticket-data {
    margin: 0;
    display: grid;
    gap: 8px;
  }

  .ticket-data div {
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: 12px;
    font-size: 0.875rem;
  }

  .ticket-data dt {
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-dim);
    padding-top: 2px;
  }

  .ticket-data dd {
    margin: 0;
    color: var(--text);
  }

  .ticket-ref {
    margin: 0;
    white-space: nowrap;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    color: var(--text-dim);
  }

  .enroll-form {
    padding: 24px clamp(24px, 3vw, 40px) 28px;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .enroll-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 16px;
  }

  .enroll-head .eyebrow {
    margin: 0;
  }

  .close {
    flex: none;
    width: 40px;
    height: 40px;
    background: none;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    color: var(--text);
    font-size: 1rem;
    cursor: pointer;
  }

  .close:hover {
    border-color: var(--yellow);
    color: var(--yellow);
  }

  /* En pantallas estrechas la credencial pasa arriba, compacta, y la ficha hace scroll */
  @media (max-width: 860px) {
    .request-dialog {
      overflow-y: auto;
    }

    .enroll {
      grid-template-columns: 1fr;
      max-height: none;
    }

    .ticket {
      border-right: 0;
      border-bottom: 2px dashed rgba(247, 196, 0, 0.45);
    }

    .ticket::before,
    .ticket::after {
      display: none;
    }

    .ticket-body {
      padding: 20px;
      gap: 12px;
    }

    .ticket-data,
    .ticket-ref {
      display: none;
    }

    .enroll-form {
      overflow: visible;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .request-dialog[open] {
      animation: none;
    }
  }

  .request-dialog :global(.form) {
    background: none;
    border: 0;
  }

  @media (max-width: 960px) {
    .layout {
      grid-template-columns: 1fr;
    }

    .sidebar {
      position: static;
    }

    .related-grid {
      grid-template-columns: 1fr;
      max-width: 560px;
    }
  }
</style>
