---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import DemoForm from '../../components/DemoForm.astro';
import ForceDemo from '../../components/ForceDemo.astro';
import CounterDroneDemo from '../../components/CounterDroneDemo.astro';
import { perfiles, type Perfil } from '../../data/perfiles';

export function getStaticPaths() {
  return perfiles.map((p) => ({ params: { perfil: p.slug }, props: { p } }));
}

const { p } = Astro.props as { p: Perfil };
const otros = perfiles.filter((o) => o.slug !== p.slug);
---

<BaseLayout title={p.label} description={p.lead} image={p.image}>
  <PageHero eyebrow={p.eyebrow} title={p.title} lead={p.lead} image={p.image} alt={p.alt}>
    <a href={`?interes=${p.interest}#contacto`} class="btn btn-primary">Solicitar demostración <span class="arrow">→</span></a>
    <a href="#servicios" class="btn btn-ghost">Qué te ofrecemos</a>
  </PageHero>

  <!-- Retos -->
  <section class="section">
    <div class="container">
      <div class="head reveal">
        <p class="eyebrow">Tus retos</p>
        <h2 class="h-lg">Lo que nos cuentan <span class="accent">en cada visita</span></h2>
      </div>
      <ol class="retos">
        {
          p.retos.map((r, i) => (
            <li class="reveal">
              <span class="n">{String(i + 1).padStart(2, '0')}</span>
              <h3>{r.title}</h3>
              <p class="muted">{r.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Servicios -->
  <section class="section alt" id="servicios">
    <div class="container">
      <div class="head reveal">
        <p class="eyebrow">Cómo te ayudamos</p>
        <h2 class="h-lg">Un solo proveedor, <span class="accent">toda la preparación</span></h2>
      </div>
      <div class="services">
        {
          p.servicios.map((s) => (
            <a href={s.href} class="service reveal">
              <h3>{s.title}</h3>
              <p class="muted">{s.text}</p>
              <span class="link-arrow">
                Ver más <span aria-hidden="true">→</span>
              </span>
            </a>
          ))
        }
      </div>

      <div class="modules reveal">
        <p class="modules-title">Módulos del simulador recomendados</p>
        <ul>
          {
            p.modulos.map((m) => (
              <li>
                <a href={`/simulador/#${m.id}`}>{m.label}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Demo interactiva según el perfil -->
  <section class="section">
    <div class="container try">
      <div class="reveal">
        <p class="eyebrow">Pruébalo</p>
        {
          p.slug === 'defensa' ? (
            <>
              <h2 class="h-md">Identifica antes de disparar</h2>
              <p class="muted">
                Una muestra del módulo counter-drone: distingue hostiles de drones propios, gestiona la munición y
                dispara solo en alcance. Al final, la evaluación del instructor.
              </p>
            </>
          ) : (
            <>
              <h2 class="h-md">Cada conducta tiene su respuesta</h2>
              <p class="muted">
                Sube el nivel de resistencia del sujeto y mira cómo se gradúa la respuesta del agente y qué curso la
                entrena.
              </p>
            </>
          )
        }
      </div>
      <div class="reveal">{p.slug === 'defensa' ? <CounterDroneDemo /> : <ForceDemo />}</div>
    </div>
  </section>

  {
    p.slug === 'policia-local' && (
      <section class="band">
        <div class="container band-inner reveal">
          <div>
            <p class="band-eyebrow">Ley 6/2023 · Decreto 8/2026</p>
            <h2 class="h-md">Te ayudamos con la justificación y la tramitación</h2>
            <p>
              Memoria justificativa, presupuesto desglosado y documentación técnica para el expediente de tu
              ayuntamiento.
            </p>
          </div>
          <div class="band-links">
            <a href="/contratar/" class="btn btn-dark">
              Cómo contratar <span class="arrow">→</span>
            </a>
            <a href="/normativa/#calculadora" class="band-link">
              Calcular el ahorro
            </a>
          </div>
        </div>
      </section>
    )
  }

  <!-- Otros perfiles -->
  <section class="others">
    <div class="container others-inner">
      <p class="others-title">Otros perfiles</p>
      {
        otros.map((o) => (
          <a href={`/soluciones/${o.slug}/`} class="other">
            <span class="other-label">{o.label}</span>
            <span class="muted">{o.short}</span>
          </a>
        ))
      }
    </div>
  </section>

  <DemoForm />
</BaseLayout>

<style>
  .alt {
    background: var(--bg-2);
    border-block: 1px solid var(--line);
  }

  .head {
    max-width: 780px;
    margin-bottom: 48px;
  }

  .retos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .retos li {
    padding: 28px 0 0;
    border-top: 2px solid var(--line-strong);
  }

  .n {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--yellow);
  }

  .retos h3,
  .service h3 {
    font-size: 1.75rem;
    margin: 8px 0 12px;
  }

  .services {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .service {
    display: flex;
    flex-direction: column;
    padding: 28px 24px;
    background: var(--surface);
    border: 1px solid var(--line);
    text-decoration: none;
    transition: border-color 0.2s;
  }

  .service:hover {
    border-color: rgba(247, 196, 0, 0.5);
  }

  .service h3 {
    margin-top: 0;
  }

  .service .link-arrow {
    margin-top: auto;
  }

  .modules {
    margin-top: 40px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
  }

  .modules-title,
  .others-title {
    font-family: var(--font-label);
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin: 0;
  }

  .modules ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .modules a {
    display: inline-block;
    padding: 6px 12px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: 0.925rem;
    text-decoration: none;
    transition: border-color 0.2s, color 0.2s;
  }

  .modules a:hover {
    border-color: var(--yellow);
    color: var(--yellow);
  }

  /* Franja amarilla de ruptura */
  .band {
    background: var(--yellow);
    color: var(--ink);
    padding-block: clamp(48px, 6vw, 72px);
  }

  .band-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
    flex-wrap: wrap;
  }

  .band-inner > div:first-child {
    max-width: 640px;
  }

  .band-eyebrow {
    font-family: var(--font-data);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-size: 0.85rem;
    margin-bottom: 0.75rem;
  }

  .band h2 {
    font-size: clamp(2rem, 3.6vw, 2.75rem);
    margin-bottom: 0.75rem;
  }

  .band p:last-child {
    margin: 0;
  }

  .band-links {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }

  .btn-dark {
    background: var(--ink);
    color: #fff;
  }

  .btn-dark:hover {
    background: #000;
  }

  .band-link {
    font-weight: 600;
    color: var(--ink);
  }

  .try {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
  }

  .try h2 {
    font-size: clamp(2rem, 3.4vw, 2.75rem);
    margin-bottom: 1rem;
  }

  @media (max-width: 960px) {
    .try {
      grid-template-columns: 1fr;
    }
  }

  .others {
    border-bottom: 1px solid var(--line);
  }

  .others-inner {
    display: grid;
    grid-template-columns: auto 1fr 1fr;
    gap: 24px 40px;
    align-items: center;
    padding-block: 40px;
  }

  .other {
    display: grid;
    gap: 4px;
    text-decoration: none;
    padding-left: 20px;
    border-left: 2px solid var(--line-strong);
    transition: border-color 0.2s;
  }

  .other:hover {
    border-color: var(--yellow);
  }

  .other-label {
    font-family: var(--font-display);
    font-size: 1.6rem;
    line-height: 1;
    text-transform: uppercase;
  }

  .other:hover .other-label {
    color: var(--yellow);
  }

  @media (max-width: 1080px) {
    .services {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 820px) {
    .retos,
    .others-inner {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .services {
      grid-template-columns: 1fr;
    }
  }
</style>
