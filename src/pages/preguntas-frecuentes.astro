---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import DemoForm from '../components/DemoForm.astro';
import { grupos } from '../data/contenido/preguntas.json';

// Preguntas editables desde el panel. Las respuestas con (*) dependen de datos técnicos de
// RE-liON o de gestiones en curso y deben confirmarse antes de publicar: el (*) no se muestra.
const sinMarca = (t: string) => t.replace(/\s*\(\*\)/g, '');
const groups = grupos.map((g) => ({
  title: g.titulo,
  items: g.preguntas.map((p) => ({ q: p.pregunta, a: sinMarca(p.respuesta), href: p.enlace || undefined })),
}));

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: groups.flatMap((g) =>
    g.items.map((i) => ({
      '@type': 'Question',
      name: i.q,
      acceptedAnswer: { '@type': 'Answer', text: i.a },
    })),
  ),
};
---

<BaseLayout
  title="Preguntas frecuentes"
  description="Espacio necesario, montaje, mareo, armas, acreditación, contratación y datos: respuestas a las dudas más habituales sobre RIVSAN."
  jsonLd={faqLd}
>
  <PageHero
    eyebrow="Recursos"
    title={['Preguntas', 'frecuentes']}
    lead="Lo que más nos preguntan jefes de policía, instructores y responsables de formación. Si tu duda no está aquí, escríbenos."
  />

  <section class="section">
    <div class="container faq">
      <nav class="toc" aria-label="Temas">
        <ul>
          {groups.map((g, i) => <li><a href={`#tema-${i + 1}`}>{g.title}</a></li>)}
        </ul>
      </nav>
      <div>
        {
          groups.map((g, i) => (
            <div class="group" id={`tema-${i + 1}`}>
              <h2 class="h-md">{g.title}</h2>
              {g.items.map((it) => (
                <details>
                  <summary>{it.q}</summary>
                  <div class="answer">
                    <p>{it.a}</p>
                    {it.href && (
                      <a href={it.href} class="link-arrow">
                        Ver más <span aria-hidden="true">→</span>
                      </a>
                    )}
                  </div>
                </details>
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <DemoForm />
</BaseLayout>

<style>
  .faq {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: start;
  }

  .toc {
    position: sticky;
    top: calc(var(--header-h) + 24px);
  }

  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 2px solid var(--line-strong);
  }

  .toc a {
    display: block;
    padding: 8px 0 8px 16px;
    font-family: var(--font-label);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.9rem;
    color: var(--text-muted);
    text-decoration: none;
  }

  .toc a:hover {
    color: var(--yellow);
  }

  .group + .group {
    margin-top: 56px;
  }

  .group h2 {
    margin-bottom: 16px;
    color: var(--text);
  }

  details {
    border-bottom: 1px solid var(--line);
  }

  summary {
    list-style: none;
    cursor: pointer;
    padding: 20px 40px 20px 0;
    font-weight: 600;
    font-size: 1.125rem;
    position: relative;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: '+';
    position: absolute;
    right: 8px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 1.5rem;
    font-weight: 400;
    color: var(--yellow);
    transition: transform 0.2s;
  }

  details[open] summary::after {
    transform: translateY(-50%) rotate(45deg);
  }

  summary:hover {
    color: var(--yellow);
  }

  .answer {
    padding: 0 40px 24px 0;
    color: var(--text-muted);
    max-width: 70ch;
  }

  @media (max-width: 820px) {
    .faq {
      grid-template-columns: 1fr;
    }

    .toc {
      position: static;
    }
  }
</style>
