---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import DemoForm from '../components/DemoForm.astro';

// Las vías de tramitación se explican de palabra, no en la web
const modalidades = [
  {
    name: 'Jornada formativa',
    what: 'Servicio de formación con el sistema RE-liON, equipo e instructores RIVSAN.',
    interest: 'jornada',
  },
  {
    name: 'Renting anual',
    what: 'Arrendamiento del sistema con licencias, mantenimiento y soporte.',
    interest: 'renting',
    featured: true,
  },
  {
    name: 'Compra llave en mano',
    what: 'Equipo en propiedad, licencia permanente e implantación.',
    interest: 'compra',
  },
  {
    name: 'Contratación privada',
    what: '¿Deseas formarte con nosotros? Pide presupuesto.',
    interest: 'privada',
  },
];

const steps = [
  { n: '01', title: 'Demostración', text: 'Tus agentes prueban el sistema en la jefatura. Sin compromiso.' },
  { n: '02', title: 'Propuesta y memoria', text: 'Te enviamos presupuesto desglosado y memoria justificativa con la necesidad y el coste comparado.' },
  { n: '03', title: 'Expediente', text: 'Tu ayuntamiento tramita el contrato. Respondemos a secretaría e intervención con la documentación técnica que pidan.' },
  { n: '04', title: 'Implantación', text: 'Desplegamos el equipo, formamos a tus instructores y empieza el entrenamiento.' },
];

const docs = [
  'Presupuesto desglosado por partidas',
  'Memoria justificativa de la necesidad',
  'Ficha técnica del sistema y de los cursos',
  'Comparativa con el coste actual de formación',
  'Certificado de exclusividad RE-liON',
  'Declaraciones responsables y documentación de empresa',
];
---

<BaseLayout
  title="Cómo contratar"
  description="Jornadas, renting o compra: cómo contratar el simulador y los cursos de RIVSAN desde un ayuntamiento o un organismo público, paso a paso."
>
  <PageHero
    eyebrow="Recursos · Contratación pública"
    title={['Cómo contratarlo', 'desde tu ayuntamiento']}
    lead="Sabemos que el reto no es solo técnico: también hay que justificarlo y tramitarlo. Te acompañamos en todo el proceso y te damos la documentación que necesita el expediente."
  >
    <a href="?interes=ahorro#contacto" class="btn btn-primary">Pedir memoria justificativa <span class="arrow">→</span></a>
    <a href="#modalidades" class="btn btn-ghost">Ver modalidades</a>
  </PageHero>

  <!-- Modalidades -->
  <section class="section" id="modalidades">
    <div class="container">
      <div class="head reveal">
        <p class="eyebrow">Modalidades</p>
        <h2 class="h-lg">Cuatro formas <span class="accent">de empezar</span></h2>
      </div>
      <div class="grid">
        {
          modalidades.map((m) => (
            <article class:list={['mod', 'reveal', { 'mod--featured hud': m.featured }]}>
              <h3 class="h-md">{m.name}</h3>
              <p class="muted">{m.what}</p>
              <a href={`?interes=${m.interest}#contacto`} class="link-arrow">
                Solicitar presupuesto <span aria-hidden="true">→</span>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Pasos -->
  <section class="section alt">
    <div class="container">
      <div class="head reveal">
        <p class="eyebrow">El proceso</p>
        <h2 class="h-lg">De la demo al primer <span class="accent">entrenamiento</span></h2>
      </div>
      <ol class="steps">
        {
          steps.map((s) => (
            <li class="reveal">
              <span class="n">{s.n}</span>
              <h3>{s.title}</h3>
              <p class="muted">{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Documentación -->
  <section class="section theme-light">
    <div class="container docs-grid">
      <div class="reveal">
        <p class="eyebrow">Lo que te damos</p>
        <h2 class="h-lg">El expediente, <span class="accent">ya preparado</span></h2>
        <p class="lead">Toda la documentación técnica y económica que suele pedir tu departamento de contratación.</p>
        <a href="/calculadora/" class="link-arrow">Calcula antes tu ahorro <span aria-hidden="true">→</span></a>
      </div>
      <ul class="docs reveal">
        {docs.map((d) => <li>{d}</li>)}
      </ul>
    </div>
  </section>

  <DemoForm />
</BaseLayout>

<style>
  .alt {
    background: var(--bg-2);
    border-block: 1px solid var(--line);
  }

  .head {
    max-width: 780px;
    margin-bottom: 48px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .mod {
    display: flex;
    flex-direction: column;
    padding: 32px 28px;
    background: var(--bg-2);
    border: 1px solid var(--line);
  }

  .mod--featured {
    background: var(--surface);
    border-color: rgba(247, 196, 0, 0.45);
  }

  .mod h3 {
    margin-bottom: 10px;
  }

  .mod p {
    margin-bottom: 24px;
  }

  .mod .link-arrow {
    margin-top: auto;
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .steps li {
    padding-top: 24px;
    border-top: 2px solid var(--yellow);
  }

  .n {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--yellow);
  }

  .steps h3 {
    font-size: 1.75rem;
    margin: 8px 0 12px;
  }

  .docs-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: start;
  }

  .docs-grid h2 {
    margin-bottom: 1.25rem;
  }

  .docs {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .docs li {
    padding: 16px 0 16px 36px;
    border-bottom: 1px solid var(--line);
    position: relative;
  }

  .docs li::before {
    content: '✓';
    position: absolute;
    left: 0;
    top: 1.15em;
    width: 20px;
    height: 20px;
    display: grid;
    place-items: center;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--ink);
    background: var(--text-dim);
    border-radius: 2px;
  }

  @media (max-width: 1200px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 960px) {
    .grid,
    .docs-grid {
      grid-template-columns: 1fr;
    }

    .steps {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
