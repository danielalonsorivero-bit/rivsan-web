---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Partner from '../components/home/Partner.astro';
import DemoForm from '../components/DemoForm.astro';
import { site } from '../data/site';

import SignalFx from '../components/SignalFx.astro';
import posterMapa from '../assets/img/video-nosotros.jpg';
import mapaSd from '../assets/video/nosotros-sd.mp4?url';
import mapaHd from '../assets/video/nosotros-hd.mp4?url';
import sede from '../assets/img/relion-sede.jpg';
import operadores from '../assets/img/relion-operadores.jpg';
import visor from '../assets/img/relion-visor.jpg';
import logoRelion from '../assets/img/logo-relion-blanco.png';
import logoIfr from '../assets/img/logo-ibero-first-responders.png';
import fotoAula from '../assets/img/aula-instructor.jpg';
import fotoVictima from '../assets/img/auxilios-instructor.jpg';
import fotoTorniquete from '../assets/img/taller-torniquete.jpg';
import fotoEntrada from '../assets/img/entrada-tactica.jpg';

const pillars = [
  {
    title: 'Socio exclusivo en España',
    text: 'Somos el único socio autorizado de RE-liON en España: licencias, equipos y soporte oficial del fabricante.',
  },
  {
    title: 'Llave en mano',
    text: 'Implantación, formación de instructores, asistencia técnica y mantenimiento preventivo local. Tú solo entrenas.',
  },
  {
    title: 'Un solo interlocutor',
    text: 'La misma persona desde la primera demostración hasta el soporte continuo. Presencial y en tu idioma.',
  },
  {
    title: 'Formación integral',
    text: 'Simulador, primeros auxilios tácticos y uso de la fuerza no letal: toda la preparación del agente con un proveedor.',
  },
];

// Fotos de cursos reales. Las caras de frente van pixeladas (petición del cliente, 10 nov 2026).
const terreno = [
  { src: fotoAula, caption: 'Clase teórica', alt: 'Instructor de RIVSAN de pie ante una clase de agentes que toman notas', pos: '30% 50%' },
  { src: fotoVictima, caption: 'Valoración de una víctima', alt: 'Instructor arrodillado junto a un herido simulado tendido en el suelo de un patio', pos: '50% 30%' },
  { src: fotoTorniquete, caption: 'Aplicación de torniquete', alt: 'Instructor aplicando un torniquete en la pierna de un militar tendido en el suelo', pos: '50% 50%' },
  { src: fotoEntrada, caption: 'Entrada táctica', alt: 'Dos operadores con casco y equipo táctico entrando en una estructura', pos: '50% 50%' },
];

const steps = [
  { n: '01', title: 'Demostración', text: 'Llevamos el sistema a tu jefatura y tus agentes lo prueban.' },
  { n: '02', title: 'Propuesta a medida', text: 'Jornadas, renting o compra según agentes, espacio y presupuesto.' },
  { n: '03', title: 'Implantación', text: 'Desplegamos y configuramos el equipo en tus instalaciones.' },
  { n: '04', title: 'Instructores', text: 'Formamos a tus instructores para que sean autónomos.' },
  { n: '05', title: 'Soporte', text: 'Mantenimiento preventivo, garantías y asistencia técnica local.' },
];

// Capacidades de RE-liON, según su guía de marca. Numeradas: su marca no usa viñetas.
const capacidades = [
  { title: 'Sensores', text: 'Biofeedback, conciencia del entorno y captura de datos en tiempo real. El operador sabe más.' },
  { title: 'Inmersión', text: 'Escenarios de alta fidelidad sin infraestructura fija. En cualquier lugar y momento.' },
  { title: 'Equipo persona-máquina', text: 'Integración entre la cognición del operador y los sistemas autónomos.' },
];

const alliances = [
  {
    name: 'RE-liON',
    role: 'Plataforma táctica',
    text: 'Fabricante neerlandés de la plataforma táctica RE-liON. RIVSAN es su socio exclusivo en España.',
    href: site.partner.url,
    logo: logoRelion,
    wordmark: true,
  },
  {
    name: 'Ibero First Responders',
    role: 'Primeros auxilios tácticos',
    text: 'Acuerdo de colaboración para impartir formación en atención sanitaria táctica a Policía Local y FCSE.',
    href: '/formacion/#auxilios',
    logo: logoIfr,
  },
];
---

<BaseLayout
  title="Sobre nosotros"
  description="Socio exclusivo de RE-liON en España: simulación táctica avanzada para Fuerzas y Cuerpos de Seguridad, llave en mano y con un único interlocutor."
  image={operadores}
>
  <section class="about-hero">
    <div class="container content">
      <p class="eyebrow">Sobre nosotros</p>
      <h1 class="h-xl">Ayudamos a <span class="accent">los que nos protegen</span></h1>
      <p class="lead">
        Nacemos con una misión: llevar la tecnología de simulación táctica más avanzada del mundo a las Fuerzas y Cuerpos
        de Seguridad de España.
      </p>
    </div>
  </section>
  <!-- Vídeo del logotipo sobre la península con el shader de señal del hero (scripts/senal.ts) -->
  <div class="map-band" data-senal>
    <Image src={posterMapa} alt="Vista nocturna de la península ibérica en la que aparece el logotipo de RIVSAN" class="map-media poster" widths={[800, 1400, 1920]} sizes="100vw" loading="eager" fetchpriority="high" />
    <video class="map-media" data-senal-video data-src-sd={mapaSd} data-src-hd={mapaHd} muted loop playsinline preload="none" aria-hidden="true"></video>
    <canvas class="map-media" data-senal-gl aria-hidden="true"></canvas>
    <SignalFx />
    <p class="map-readout readout readout--stack" aria-hidden="true"><span><i class="rec rec--link"></i> ENLACE ACTIVO</span><span>COBERTURA · <b>ESPAÑA</b></span></p>
  </div>

  <!-- Qué nos diferencia -->
  <section class="section">
    <div class="container">
      <div class="head reveal">
        <p class="eyebrow">Qué nos diferencia</p>
        <h2 class="h-lg">Tecnología de primer nivel, <span class="accent">servicio de proximidad</span></h2>
      </div>
      <div class="pillars">
        {
          pillars.map((p, i) => (
            <article class="pillar reveal">
              <span class="pillar-n">{String(i + 1).padStart(2, '0')}</span>
              <h3>{p.title}</h3>
              <p class="muted">{p.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- En el terreno: fotos de cursos reales -->
  <section class="section field-section">
    <div class="container">
      <div class="head reveal">
        <p class="eyebrow">En el terreno</p>
        <h2 class="h-lg">Formación presencial, <span class="accent">por escenarios</span></h2>
      </div>
      <ul class="field">
        {
          terreno.map((f) => (
            <li class="reveal">
              <figure>
                <Image src={f.src} alt={f.alt} widths={[400, 800]} sizes="(max-width: 700px) 50vw, 25vw" style={`object-position: ${f.pos}`} />
                <figcaption>{f.caption}</figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Cómo trabajamos -->
  <section class="section alt">
    <div class="container">
      <div class="head reveal">
        <p class="eyebrow">Cómo trabajamos</p>
        <h2 class="h-lg">De la primera demo <span class="accent">al soporte continuo</span></h2>
      </div>
      <ol class="journey reveal">
        {
          steps.map((s) => (
            <li>
              <span class="node" aria-hidden="true"></span>
              <span class="journey-n">{s.n}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- RE-liON: el logotipo va solo, en blanco sobre fondo oscuro y sin efectos (guía de marca de RE-liON) -->
  <section class="relion">
    <Image src={sede} alt="Sede de RE-liON en los Países Bajos" class="relion-banner" widths={[800, 1600, 2400]} sizes="100vw" />
    <div class="container relion-intro">
      <div class="relion-text reveal">
        <p class="eyebrow">Nuestro partner</p>
        <Image src={logoRelion} alt="RE-liON" class="relion-logo" widths={[400, 800]} sizes="320px" />
        <h2 class="h-lg">Supercognición <span class="accent">para quienes nos protegen</span></h2>
        <p class="muted">
          Estar preparado no es un punto de llegada: es una condición que se mantiene. RE-liON existe para cerrar la
          distancia entre estar equipado y estar preparado.
        </p>
        <p class="muted">
          Nace en los Países Bajos, de la ingeniería: tecnología de sensores, investigación en rendimiento humano y
          sistemas de grado aeroespacial. Su plataforma táctica está probada con la Policía Nacional, el Ejército y el
          Ministerio de Defensa de los Países Bajos.
        </p>
        <ol class="relion-caps">
          {
            capacidades.map((c, i) => (
              <li>
                <span class="relion-caps-n">{String(i + 1).padStart(2, '0')}</span>
                <h3>{c.title}</h3>
                <p>{c.text}</p>
              </li>
            ))
          }
        </ol>
        <a href={site.partner.url} class="link-arrow" target="_blank" rel="noopener">
          Visitar re-lion.com <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="relion-media hud reveal">
        <Image src={visor} alt="Agente ajustándose el visor de RE-liON" widths={[500, 900, 1200]} sizes="(max-width: 960px) 100vw, 40vw" />
      </div>
    </div>
  </section>

  <Partner />

  <!-- Alianzas -->
  <section class="section alt">
    <div class="container">
      <div class="head reveal">
        <p class="eyebrow">Alianzas</p>
        <h2 class="h-lg">Trabajamos con <span class="accent">los mejores</span></h2>
      </div>
      <div class="alliances">
        {
          alliances.map((a) => (
            <a href={a.href} class="alliance reveal" {...(a.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>
              <Image src={a.logo} alt={a.name} class:list={['alliance-logo', a.wordmark ? 'alliance-logo--wordmark' : 'alliance-logo--badge']} widths={[300, 600]} sizes="240px" />
              <span class="alliance-role">{a.role}</span>
              {!a.wordmark && <span class="alliance-name">{a.name}</span>}
              <p class="muted">{a.text}</p>
              <span class="link-arrow">
                {a.href.startsWith('http') ? 'Web oficial ↗' : 'Ver cursos →'}
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <DemoForm />
</BaseLayout>

<script>
  import { videoConSenal } from '../scripts/senal';
  // La versión SD ya mide 1280 px: HD solo en pantallas grandes
  document.querySelectorAll<HTMLElement>('[data-senal]').forEach((caja) => videoConSenal(caja, { hdDesde: 1500 }));
</script>

<style>
  .about-hero {
    padding: calc(var(--header-h) + clamp(56px, 8vw, 104px)) 0 clamp(40px, 5vw, 64px);
    background: var(--bg);
  }

  /* Encuadre del vídeo: el logotipo queda algo por encima del centro */
  .map-band {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    aspect-ratio: 21 / 9;
    max-height: 78vh;
    width: 100%;
    border-block: 1px solid var(--line);
    --media-x: 0.5;
    --media-y: 0.4;
    --pausa-top: 16px;
    --pausa-right: var(--gutter);
  }

  .map-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
    z-index: -2;
  }

  .map-band video,
  .map-band canvas {
    opacity: 0;
  }

  .map-band.is-video video,
  .map-band.is-gl canvas {
    opacity: 1;
  }

  .map-band.is-video .poster,
  .map-band.is-gl .poster {
    visibility: hidden;
  }

  /* Funde los bordes con la página */
  .map-band::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(180deg, var(--bg) 0%, transparent 14%, transparent 86%, var(--bg) 100%);
  }

  .map-readout {
    position: absolute;
    right: var(--gutter);
    bottom: 18px;
    z-index: 1;
  }

  @media (max-width: 700px) {
    .map-band {
      aspect-ratio: 4 / 3;
      --media-y: 0.38;
    }

    .map-readout {
      display: none;
    }
  }

  .content h1 {
    font-size: clamp(2.75rem, 6vw, 5.5rem);
    max-width: 11em;
    margin-bottom: 1.25rem;
  }

  .content .lead {
    color: #d6d6d0;
  }

  .alt {
    background: var(--bg-2);
    border-block: 1px solid var(--line);
  }

  .head {
    max-width: 780px;
    margin-bottom: 48px;
  }

  /* Pilares */
  .field-section {
    padding-top: 0;
  }

  .field {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .field figure {
    margin: 0;
  }

  .field img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border: 1px solid var(--line);
  }

  .field figcaption {
    margin-top: 12px;
    font-family: var(--font-label);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  @media (max-width: 960px) {
    .field {
      grid-template-columns: 1fr 1fr;
    }
  }

  .pillars {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .pillar {
    padding: 28px 24px;
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-top: 3px solid var(--line-strong);
  }

  .pillar-n {
    font-family: var(--font-display);
    font-size: 3rem;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px var(--text-dim);
  }

  .pillar h3 {
    font-size: 1.9rem;
    margin: 12px 0 10px;
  }

  .pillar p {
    margin: 0;
  }

  /* Recorrido */
  .journey {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    position: relative;
  }

  .journey::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 7px;
    height: 2px;
    background: linear-gradient(90deg, var(--yellow), rgba(247, 196, 0, 0.2));
  }

  .journey li {
    position: relative;
    padding: 36px 20px 0 0;
  }

  .node {
    position: absolute;
    top: 0;
    left: 0;
    width: 16px;
    height: 16px;
    background: var(--bg-2);
    border: 2px solid var(--yellow);
    transform: rotate(45deg);
  }

  .journey-n {
    font-family: var(--font-label);
    font-weight: 600;
    letter-spacing: 0.2em;
    color: var(--yellow);
    font-size: 0.9rem;
  }

  .journey h3 {
    font-size: 1.75rem;
    margin: 6px 0 8px;
  }

  .journey p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.975rem;
  }

  /* RE-liON */
  .relion {
    padding-bottom: var(--section-y);
  }

  /* Foto plana, sin degradados ni filtros: es imagen de RE-liON */
  .relion-banner {
    width: 100%;
    height: clamp(180px, 26vw, 360px);
    object-fit: cover;
    object-position: 50% 60%;
  }

  .relion-intro {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(32px, 6vw, 88px);
    align-items: center;
    margin-top: clamp(48px, 6vw, 80px);
  }

  .relion-logo {
    display: block;
    width: min(320px, 70%);
    height: auto;
    margin: 0.5rem 0 1.75rem;
  }

  .relion-text h2 {
    margin-bottom: 1.25rem;
  }

  .relion-caps {
    list-style: none;
    margin: 28px 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-block: 1px solid var(--line);
  }

  .relion-caps li {
    padding: 18px 16px 18px 0;
  }

  .relion-caps li + li {
    padding-left: 16px;
    border-left: 1px solid var(--line);
  }

  .relion-caps-n {
    font-family: var(--font-label);
    font-weight: 600;
    letter-spacing: 0.2em;
    color: var(--yellow);
    font-size: 0.9rem;
  }

  .relion-caps h3 {
    font-size: 1.6rem;
    margin: 4px 0 6px;
  }

  .relion-caps p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .relion-media img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 30%;
  }

  /* Alianzas */
  .alliances {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .alliance {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: clamp(28px, 4vw, 44px);
    background: var(--surface);
    border: 1px solid var(--line);
    text-decoration: none;
    transition: border-color 0.25s;
  }

  .alliance:hover {
    border-color: rgba(247, 196, 0, 0.5);
  }

  .alliance-logo {
    display: block;
    height: auto;
    margin-bottom: 20px;
  }

  .alliance-logo--wordmark {
    width: 180px;
  }

  .alliance-logo--badge {
    width: 96px;
  }

  .alliance-role {
    font-family: var(--font-label);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .alliance-name {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 5vw, 4rem);
    line-height: 1;
  }

  .alliance p {
    margin: 8px 0 16px;
  }

  @media (max-width: 1100px) {
    .pillars {
      grid-template-columns: 1fr 1fr;
    }

    .journey {
      grid-template-columns: 1fr;
      gap: 28px;
      padding-left: 36px;
    }

    .journey::before {
      left: 7px;
      right: auto;
      top: 0;
      bottom: 0;
      width: 2px;
      height: auto;
      background: linear-gradient(180deg, var(--yellow), rgba(247, 196, 0, 0.2));
    }

    .journey li {
      padding: 0;
    }

    .node {
      left: -36px;
      top: 4px;
    }
  }

  @media (max-width: 960px) {
    .relion-intro,
    .alliances {
      grid-template-columns: 1fr;
    }

  }

  @media (max-width: 600px) {
    .pillars {
      grid-template-columns: 1fr;
    }

    .relion-caps {
      grid-template-columns: 1fr;
    }

    .relion-caps li + li {
      padding-left: 0;
      border-left: 0;
      border-top: 1px solid var(--line);
    }
  }
</style>
