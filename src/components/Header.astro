---
import Logo from './Logo.astro';
import { nav } from '../data/site';

// La animación de entrada del logo solo se reproduce en la página de inicio
const isHome = Astro.url.pathname === import.meta.env.BASE_URL || Astro.url.pathname === `${import.meta.env.BASE_URL}/`;
---

<header class="site-header" data-header>
  <div class="container header-inner">
    <a href="/" class="brand">
      <Logo intro={isHome} />
    </a>

    <nav class="nav" id="main-nav" aria-label="Principal">
      <ul class="nav-list">
        {
          nav.map((item, i) =>
            item.children ? (
              <li class="has-sub" data-sub>
                <button class="nav-top" aria-expanded="false" aria-controls={`sub-${i}`} data-sub-toggle>
                  {item.label}
                  <span class="chev" aria-hidden="true" />
                </button>
                <div class="sub" id={`sub-${i}`}>
                  <ul>
                    {item.children.map((c) => (
                      <li>
                        <a href={c.href}>
                          <span class="sub-label">{c.label}</span>
                          {c.desc && <span class="sub-desc">{c.desc}</span>}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </li>
            ) : (
              <li>
                <a href={item.href} class="nav-top">
                  {item.label}
                  {item.soon && <span class="soon">Pronto</span>}
                </a>
              </li>
            ),
          )
        }
      </ul>
      <a href="/#contacto" class="btn btn-primary nav-cta">Solicitar demo</a>
    </nav>

    <button class="menu-toggle" aria-controls="main-nav" aria-expanded="false" data-menu-toggle>
      <span class="visually-hidden">Abrir menú</span>
      <span class="bars" aria-hidden="true"></span>
    </button>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  const subs = [...header.querySelectorAll<HTMLElement>('[data-sub]')];

  const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const toggleLabel = toggle.querySelector('.visually-hidden')!;
  const isOpen = () => header.classList.contains('is-open');
  const setOpen = (open: boolean) => {
    header.classList.toggle('is-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    toggleLabel.textContent = open ? 'Cerrar menú' : 'Abrir menú';
    document.body.style.overflow = open ? 'hidden' : '';
    // Con el panel abierto, el resto de la página queda fuera del tabulador y del lector de pantalla
    for (const el of document.body.children) if (el !== header) (el as HTMLElement).inert = open;
  };
  toggle.addEventListener('click', () => setOpen(!isOpen()));
  header.querySelectorAll('.nav a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  // Al pasar a escritorio el panel deja de existir: se cierra para no dejar la página inerte
  matchMedia('(max-width: 1080px)').addEventListener('change', (e) => !e.matches && isOpen() && setOpen(false));

  // Desplegables: clic (y teclado) en escritorio y acordeón en el menú móvil
  const setSub = (li: HTMLElement, open: boolean) => {
    li.classList.toggle('is-sub-open', open);
    li.querySelector('[data-sub-toggle]')!.setAttribute('aria-expanded', String(open));
  };
  subs.forEach((li) =>
    li.querySelector('[data-sub-toggle]')!.addEventListener('click', () => {
      const open = !li.classList.contains('is-sub-open');
      subs.forEach((other) => other !== li && setSub(other, false));
      setSub(li, open);
    }),
  );
  document.addEventListener('click', (e) => {
    if (!header.contains(e.target as Node)) subs.forEach((li) => setSub(li, false));
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    // Primero se cierra el desplegable abierto; con otra pulsación, el menú móvil
    const open = subs.find((li) => li.classList.contains('is-sub-open'));
    if (open) {
      setSub(open, false);
      open.querySelector<HTMLButtonElement>('[data-sub-toggle]')!.focus();
    } else if (isOpen()) {
      setOpen(false);
      toggle.focus();
    }
  });
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--header-h);
    transition: border-color 0.3s;
    border-bottom: 1px solid transparent;
  }

  /* El fondo con blur va en un pseudo-elemento: un backdrop-filter en el propio
     header convertiría al panel móvil (position: fixed) en hijo de su caja. */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgba(11, 11, 11, 0.92);
    backdrop-filter: blur(10px);
    opacity: 0;
    transition: opacity 0.3s;
  }

  .site-header.is-scrolled,
  .site-header.is-open {
    border-bottom-color: var(--line);
  }

  .site-header.is-scrolled::before,
  .site-header.is-open::before {
    opacity: 1;
  }

  .header-inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .brand {
    text-decoration: none;
    font-size: 17px;
    flex: none;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  /* Enlaces y botones de desplegable comparten métricas: el botón no hereda
     el interlineado del cuerpo, así que se fija aquí para ambos */
  .nav-top {
    font-family: var(--font-label);
    font-weight: 500;
    font-size: 1rem;
    line-height: 1.5;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--text);
    background: none;
    border: 0;
    border-bottom: 2px solid transparent;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
    padding: 6px 0;
    transition: color 0.2s, border-color 0.2s;
  }

  .nav-top:hover,
  .is-sub-open > .nav-top {
    color: var(--yellow);
    border-bottom-color: var(--yellow);
  }

  .chev {
    width: 7px;
    height: 7px;
    border: solid currentColor;
    border-width: 0 2px 2px 0;
    transform: translateY(-2px) rotate(45deg);
    transition: transform 0.2s;
  }

  .is-sub-open .chev {
    transform: translateY(1px) rotate(-135deg);
  }

  .has-sub {
    position: relative;
  }

  .sub {
    position: absolute;
    top: calc(100% + 14px);
    left: -20px;
    min-width: 320px;
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-top: 2px solid var(--line-strong);
    padding: 8px;
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.5);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity 0.2s, transform 0.2s, visibility 0.2s;
  }

  .is-sub-open .sub {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .sub a {
    display: grid;
    gap: 2px;
    padding: 12px 14px;
    text-decoration: none;
    border-radius: var(--radius);
    transition: background 0.15s;
  }

  .sub a:hover {
    background: var(--surface-2);
  }

  .sub-label {
    font-weight: 600;
    color: var(--text);
  }

  .sub a:hover .sub-label {
    color: var(--yellow);
  }

  .sub-desc {
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .soon {
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    padding: 2px 5px;
    border: 1px solid var(--yellow);
    color: var(--yellow);
    border-radius: 2px;
  }

  .nav-cta {
    padding: 0.7em 1.2em;
    font-size: 0.875rem;
    white-space: nowrap;
  }

  .menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    background: none;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    cursor: pointer;
    position: relative;
  }

  .bars,
  .bars::before,
  .bars::after {
    position: absolute;
    left: 11px;
    width: 20px;
    height: 2px;
    background: #fff;
    transition: transform 0.25s, opacity 0.25s;
  }

  .bars {
    top: 21px;
  }

  .bars::before,
  .bars::after {
    content: '';
    left: 0;
  }

  .bars::before {
    top: -7px;
  }

  .bars::after {
    top: 7px;
  }

  .is-open .bars {
    background: transparent;
  }

  .is-open .bars::before {
    transform: translateY(7px) rotate(45deg);
  }

  .is-open .bars::after {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (max-width: 1080px) {
    .menu-toggle {
      display: block;
    }

    .nav {
      position: fixed;
      inset: var(--header-h) 0 0;
      background: var(--bg);
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-start;
      gap: 32px;
      padding: 24px var(--gutter) 32px;
      transform: translateX(100%);
      visibility: hidden;
      transition: transform 0.3s, visibility 0.3s;
      overflow-y: auto;
      overscroll-behavior: contain;
    }

    .is-open .nav {
      transform: none;
      visibility: visible;
    }

    .nav-list {
      flex-direction: column;
      gap: 0;
    }

    .nav-list > li {
      border-bottom: 1px solid var(--line);
    }

    .nav-top {
      font-family: var(--font-display);
      font-size: 2.25rem;
      letter-spacing: 0.02em;
      padding-block: 12px;
      width: 100%;
      justify-content: space-between;
      border-bottom: 0;
    }

    .chev {
      width: 12px;
      height: 12px;
      border-width: 0 3px 3px 0;
    }

    /* En móvil el desplegable es un acordeón dentro del panel */
    .sub {
      position: static;
      min-width: 0;
      background: none;
      border: 0;
      box-shadow: none;
      padding: 0 0 12px;
      transform: none;
      display: none;
    }

    .is-sub-open .sub {
      display: block;
    }

    .sub a {
      padding: 10px 0 10px 16px;
      border-left: 2px solid var(--line-strong);
    }

    .nav-cta {
      font-size: 1rem;
      padding: 1em;
    }
  }
</style>
