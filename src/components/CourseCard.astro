---
import { Image } from 'astro:assets';
import { categorias, convocatoriasDe, rangoCorto, type Curso } from '../data/formacion';

interface Props {
  curso: Curso;
}
const { curso } = Astro.props;
const { data } = curso;
const proxima = convocatoriasDe(curso)[0];
const href = `/formacion/${curso.id}/`;
---

<article class="course-card" data-categoria={data.categoria}>
  <a href={href} class="media" tabindex="-1" aria-hidden="true">
    <Image src={data.imagen} alt="" widths={[480, 800]} sizes="(max-width: 960px) 100vw, 33vw" />
  </a>
  <div class="body">
    <span class="cat">{categorias[data.categoria].label}</span>
    <h3><a href={href}>{data.titulo}</a></h3>
    <p class="summary">{data.resumen}</p>
    <dl class="facts">
      <div><dt>Duración</dt><dd>{data.duracion}</dd></div>
      <div><dt>Plazas</dt><dd>{data.asistentes}</dd></div>
      <div>
        <dt>Próxima</dt>
        <dd>{proxima ? `${rangoCorto(proxima.inicio, proxima.fin)} · ${proxima.lugar}` : 'A demanda'}</dd>
      </div>
    </dl>
    <a href={href} class="link-arrow">+ Info</a>
  </div>
</article>

<style>
  /* v2: sin caja; un filete grueso arriba y la foto debajo */
  .course-card {
    display: flex;
    flex-direction: column;
    padding-top: 16px;
    border-top: 3px solid currentColor;
  }

  .media {
    display: block;
    overflow: hidden;
    margin-bottom: 18px;
  }

  .media img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .body {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .cat {
    font-weight: 600;
    color: var(--text-muted);
    margin-bottom: 6px;
  }

  h3 {
    font-stretch: var(--wide);
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(1.15rem, 1.6vw, 1.35rem);
    line-height: 1.08;
    margin-bottom: 10px;
  }

  h3 a {
    text-decoration: none;
  }

  h3 a:hover {
    text-decoration: underline;
    text-decoration-color: var(--yellow);
    text-decoration-thickness: 3px;
  }

  .summary {
    color: var(--text-muted);
    font-size: 0.975rem;
  }

  .facts {
    margin: 4px 0 20px;
    display: grid;
    font-size: 0.925rem;
  }

  .facts div {
    display: flex;
    gap: 12px;
    padding-block: 7px;
    border-top: 1px solid var(--line);
  }

  .facts dt {
    width: 72px;
    flex: none;
    font-weight: 600;
    color: var(--text-muted);
  }

  .facts dd {
    margin: 0;
    font-weight: 500;
  }

  .link-arrow {
    margin-top: auto;
    align-self: flex-start;
  }
</style>
