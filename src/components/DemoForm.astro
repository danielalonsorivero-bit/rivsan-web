---
import { Image } from 'astro:assets';
import RequestForm from './RequestForm.astro';
import { site } from '../data/site';
import photo from '../assets/img/agente-fusil.jpg';

// v2: la sección de contacto es la otra gran superficie amarilla de la página; el formulario
// va en un bloque de tinta encima.
---

<section class="section contact theme-signal" id="contacto">
  <div class="container grid">
    <div class="aside">
      <p class="eyebrow">Contacto</p>
      <h2 class="h-lg">Solicita una <span class="accent">demostración operativa</span></h2>
      <p class="lead">
        Vamos a tu jefatura o unidad, desplegamos el sistema y tus agentes lo prueban. Sin compromiso.
      </p>
      <div class="aside-media">
        <Image src={photo} alt="Agente con visor de realidad virtual apuntando con un fusil simulado" widths={[400, 700]} sizes="(max-width: 960px) 100vw, 35vw" />
      </div>
      <ul class="direct">
        <li><span>Email</span><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><span>Teléfono</span><a href={`tel:${site.phoneHref}`}>{site.phone}</a></li>
      </ul>
    </div>

    <div class="theme-ink" data-demo-form>
      <RequestForm />
    </div>
  </div>
</section>

<script>
  // Preselecciona el interés si viene en la URL (/?interes=renting#contacto)
  const select = document.querySelector<HTMLSelectElement>('[data-demo-form] select[name="interes"]');
  if (select) {
    const preselect = () => {
      const v = new URLSearchParams(location.search).get('interes');
      if (v && [...select.options].some((o) => o.value === v)) select.value = v;
    };
    preselect();
    // Los enlaces internos de la home solo cambian query+hash: evitamos recargar la página
    document.querySelectorAll<HTMLAnchorElement>('a[href*="interes="]').forEach((a) =>
      a.addEventListener('click', (e) => {
        const url = new URL(a.href);
        if (url.pathname !== location.pathname) return;
        e.preventDefault();
        history.replaceState(null, '', url.search + url.hash);
        preselect();
        const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;
        document.getElementById('contacto')?.scrollIntoView({ behavior: quieto ? 'auto' : 'smooth' });
      }),
    );
  }
</script>

<style>
  .grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(40px, 6vw, 96px);
    align-items: start;
  }

  .aside h2 {
    margin-bottom: 1.25rem;
  }

  .aside-media {
    margin: 32px 0;
  }

  .aside-media img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: 50% 30%;
    filter: grayscale(1) contrast(1.1);
    mix-blend-mode: multiply;
  }

  .direct {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    border-top: 3px solid var(--ink);
  }

  .direct li {
    display: flex;
    gap: 16px;
    align-items: baseline;
    padding-block: 12px;
    border-bottom: 1px solid var(--line);
  }

  .direct span {
    font-weight: 600;
    width: 90px;
    flex: none;
  }

  .direct a {
    font-size: 1.15rem;
    font-weight: 700;
    text-decoration: none;
  }

  .direct a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  @media (max-width: 960px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .aside-media {
      display: none;
    }
  }
</style>
