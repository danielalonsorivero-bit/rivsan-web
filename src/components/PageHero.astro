---
// Cabecera de páginas interiores: texto a la izquierda e imagen opcional a la derecha.
// Con `video`, en lugar de la imagen va el vídeo con el shader de señal del hero (scripts/senal.ts).
// Los botones van en el slot.
// v2: el texto va en un panel amarillo con el rótulo ancho, pegado a la imagen o al vídeo.
import { Image } from 'astro:assets';
import SignalFx from './SignalFx.astro';
import type { VideoPerfil } from '../data/videos';

interface Props {
  eyebrow: string;
  /** El segundo fragmento va resaltado en amarillo */
  title: [string, string];
  lead: string;
  image?: ImageMetadata;
  alt?: string;
  video?: VideoPerfil;
}
const { eyebrow, title, lead, image, alt = '', video } = Astro.props;
---

<section class:list={['page-hero', { 'page-hero--text': !image }]}>
  <div class="container hero-grid">
    <div class="hero-text theme-signal">
      <p class="kicker">{eyebrow}</p>
      <h1>{title[0]} <span class="accent">{title[1]}</span></h1>
      <p class="lead">{lead}</p>
      {Astro.slots.has('default') && <div class="actions"><slot /></div>}
    </div>
    {
      video ? (
        <div class="hero-media hud con-video" data-senal>
          <Image src={video.poster} alt={alt} class="media poster" widths={[500, 900]} sizes="(max-width: 960px) 100vw, 40vw" loading="eager" fetchpriority="high" />
          <video class="media" data-senal-video data-src-sd={video.sd} data-src-hd={video.hd} muted loop playsinline preload="none" aria-hidden="true" />
          <canvas class="media" data-senal-gl aria-hidden="true" />
          <SignalFx />
        </div>
      ) : image && (
        <div class="hero-media hud">
          <Image src={image} alt={alt} widths={[500, 900]} sizes="(max-width: 960px) 100vw, 40vw" loading="eager" fetchpriority="high" />
        </div>
      )
    }
  </div>
</section>

<script>
  import { videoConSenal } from '../scripts/senal';
  // La versión SD mide 640 px: por encima de eso se nota, así que pronto pasa a HD
  document.querySelectorAll<HTMLElement>('[data-senal]').forEach((caja) => videoConSenal(caja, { hdDesde: 760 }));
</script>

<style>
  .page-hero {
    padding: calc(var(--header-h) + clamp(24px, 4vw, 56px)) 0 clamp(48px, 6vw, 80px);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    align-items: stretch;
  }

  .page-hero--text .hero-grid {
    grid-template-columns: minmax(0, 940px);
  }

  .hero-text {
    container-type: inline-size;
    padding: clamp(28px, 4vw, 56px);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .kicker {
    font-weight: 600;
    margin-bottom: 1.25rem;
  }

  h1 {
    font-size: clamp(1.75rem, 7.2cqi, 4rem);
    margin-bottom: 1.25rem;
  }

  .hero-text .lead {
    color: var(--text);
    font-weight: 500;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
    margin-top: 1.5rem;
  }

  .hero-media img {
    width: 100%;
    height: 100%;
    min-height: 320px;
    object-fit: cover;
    object-position: 50% 30%;
  }

  /* Con vídeo: fotograma → vídeo → canvas del shader, apilados en la misma caja */
  .con-video {
    min-height: 320px;
    isolation: isolate;
    overflow: hidden;
    --media-x: 0.5;
  }

  .con-video .media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
    object-fit: cover;
    z-index: -2;
  }

  .con-video video,
  .con-video canvas {
    opacity: 0;
  }

  .con-video.is-video video,
  .con-video.is-gl canvas {
    opacity: 1;
  }

  .con-video.is-video .poster,
  .con-video.is-gl .poster {
    visibility: hidden;
  }

  @media (max-width: 960px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
