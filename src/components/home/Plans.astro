---
// Modalidades de contratación, editables desde el panel (Portada). Sin precios: todo se cierra por presupuesto.
import { planes } from '../../data/contenido/home.json';
---

<section class="section plans theme-light" id="contratacion">
  <div class="container">
    <div class="head reveal">
      {planes.antetitulo && <p class="eyebrow">{planes.antetitulo}</p>}
      <h2 class="h-lg">{planes.titulo} {planes.acento && <span class="accent">{planes.acento}</span>}</h2>
      {planes.entrada && <p class="lead">{planes.entrada}</p>}
    </div>

    <div class="grid">
      {
        planes.planes.map((p) => (
          <article class:list={['plan', 'reveal', { 'plan--featured hud': p.destacado }]}>
            {p.destacado && <span class="badge">Recomendado</span>}
            <h3 class="h-md">{p.nombre}</h3>
            {p.resumen && <p class="summary">{p.resumen}</p>}
            <ul>
              {p.puntos.map((pt) => <li>{pt}</li>)}
            </ul>
            <a
              href={`/?interes=${p.interes}#contacto`}
              class:list={['btn', p.destacado ? 'btn-primary' : 'btn-ghost']}
            >
              Solicitar presupuesto
            </a>
          </article>
        ))
      }
    </div>

    <p class="promise reveal">
      <strong>¿Ayuntamiento?</strong> Una jornada formativa suele poder tramitarse como contrato menor.
      <a href="/contratar/">Cómo contratar paso a paso →</a>
    </p>
  </div>
</section>

<style>
  .head {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 56px;
  }

  .head .eyebrow::after {
    content: '';
    width: 28px;
    height: 2px;
    background: var(--line-strong);
  }

  .head h2 {
    margin-bottom: 1.25rem;
  }

  .head .lead {
    margin-inline: auto;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    align-items: stretch;
  }

  .plan {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 36px 32px;
    background: var(--bg-2);
    border: 1px solid var(--line);
  }

  .plan--featured {
    background: var(--surface);
    border-color: rgba(247, 196, 0, 0.45);
  }

  .badge {
    position: absolute;
    top: -13px;
    right: 24px;
    background: var(--yellow);
    color: var(--ink);
    font-family: var(--font-label);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: 0.75rem;
    padding: 4px 10px;
  }

  .plan h3 {
    margin-bottom: 10px;
  }

  .summary {
    color: var(--text-muted);
    min-height: 3.2em;
  }

  .plan ul {
    list-style: none;
    margin: 8px 0 32px;
    padding: 20px 0 0;
    border-top: 1px solid var(--line);
    display: grid;
    gap: 12px;
  }

  .plan li {
    padding-left: 30px;
    position: relative;
  }

  .plan li::before {
    content: '✓';
    position: absolute;
    left: 0;
    top: 0.2em;
    width: 18px;
    height: 18px;
    display: grid;
    place-items: center;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--bg);
    background: var(--text);
    border-radius: 2px;
  }

  .plan .btn {
    margin-top: auto;
  }

  .promise {
    margin: 40px auto 0;
    text-align: center;
    color: var(--text-muted);
    max-width: 64ch;
  }

  .promise strong {
    color: var(--text);
  }

  .promise a {
    color: var(--text);
    white-space: nowrap;
  }

  .promise a {
    text-decoration-color: var(--yellow);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  @media (max-width: 960px) {
    .grid {
      grid-template-columns: 1fr;
      max-width: 520px;
      margin-inline: auto;
    }

    .summary {
      min-height: 0;
    }
  }
</style>
