---
// Modalidades de contratación, editables desde el panel (Portada). Sin precios: todo se cierra por presupuesto.
// v2: tres columnas con filetes; la recomendada lleva una cabecera amarilla en lugar de una insignia flotante.
import { planes } from '../../data/contenido/home.json';
---

<section class="section plans theme-light" id="contratacion">
  <div class="container">
    <div class="head">
      {planes.antetitulo && <p class="eyebrow">{planes.antetitulo}</p>}
      <h2 class="h-lg">{planes.titulo} {planes.acento && <span class="accent">{planes.acento}</span>}</h2>
      {planes.entrada && <p class="lead">{planes.entrada}</p>}
    </div>

    <div class="grid">
      {
        planes.planes.map((p) => (
          <article class:list={['plan', { 'plan--featured': p.destacado }]}>
            <p class="badge" aria-hidden={p.destacado ? undefined : 'true'}>{p.destacado ? 'Recomendado' : ''}</p>
            <h3>{p.nombre}</h3>
            {p.resumen && <p class="summary">{p.resumen}</p>}
            <ul>
              {p.puntos.map((pt) => <li>{pt}</li>)}
            </ul>
            <a
              href={`/?interes=${p.interes}#contacto`}
              class:list={['btn', p.destacado ? 'btn-primary' : 'btn-ghost']}
            >
              Solicitar presupuesto
            </a>
          </article>
        ))
      }
    </div>

    <p class="promise">
      <strong>¿Ayuntamiento?</strong> Una jornada formativa suele poder tramitarse como contrato menor.
      <a href="/contratar/">Cómo contratar paso a paso</a>
    </p>
  </div>
</section>

<style>
  .head {
    max-width: 940px;
    margin-bottom: clamp(40px, 5vw, 64px);
  }

  .head h2 {
    margin-bottom: 1.25rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 3px solid var(--ink);
  }

  .plan {
    display: flex;
    flex-direction: column;
    padding: 0 clamp(16px, 2.4vw, 32px) 32px;
  }

  .plan:first-child {
    padding-left: 0;
  }

  .plan:last-child {
    padding-right: 0;
  }

  .plan + .plan {
    border-left: 1px solid var(--line-strong);
  }

  /* Franja superior: vacía en los planes normales, amarilla en el recomendado */
  .badge {
    min-height: 2.25rem;
    margin: 0 0 24px;
    padding: 6px 0;
    font-weight: 700;
    font-size: 0.9375rem;
  }

  .plan--featured .badge {
    background: var(--yellow);
    margin-inline: calc(-1 * clamp(16px, 2.4vw, 32px));
    padding-inline: clamp(16px, 2.4vw, 32px);
  }

  .plan h3 {
    font-family: var(--font-display);
    font-stretch: var(--wide);
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(1.3rem, 2vw, 1.65rem);
    line-height: 1.05;
    margin-bottom: 12px;
  }

  .summary {
    color: var(--text-muted);
    min-height: 3.2em;
  }

  .plan ul {
    list-style: none;
    margin: 8px 0 32px;
    padding: 0;
    display: grid;
    gap: 0;
  }

  .plan li {
    padding: 10px 0;
    border-top: 1px solid var(--line);
    font-weight: 500;
  }

  .plan .btn {
    margin-top: auto;
    align-self: flex-start;
  }

  .promise {
    margin: 40px 0 0;
    color: var(--text-muted);
    max-width: 70ch;
  }

  .promise strong {
    color: var(--text);
  }

  .promise a {
    color: var(--text);
    font-weight: 700;
    white-space: nowrap;
    text-decoration-color: var(--yellow);
    text-decoration-thickness: 3px;
    text-underline-offset: 5px;
  }

  @media (max-width: 960px) {
    .grid {
      grid-template-columns: 1fr;
      border-top: 0;
    }

    .plan,
    .plan:first-child,
    .plan:last-child {
      padding: 0 0 32px;
      border-top: 3px solid var(--ink);
    }

    .plan + .plan {
      border-left: 0;
    }

    .plan--featured .badge {
      margin-inline: 0;
    }

    .badge:empty {
      min-height: 0;
      padding: 0;
      margin-bottom: 20px;
    }

    .summary {
      min-height: 0;
    }
  }
</style>
