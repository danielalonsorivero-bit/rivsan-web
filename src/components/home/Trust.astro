---
// Respaldo de RE-liON y compromisos de RIVSAN. Versión corta para la home;
// la historia completa de RE-liON está en /nosotros/ (componente Partner).
// PENDIENTE DE REVISAR: uso de logos/emblemas oficiales (de momento solo texto).
import { site } from '../../data/site';
import datos from '../../data/contenido/clientes.json';

// Clientes, compromisos y testimonios: editables desde el panel (Clientes y testimonios)
const { clientes: clients, compromisos: pledges, testimonios } = datos;
---

<section class="section trust" id="respaldo">
  <div class="container">
    <div class="grid">
      <div class="reveal">
        <p class="eyebrow">Respaldo internacional</p>
        <h2 class="h-lg">Probado por quienes <span class="accent">no pueden fallar</span></h2>
      </div>
      <div class="reveal">
        <p class="lead">
          RE-liON lleva desde 2005 desarrollando entrenamiento inmersivo para seguridad y defensa: creó el primer sistema
          sin cables del mundo y el primero desplegable para escuadras completas. RIVSAN lo trae a España.
        </p>
        <a href="/nosotros/" class="link-arrow">Conocer RIVSAN y RE-liON <span aria-hidden="true">→</span></a>
      </div>
    </div>

    <div class="clients reveal">
      <div class="clients-head">
        <p class="clients-title">Lo utilizan</p>
        <p class="readout" aria-hidden="true">
          <span><i class="rec rec--link"></i> EN SERVICIO · <b>{clients.length}</b> ORGANISMOS</span>
        </p>
      </div>
      <ul>
        {clients.map((c) => <li>{c}</li>)}
      </ul>
    </div>

    {
      testimonios.length > 0 && (
        <div class="voices">
          {testimonios.map((t) => (
            <figure class="voice reveal">
              <blockquote>{t.frase}</blockquote>
              <figcaption>
                <strong>{t.autor}</strong>
                {t.cargo && <span>{t.cargo}</span>}
              </figcaption>
            </figure>
          ))}
        </div>
      )
    }
  </div>
</section>

<section class="pledges" aria-label={`Compromiso ${site.name}`}>
  <div class="container">
    <ul>
      {
        pledges.map((p) => (
          <li class="reveal">
            <h3>{p.titulo}</h3>
            <p>{p.texto}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .voices {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
    margin-top: 48px;
  }

  .voice {
    margin: 0;
    padding: 28px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-left: 3px solid var(--yellow);
    border-radius: var(--radius);
  }

  .voice blockquote {
    margin: 0 0 20px;
    font-size: 1.1rem;
    line-height: 1.55;
    color: var(--text);
  }

  .voice blockquote::before {
    content: '«';
    color: var(--yellow);
  }

  .voice blockquote::after {
    content: '»';
    color: var(--yellow);
  }

  .voice figcaption {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 0.9rem;
  }

  .voice figcaption span {
    color: var(--text-muted);
  }

  .grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 24px clamp(40px, 6vw, 96px);
    align-items: end;
  }

  .grid .lead {
    margin-bottom: 1rem;
  }

  .clients {
    margin-top: 56px;
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }

  .clients-title {
    font-family: var(--font-label);
    font-weight: 600;
    font-size: 0.85rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin: 0;
  }

  .clients-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin-bottom: 20px;
  }

  .clients ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px 24px;
  }

  .clients li {
    font-family: var(--font-label);
    font-weight: 500;
    font-size: 1.05rem;
    letter-spacing: 0.04em;
    padding-left: 14px;
    border-left: 2px solid var(--line-strong);
  }

  /* Franja amarilla de ruptura */
  .pledges {
    background: var(--yellow);
    color: var(--ink);
  }

  .pledges ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .pledges li {
    padding: clamp(32px, 4vw, 48px) clamp(16px, 2vw, 28px);
  }

  .pledges li:first-child {
    padding-left: 0;
  }

  .pledges li + li {
    border-left: 1px solid rgba(35, 31, 32, 0.2);
  }

  .pledges h3 {
    font-size: clamp(1.6rem, 2.4vw, 2rem);
    margin-bottom: 8px;
  }

  .pledges p {
    margin: 0;
    font-weight: 500;
  }

  @media (max-width: 960px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .clients ul,
    .pledges ul {
      grid-template-columns: 1fr 1fr;
    }

    .pledges li,
    .pledges li:first-child {
      padding-left: 0;
      padding-right: 20px;
    }

    .pledges li:nth-child(even) {
      padding-left: 20px;
    }

    .pledges li:nth-child(odd) {
      border-left: 0;
    }

    .pledges li:nth-child(n + 3) {
      border-top: 1px solid rgba(35, 31, 32, 0.2);
    }
  }

  @media (max-width: 560px) {
    .clients ul,
    .pledges ul {
      grid-template-columns: 1fr;
    }

    .pledges li,
    .pledges li:nth-child(even) {
      padding-inline: 0;
      border-left: 0;
    }

    .pledges li + li {
      border-top: 1px solid rgba(35, 31, 32, 0.2);
    }
  }
</style>
