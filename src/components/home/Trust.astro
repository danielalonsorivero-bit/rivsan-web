---
// Respaldo de RE-liON y compromisos de RIVSAN. Versión corta para la home;
// la historia completa de RE-liON está en /nosotros/ (componente Partner).
// v2: todo sobre tinta; los compromisos cierran la sección en cuatro columnas con filete amarillo.
// PENDIENTE DE REVISAR: uso de logos/emblemas oficiales (de momento solo texto).
import { site } from '../../data/site';
import datos from '../../data/contenido/clientes.json';

// Clientes, compromisos y testimonios: editables desde el panel (Clientes y testimonios)
const { clientes: clients, compromisos: pledges, testimonios } = datos;
---

<section class="section trust" id="respaldo">
  <div class="container">
    <div class="grid">
      <div>
        <p class="eyebrow">Respaldo internacional</p>
        <h2 class="h-lg">Probado por quienes <span class="accent">no pueden fallar</span></h2>
      </div>
      <div>
        <p class="lead">
          RE-liON lleva desde 2005 desarrollando entrenamiento inmersivo para seguridad y defensa: creó el primer sistema
          sin cables del mundo y el primero desplegable para escuadras completas. RIVSAN lo trae a España.
        </p>
        <a href="/nosotros/" class="link-arrow">Conocer RIVSAN y RE-liON</a>
      </div>
    </div>

    <div class="clients">
      <p class="clients-title">Lo utilizan</p>
      <ul>
        {
          clients.map((c) => {
            // «Organismo · País»: el organismo en negrita y el país debajo
            const [org, pais] = c.split(' · ');
            return (
              <li>
                <strong>{org}</strong>
                {pais && <span>{pais}</span>}
              </li>
            );
          })
        }
      </ul>
    </div>

    {
      testimonios.length > 0 && (
        <div class="voices">
          {testimonios.map((t) => (
            <figure class="voice">
              <blockquote>{t.frase}</blockquote>
              <figcaption>
                <strong>{t.autor}</strong>
                {t.cargo && <span>{t.cargo}</span>}
              </figcaption>
            </figure>
          ))}
        </div>
      )
    }
  </div>
</section>

<section class="pledges" aria-label={`Compromiso ${site.name}`}>
  <div class="container">
    <ul>
      {
        pledges.map((p) => (
          <li>
            <h3>{p.titulo}</h3>
            <p>{p.texto}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Los compromisos siguen a la sección sin el aire completo entre ambos */
  .trust {
    padding-bottom: clamp(48px, 6vw, 80px);
  }

  .grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 24px clamp(40px, 6vw, 96px);
    align-items: end;
  }

  .grid .lead {
    margin-bottom: 1.25rem;
  }

  .clients {
    margin-top: clamp(48px, 6vw, 72px);
  }

  .clients-title {
    font-weight: 700;
    color: var(--text-muted);
    margin-bottom: 16px;
  }

  .clients ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--line-strong);
  }

  .clients li {
    display: grid;
    gap: 2px;
    padding: 16px 16px 16px 0;
    border-bottom: 1px solid var(--line);
  }

  .clients strong {
    font-weight: 700;
    line-height: 1.3;
  }

  .clients li span {
    font-size: 0.925rem;
    color: var(--text-muted);
  }

  .voices {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 32px;
    margin-top: 56px;
  }

  .voice {
    margin: 0;
    padding-left: 24px;
    border-left: 6px solid var(--yellow);
  }

  .voice blockquote {
    margin: 0 0 16px;
    font-size: 1.2rem;
    line-height: 1.5;
    font-weight: 500;
  }

  .voice blockquote::before {
    content: '«';
  }

  .voice blockquote::after {
    content: '»';
  }

  .voice figcaption {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 0.925rem;
  }

  .voice figcaption span {
    color: var(--text-muted);
  }

  /* Compromisos: cuatro columnas con filete amarillo grueso arriba */
  .pledges {
    padding-bottom: var(--section-y);
  }

  .pledges ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(20px, 3vw, 40px);
  }

  .pledges li {
    padding-top: 20px;
    border-top: 6px solid var(--yellow);
  }

  .pledges h3 {
    font-family: var(--font-display);
    font-stretch: var(--wide);
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(1.1rem, 1.6vw, 1.35rem);
    line-height: 1.05;
    margin-bottom: 10px;
  }

  .pledges p {
    margin: 0;
    color: var(--text-muted);
  }

  @media (max-width: 960px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .clients ul,
    .pledges ul {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .clients ul,
    .pledges ul {
      grid-template-columns: 1fr;
    }
  }
</style>
