---
// v2: la frase de marca a toda anchura sobre amarillo, en la letra ancha de los titulares.
import { cita } from '../../data/contenido/home.json'; // editable desde el panel (Portada)
---

<section class="quote-band theme-signal" aria-label="Nuestra filosofía">
  <div class="container">
    <blockquote>
      {[cita.antes, cita.destacado, cita.despues].filter(Boolean).join(' ')}
    </blockquote>
  </div>
</section>

<style>
  .quote-band {
    padding-block: clamp(64px, 9vw, 128px);
  }

  blockquote {
    margin: 0;
    max-width: 22ch;
    font-family: var(--font-display);
    font-stretch: var(--wide);
    font-weight: 800;
    font-size: clamp(1.9rem, 4.6vw, 4rem);
    line-height: 1;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    text-wrap: balance;
  }
</style>
