---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { calendario, categorias, rangoCorto } from '../../data/formacion';
import jornadas from '../../assets/img/policia-pabellon.jpg';
import auxilios from '../../assets/img/form-auxilios.jpg';
import defensa from '../../assets/img/form-defensa.jpg';

const proximas = calendario(await getCollection('cursos')).slice(0, 4);

// `interest` coincide con los valores del selector del formulario de contacto.
// `categoria` enlaza con el catálogo filtrado en /formacion/#<categoria>.
// v2: las tres líneas van en columnas separadas por filetes, sin caja; el calendario es una tabla.
const lines = [
  {
    title: 'Jornadas con simulador',
    partner: 'Con instructor RIVSAN',
    text: 'Llevamos el sistema y el equipo de instrucción a tu jefatura. Ideal para quien quiere entrenar sin comprar ni alquilar el equipo.',
    points: ['Hasta 20 agentes por jornada', 'Trabajo en binomios', 'Equipo completo e instructores incluidos'],
    image: jornadas,
    alt: 'Dos agentes de policía con visores de realidad virtual entrenando en un pabellón',
    interest: 'jornada',
    categoria: 'simulador',
  },
  {
    title: 'Primeros auxilios tácticos',
    partner: 'En colaboración con Iberotac',
    text: 'Atención sanitaria en entornos hostiles: control de hemorragias, evacuación y asistencia bajo amenaza.',
    points: ['Formación práctica por escenarios', 'Instructores especializados', 'Acreditación del curso'],
    image: auxilios,
    alt: 'Equipo táctico atendiendo a un herido durante un ejercicio',
    interest: 'auxilios',
    categoria: 'auxilios',
  },
  {
    title: 'Uso de la fuerza no letal',
    partner: 'Cursos para FCSE',
    text: 'Grappling táctico operativo, defensa ante armas de filo e impacto, control y arresto, y uso progresivo de la fuerza.',
    points: ['Técnicas operativas de intervención', 'Defensa ante armas blancas e impacto', 'Control, reducción y engrilletamiento'],
    image: defensa,
    alt: 'Agente realizando un ejercicio sobre tatami',
    interest: 'fuerza',
    categoria: 'fuerza',
  },
];
---

<section class="section training theme-light" id="formacion">
  <div class="container">
    <div class="head">
      <p class="eyebrow">Formación</p>
      <h2 class="h-lg">Un solo proveedor para <span class="accent">toda la preparación</span> del agente</h2>
      <p class="lead">
        Simulador, sanitaria táctica y uso de la fuerza con un mismo interlocutor. Cursos con fecha y plazas, o a medida
        para tu unidad.
      </p>
    </div>

    <div class="lines">
      {
        lines.map((l) => (
          <article class="line">
            <Image src={l.image} alt={l.alt} widths={[480, 800]} sizes="(max-width: 960px) 100vw, 30vw" />
            <p class="partner">{l.partner}</p>
            <h3>{l.title}</h3>
            <p class="muted">{l.text}</p>
            <ul>
              {l.points.map((p) => <li>{p}</li>)}
            </ul>
            <div class="line-links">
              <a href={`/formacion/#${l.categoria}`} class="link-arrow">Ver cursos</a>
              <a href={`/?interes=${l.interest}#contacto`} class="link-plain">Solicitar información</a>
            </div>
          </article>
        ))
      }
    </div>

    {
      proximas.length > 0 && (
        <div class="calendar">
          <div class="calendar-head">
            <h3 class="h-md">Próximas convocatorias</h3>
            <a href="/formacion/#calendario" class="link-arrow">Ver calendario completo</a>
          </div>
          <table>
            <caption class="visually-hidden">Próximas convocatorias de cursos</caption>
            <thead>
              <tr>
                <th scope="col">Fecha</th>
                <th scope="col">Curso</th>
                <th scope="col">Área</th>
                <th scope="col">Lugar</th>
              </tr>
            </thead>
            <tbody>
              {proximas.map((c) => (
                <tr>
                  <td class="date">{rangoCorto(c.inicio, c.fin)}</td>
                  <td class="title">
                    <a href={`/formacion/${c.curso.id}/`}>{c.curso.data.titulo}</a>
                  </td>
                  <td>{categorias[c.curso.data.categoria].label}</td>
                  <td>{c.lugar}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
  </div>
</section>

<style>
  .head {
    max-width: 940px;
    margin-bottom: clamp(40px, 5vw, 64px);
  }

  .head h2 {
    margin-bottom: 1.25rem;
  }

  /* Tres columnas separadas por filetes verticales, sin fondo ni borde de tarjeta */
  .lines {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 3px solid var(--ink);
  }

  .line {
    display: flex;
    flex-direction: column;
    padding: 28px clamp(16px, 2.4vw, 32px) 8px;
  }

  .line:first-child {
    padding-left: 0;
  }

  .line:last-child {
    padding-right: 0;
  }

  .line + .line {
    border-left: 1px solid var(--line-strong);
  }

  .line img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    margin-bottom: 24px;
  }

  .partner {
    font-weight: 600;
    color: var(--text-muted);
    margin-bottom: 6px;
  }

  .line h3 {
    font-family: var(--font-display);
    font-stretch: var(--wide);
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(1.25rem, 1.9vw, 1.6rem);
    line-height: 1.05;
    margin-bottom: 14px;
  }

  .line ul {
    list-style: none;
    margin: 0 0 24px;
    padding: 0;
    display: grid;
    gap: 6px;
    font-size: 0.975rem;
    font-weight: 500;
  }

  .line li {
    padding-left: 18px;
    position: relative;
  }

  .line li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 8px;
    height: 8px;
    background: var(--yellow);
    outline: 1px solid var(--ink);
  }

  .line-links {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 12px 24px;
  }

  .link-plain {
    color: var(--text-muted);
  }

  .link-plain:hover {
    color: var(--text);
  }

  /* Calendario: tabla de convocatorias */
  .calendar {
    margin-top: clamp(56px, 7vw, 96px);
  }

  .calendar-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }

  table {
    width: 100%;
    border-collapse: collapse;
  }

  th {
    text-align: left;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--text-muted);
    padding: 0 16px 10px 0;
    border-bottom: 3px solid var(--ink);
  }

  td {
    padding: 16px 16px 16px 0;
    border-bottom: 1px solid var(--line-strong);
    vertical-align: baseline;
  }

  td.date {
    white-space: nowrap;
    font-family: var(--font-display);
    font-stretch: var(--wide);
    font-weight: 800;
    font-size: 1.125rem;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
  }

  td.title a {
    font-weight: 700;
    text-decoration: none;
  }

  td.title a:hover {
    text-decoration: underline;
    text-decoration-color: var(--yellow);
    text-decoration-thickness: 3px;
  }

  td:nth-child(3),
  td:nth-child(4) {
    color: var(--text-muted);
  }

  @media (max-width: 960px) {
    .lines {
      grid-template-columns: 1fr;
      border-top: 0;
    }

    .line,
    .line:first-child,
    .line:last-child {
      padding: 28px 0;
      border-top: 3px solid var(--ink);
    }

    .line + .line {
      border-left: 0;
    }
  }

  /* En móvil la tabla pasa a una lista: fecha arriba y el resto debajo */
  @media (max-width: 620px) {
    thead {
      display: none;
    }

    table,
    tbody,
    tr,
    td {
      display: block;
    }

    tr {
      padding-block: 14px;
      border-bottom: 1px solid var(--line-strong);
    }

    td {
      border: 0;
      padding: 0;
    }

    td:nth-child(3),
    td:nth-child(4) {
      display: inline;
      font-size: 0.925rem;
    }

    td:nth-child(3)::after {
      content: ', ';
    }
  }
</style>
