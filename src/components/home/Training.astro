---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { calendario, categorias, rangoCorto } from '../../data/formacion';
import jornadas from '../../assets/img/policia-pabellon.jpg';
import auxilios from '../../assets/img/form-auxilios.jpg';
import defensa from '../../assets/img/form-defensa.jpg';

const proximas = calendario(await getCollection('cursos')).slice(0, 4);

// `interest` coincide con los valores del selector del formulario de contacto.
// `categoria` enlaza con el catálogo filtrado en /formacion/#<categoria>.
const lines = [
  {
    title: 'Jornadas con simulador',
    partner: 'Con instructor RIVSAN',
    text: 'Llevamos el sistema y el equipo de instrucción a tu jefatura. Ideal para quien quiere entrenar sin comprar ni alquilar el equipo.',
    points: ['Hasta 20 agentes por jornada', 'Trabajo en binomios', 'Equipo completo e instructores incluidos'],
    image: jornadas,
    alt: 'Dos agentes de policía con visores de realidad virtual entrenando en un pabellón',
    interest: 'jornada',
    categoria: 'simulador',
  },
  {
    title: 'Primeros auxilios tácticos',
    partner: 'En colaboración con Iberotac',
    text: 'Atención sanitaria en entornos hostiles: control de hemorragias, evacuación y asistencia bajo amenaza.',
    points: ['Formación práctica por escenarios', 'Instructores especializados', 'Acreditación del curso'],
    image: auxilios,
    alt: 'Equipo táctico atendiendo a un herido durante un ejercicio',
    interest: 'auxilios',
    categoria: 'auxilios',
  },
  {
    title: 'Uso de la fuerza no letal',
    partner: 'Cursos para FCSE',
    text: 'Grappling táctico operativo, defensa ante armas de filo e impacto, control y arresto, y uso progresivo de la fuerza.',
    points: ['Técnicas operativas de intervención', 'Defensa ante armas blancas e impacto', 'Control, reducción y engrilletamiento'],
    image: defensa,
    alt: 'Agente realizando un ejercicio sobre tatami',
    interest: 'fuerza',
    categoria: 'fuerza',
  },
];
---

<section class="section training" id="formacion">
  <div class="container">
    <div class="head reveal">
      <p class="eyebrow">Formación</p>
      <h2 class="h-lg">Un solo proveedor para <span class="accent">toda la preparación</span> del agente</h2>
      <p class="lead">
        Simulador, sanitaria táctica y uso de la fuerza con un mismo interlocutor. Cursos con fecha y plazas, o a medida
        para tu unidad.
      </p>
    </div>

    <div class="cards">
      {
        lines.map((l) => (
          <article class="card reveal">
            <div class="card-media">
              <Image src={l.image} alt={l.alt} widths={[480, 800]} sizes="(max-width: 960px) 100vw, 33vw" />
            </div>
            <div class="card-body">
              <span class="partner">{l.partner}</span>
              <h3 class="h-md">{l.title}</h3>
              <p class="muted">{l.text}</p>
              <ul>
                {l.points.map((p) => <li>{p}</li>)}
              </ul>
              <div class="card-links">
                <a href={`/formacion/#${l.categoria}`} class="link-arrow">
                  Ver cursos <span aria-hidden="true">→</span>
                </a>
                <a href={`/?interes=${l.interest}#contacto`} class="link-plain">Solicitar información</a>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    {
      proximas.length > 0 && (
        <div class="calendar reveal">
          <div class="calendar-head">
            <h3 class="h-md">Próximas convocatorias</h3>
            <a href="/formacion/#calendario" class="link-arrow">
              Ver calendario completo <span aria-hidden="true">→</span>
            </a>
          </div>
          <ul>
            {proximas.map((c) => (
              <li>
                <a href={`/formacion/${c.curso.id}/`}>
                  <span class="date">{rangoCorto(c.inicio, c.fin)}</span>
                  <span class="title">{c.curso.data.titulo}</span>
                  <span class="meta">
                    {categorias[c.curso.data.categoria].label} · {c.lugar}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</section>

<style>
  .training {
    background: var(--bg-2);
    border-block: 1px solid var(--line);
  }

  .head {
    max-width: 780px;
    margin-bottom: 56px;
  }

  .head h2 {
    margin-bottom: 1.25rem;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .card {
    background: var(--surface);
    border: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    transition: border-color 0.25s, transform 0.25s;
  }

  .card:hover {
    border-color: rgba(247, 196, 0, 0.5);
  }

  .card-media {
    overflow: hidden;
    border-bottom: 3px solid var(--yellow);
  }

  .card-media img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    filter: grayscale(0.3);
  }

  .card-body {
    padding: 28px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .partner {
    font-family: var(--font-label);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-size: 0.8rem;
    color: var(--yellow);
    margin-bottom: 8px;
  }

  .card h3 {
    margin-bottom: 12px;
  }

  .card ul {
    list-style: none;
    margin: 0 0 24px;
    padding: 16px 0 0;
    border-top: 1px solid var(--line);
    display: grid;
    gap: 8px;
    font-size: 0.95rem;
  }

  .card li {
    padding-left: 20px;
    position: relative;
  }

  .card li::before {
    content: '›';
    position: absolute;
    left: 4px;
    color: var(--yellow);
    font-weight: 600;
  }

  .card-links {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px 20px;
  }

  .link-plain {
    font-size: 0.925rem;
    color: var(--text-muted);
  }

  .link-plain:hover {
    color: var(--text);
  }

  .calendar {
    margin-top: 56px;
  }

  .calendar-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
    padding-bottom: 14px;
    border-bottom: 2px solid var(--yellow);
  }

  .calendar ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .calendar li + li {
    border-left: 1px solid var(--line);
  }

  .calendar li a {
    display: grid;
    gap: 4px;
    padding: 20px 20px 20px 0;
    text-decoration: none;
    height: 100%;
  }

  .calendar li + li a {
    padding-left: 20px;
  }

  .calendar li a:hover .title {
    color: var(--yellow);
  }

  .calendar .date {
    font-family: var(--font-display);
    font-size: 1.9rem;
    line-height: 1;
    color: var(--yellow);
    text-transform: uppercase;
  }

  .calendar .title {
    font-weight: 600;
    line-height: 1.3;
  }

  .calendar .meta {
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  @media (max-width: 960px) {
    .calendar ul {
      grid-template-columns: 1fr 1fr;
    }

    .calendar li:nth-child(3) {
      border-left: 0;
    }

    .calendar li:nth-child(3) a {
      padding-left: 0;
    }

    .calendar li:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }

  @media (max-width: 560px) {
    .calendar ul {
      grid-template-columns: 1fr;
    }

    .calendar li + li {
      border-left: 0;
      border-top: 1px solid var(--line);
    }

    .calendar li + li a {
      padding-left: 0;
    }
  }

  @media (max-width: 960px) {
    .cards {
      grid-template-columns: 1fr;
    }

    .card {
      display: grid;
      grid-template-columns: 1fr 1.3fr;
    }

    .card-media {
      border-bottom: 0;
      border-right: 3px solid var(--yellow);
    }

    .card-media img {
      height: 100%;
      aspect-ratio: auto;
    }
  }

  @media (max-width: 680px) {
    .card {
      display: flex;
    }

    .card-media {
      border-right: 0;
      border-bottom: 3px solid var(--yellow);
    }

    .card-media img {
      aspect-ratio: 16 / 10;
    }
  }
</style>
