---
import { Image } from 'astro:assets';
import poster from '../../assets/img/hero-video-poster.jpg';
import video720 from '../../assets/video/hero-720.mp4?url';
import video1080 from '../../assets/video/hero-1080.mp4?url';
import SignalFx from '../SignalFx.astro';
import { hero as h } from '../../data/contenido/home.json';

// v2: el vídeo con el shader de señal ocupa la pantalla y el titular va en un panel amarillo con
// letra ancha, como un rótulo de vehículo. Debajo, una franja con las cifras (editables desde el panel).
---

<section class="hero">
  <div class="hero-media">
    <!-- Fotograma inicial (carga al instante) → vídeo → el vídeo pasa por un shader de señal NTSC en el canvas.
         Con «reducir movimiento», ahorro de datos o sin autoplay se queda el fotograma. -->
    <Image
      src={poster}
      alt="Dos agentes con visores de realidad virtual avanzan en binomio y se giran empuñando armas simuladas"
      class="hero-bg hero-poster"
      widths={[800, 1400, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <video
      class="hero-bg hero-video"
      data-senal-video
      data-src-sd={video720}
      data-src-hd={video1080}
      muted
      loop
      playsinline
      preload="none"
      aria-hidden="true"></video>
    <canvas class="hero-bg hero-gl" data-senal-gl aria-hidden="true"></canvas>
    <SignalFx />

    <div class="container hero-content">
      <div class="panel theme-signal">
        {h.antetitulo && <p class="kicker">{h.antetitulo}</p>}
        <h1>
          <span class="line">{h.titulo}</span>
          {h.acento && <span class="line">{h.acento}</span>}
        </h1>
        {h.entrada && <p class="entrada">{h.entrada}</p>}
        <div class="actions">
          <a href="#contacto" class="btn btn-primary">Solicitar demostración</a>
          <a href="#perfiles" class="link-arrow">Ver soluciones</a>
        </div>
      </div>
    </div>
  </div>

  <div class="container">
    <ul class="hero-stats">
      {
        h.cifras.map((s) => (
          <li>
            <span class="stat-value">
              {s.prefijo}
              {s.valor}
              {s.unidad && <small>{s.unidad}</small>}
            </span>
            <span class="stat-label">{s.texto}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  import { videoConSenal } from '../../scripts/senal';

  // Vídeo del hero con el shader de señal (ver scripts/senal.ts)
  const media = document.querySelector<HTMLElement>('.hero-media');
  if (media) videoConSenal(media);
</script>

<style>
  .hero {
    background: var(--ink);
  }

  /* Encuadre del vídeo: los agentes quedan a la derecha, libres del panel.
     El shader lee las mismas variables (scripts/senal.ts). */
  .hero-media {
    --fx-cycle: 7s;
    --media-x: 0.7;
    --media-shift: 0;
    --pausa-top: calc(var(--header-h) + 16px);
    --pausa-right: var(--gutter);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: min(92svh, 900px);
    display: flex;
    align-items: flex-end;
    padding-top: calc(var(--header-h) + 48px);
  }

  @media (max-width: 960px) {
    .hero-media {
      --media-x: 0.4;
      min-height: 0;
      padding-top: calc(var(--header-h) + 38vw);
    }
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: calc(var(--media-x) * 100%) 50%;
    z-index: -2;
  }

  .hero-video,
  .hero-gl {
    opacity: 0;
  }

  /* Con WebGL el vídeo sigue reproduciéndose (es la textura) pero solo se ve el canvas */
  .hero-media.is-video .hero-video,
  .hero-media.is-gl .hero-gl {
    opacity: 1;
  }

  .hero-media.is-video .hero-poster,
  .hero-media.is-gl .hero-poster {
    visibility: hidden;
  }

  /* El panel apoya en el borde inferior del vídeo */
  .hero-content {
    display: flex;
  }

  .panel {
    container-type: inline-size;
    width: min(100%, 980px);
    padding: clamp(24px, 4vw, 52px) clamp(20px, 4vw, 56px) clamp(28px, 4vw, 48px);
  }

  .kicker {
    font-weight: 600;
    margin-bottom: 1.25rem;
  }

  /* El rótulo: dos líneas en Archivo ancha, la segunda como continuación del mismo bloque */
  h1 {
    /* Calculado para que «Entrena la intervención» quepa en una línea del panel */
    font-size: clamp(1.5rem, 5.3cqi, 3.75rem);
    line-height: 0.98;
    letter-spacing: -0.02em;
    margin-bottom: clamp(20px, 3cqi, 32px);
  }

  .line {
    display: block;
  }

  .entrada {
    font-size: clamp(1.0625rem, 1.4vw, 1.1875rem);
    line-height: 1.5;
    font-weight: 500;
    max-width: 52ch;
    margin-bottom: 1.75rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
  }

  /* El único movimiento de la página: el panel sube sobre el vídeo al cargar */
  @media (prefers-reduced-motion: no-preference) {
    .panel {
      animation: rotulo 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) 0.15s both;
    }

    @keyframes rotulo {
      from {
        clip-path: inset(100% 0 0 0);
        transform: translateY(32px);
      }
      to {
        clip-path: inset(0 0 0 0);
        transform: none;
      }
    }
  }

  /* Franja de cifras bajo el vídeo */
  .hero-stats {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .hero-stats li {
    padding: 28px 24px 36px 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .hero-stats li + li {
    padding-left: 24px;
    border-left: 1px solid var(--line);
  }

  .stat-value {
    font-family: var(--font-display);
    font-stretch: var(--wide);
    font-weight: 800;
    font-size: clamp(1.75rem, 2.6vw, 2.25rem);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .stat-value small {
    font-family: var(--font-body);
    font-stretch: 100%;
    font-weight: 600;
    font-size: 0.45em;
    margin-left: 0.3em;
  }

  .stat-label {
    font-size: 0.975rem;
    line-height: 1.4;
    color: var(--text-muted);
  }

  @media (max-width: 820px) {
    .hero-stats {
      grid-template-columns: 1fr 1fr;
    }

    .hero-stats li,
    .hero-stats li + li {
      padding: 20px 16px 20px 0;
      border-left: 0;
    }

    .hero-stats li:nth-child(even) {
      padding-left: 16px;
      border-left: 1px solid var(--line);
    }

    .hero-stats li:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }

  @media (max-width: 560px) {
    .hero-content {
      padding-inline: 0;
    }
  }
</style>
