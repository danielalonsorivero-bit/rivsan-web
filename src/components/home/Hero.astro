---
import { Image } from 'astro:assets';
import hero from '../../assets/img/hero-binomio.jpg';
import SignalFx from '../SignalFx.astro';

// `count`: la cifra se anima desde 0 al aparecer (ver BaseLayout)
const stats = [
  { prefix: '<', value: '60', count: true, unit: 'min', label: 'Del furgón a la primera intervención' },
  { value: '12', count: true, unit: 'agentes', label: 'La unidad entrena junta, como interviene' },
  { value: '0', unit: 'obras', label: 'Un aula o un garaje bastan' },
  { value: '1:1', unit: '', label: 'Movimiento y armas de peso real' },
];
---

<section class="hero" data-xh-zone>
  <Image
    src={hero}
    alt="Dos agentes con visores de realidad virtual avanzan en binomio empuñando armas simuladas"
    class="hero-bg"
    widths={[800, 1400, 2200]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <!-- Copia de la imagen para el desdoble de color en los cortes de señal (mismo archivo, ya en caché) -->
  <Image src={hero} alt="" class="hero-bg hero-ghost" widths={[800, 1400, 2200]} sizes="100vw" loading="eager" aria-hidden="true" />
  <div class="hero-shade" aria-hidden="true"></div>
  <SignalFx />
  <p class="hero-readout data" aria-hidden="true">
    <span><i></i> SIM ACTIVO</span>
    <span data-hero-clock>T+00:00.000</span>
    <span>ESCENARIO 01 · BINOMIO</span>
  </p>

  <div class="container hero-content">
    <p class="eyebrow">Formación táctica inmersiva para FCSE</p>
    <h1 class="h-xl">Entrena la intervención <span class="accent">antes de que ocurra</span></h1>
    <p class="lead">
      Simulación en realidad virtual, primeros auxilios tácticos y uso de la fuerza no letal. Lo llevamos a tu jefatura:
      sin obras y en marcha en menos de una hora.
    </p>
    <div class="hero-actions">
      <a href="#contacto" class="btn btn-primary">Solicitar demostración <span class="arrow">→</span></a>
      <a href="#perfiles" class="btn btn-ghost">Ver soluciones</a>
    </div>
  </div>

  <div class="container">
    <ul class="hero-stats">
      {
        stats.map((s) => (
          <li>
            <span class="stat-value">
              {s.prefix}<span data-count={s.count ? s.value : undefined}>{s.value}</span>
              {s.unit && <small>{s.unit}</small>}
            </span>
            <span class="stat-label">{s.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  // Reloj de la lectura del visor (no corre con «reducir movimiento»)
  const clock = document.querySelector('[data-hero-clock]');
  if (clock && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const start = performance.now();
    const pad = (n: number, l = 2) => String(n).padStart(l, '0');
    let on = false;
    const tick = () => {
      if (!on) return;
      const ms = Math.floor(performance.now() - start);
      clock.textContent = `T+${pad(Math.floor(ms / 60000))}:${pad(Math.floor(ms / 1000) % 60)}.${pad(ms % 1000, 3)}`;
      requestAnimationFrame(tick);
    };
    // Solo corre mientras el hero está en pantalla
    new IntersectionObserver(([e]) => {
      on = e.isIntersecting;
      if (on) requestAnimationFrame(tick);
    }).observe(clock);
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-top: calc(var(--header-h) + 48px);
    overflow: hidden;
    isolation: isolate;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 30%;
    z-index: -2;
  }

  /* Corte de señal: la imagen tiembla un instante y se desdobla en color cada --fx-cycle */
  .hero {
    --fx-cycle: 7s;
  }

  .hero-ghost {
    opacity: 0;
    mix-blend-mode: screen;
    filter: sepia(1) saturate(6) hue-rotate(-50deg) brightness(0.7);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-bg {
      animation: jitter var(--fx-cycle) steps(1, end) infinite;
    }

    .hero-ghost {
      animation: ghost var(--fx-cycle) steps(1, end) infinite;
    }
  }

  @keyframes jitter {
    0%,
    86% {
      transform: none;
    }
    87% {
      transform: translate(-3px, 0) skewX(-0.6deg);
    }
    88% {
      transform: translate(2px, 1px);
    }
    89% {
      transform: translate(-1px, 0);
    }
    90%,
    95% {
      transform: none;
    }
    96% {
      transform: translate(2px, 0);
    }
    97% {
      transform: none;
    }
  }

  @keyframes ghost {
    0%,
    86% {
      opacity: 0;
      transform: none;
    }
    87% {
      opacity: 0.35;
      transform: translate(6px, 0);
    }
    88% {
      opacity: 0.25;
      transform: translate(-4px, 1px);
    }
    89%,
    100% {
      opacity: 0;
      transform: none;
    }
  }

  .hero-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgba(11, 11, 11, 0.92) 0%, rgba(11, 11, 11, 0.55) 55%, rgba(11, 11, 11, 0.2) 100%),
      linear-gradient(0deg, var(--bg) 0%, transparent 40%);
  }

  .hero-content {
    max-width: var(--max);
  }

  .hero-content h1 {
    font-size: clamp(2.75rem, 5.4vw, 5.25rem);
    max-width: 12em;
  }

  .hero-content h1 .accent {
    display: block;
    margin-bottom: 1.5rem;
  }

  .hero-content .lead {
    color: #d6d6d0;
    max-width: 52ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 2rem;
  }

  .hero-stats {
    list-style: none;
    padding: 0;
    margin: clamp(48px, 8vh, 96px) 0 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--line-strong);
  }

  .hero-stats li {
    padding: 28px 24px 40px 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .hero-stats li + li {
    padding-left: 24px;
    border-left: 1px solid var(--line);
  }

  .stat-value {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    line-height: 1;
    color: var(--yellow);
  }

  .stat-value small {
    font-family: var(--font-data);
    font-size: 0.3em;
    text-transform: uppercase;
    margin-left: 0.25em;
    color: var(--text);
    letter-spacing: 0.05em;
  }

  /* Lectura tipo visor en la esquina superior derecha */
  .hero-readout {
    position: absolute;
    top: calc(var(--header-h) + 24px);
    right: var(--gutter);
    margin: 0;
    display: grid;
    justify-items: end;
    gap: 4px;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: rgba(242, 242, 240, 0.7);
  }

  .hero-readout i {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #ff5a5f;
    margin-right: 6px;
    animation: rec 1.2s steps(2) infinite;
  }

  @keyframes rec {
    50% {
      opacity: 0.2;
    }
  }

  @media (max-width: 960px) {
    .hero-readout {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-readout i {
      animation: none;
    }
  }

  .stat-label {
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  @media (max-width: 820px) {
    .hero-stats {
      grid-template-columns: 1fr 1fr;
    }

    .hero-stats li,
    .hero-stats li + li {
      padding: 20px 16px 20px 0;
      border-left: 0;
    }

    .hero-stats li:nth-child(even) {
      padding-left: 16px;
      border-left: 1px solid var(--line);
    }

    .hero-stats li:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }
</style>
