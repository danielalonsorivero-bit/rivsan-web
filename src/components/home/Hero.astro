---
import { Image } from 'astro:assets';
import poster from '../../assets/img/hero-video-poster.jpg';
import video720 from '../../assets/video/hero-720.mp4?url';
import video1080 from '../../assets/video/hero-1080.mp4?url';
import SignalFx from '../SignalFx.astro';

// `count`: la cifra se anima desde 0 al aparecer (ver BaseLayout)
const stats = [
  { prefix: '<', value: '60', count: true, unit: 'min', label: 'Del furgón a la primera intervención' },
  { value: '12', count: true, unit: 'agentes', label: 'La unidad entrena junta, como interviene' },
  { value: '0', unit: 'obras', label: 'Un aula o un garaje bastan' },
  { value: '1:1', unit: '', label: 'Movimiento y armas de peso real' },
];
---

<section class="hero">
  <!-- Fotograma inicial (carga al instante) → vídeo → el vídeo pasa por un shader de señal NTSC en el canvas.
       Con «reducir movimiento», ahorro de datos o sin autoplay se queda el fotograma. -->
  <Image
    src={poster}
    alt="Dos agentes con visores de realidad virtual avanzan en binomio y se giran empuñando armas simuladas"
    class="hero-bg hero-poster"
    widths={[800, 1400, 1920]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <video
    class="hero-bg hero-video"
    data-hero-video
    data-src-sd={video720}
    data-src-hd={video1080}
    muted
    loop
    playsinline
    preload="none"
    aria-hidden="true"></video>
  <canvas class="hero-bg hero-gl" data-hero-gl aria-hidden="true"></canvas>
  <div class="hero-shade" aria-hidden="true"></div>
  <SignalFx />
  <p class="hero-readout data" aria-hidden="true">
    <span><i></i> <b data-hero-status>SIM ACTIVO</b></span>
    <span data-hero-clock>T+00:00.000</span>
    <span>ESCENARIO 01 · BINOMIO</span>
  </p>

  <div class="container hero-content">
    <p class="eyebrow">Formación táctica inmersiva para FCSE</p>
    <h1 class="h-xl">Entrena la intervención <span class="accent">antes de que ocurra</span></h1>
    <p class="lead">
      Simulación en realidad virtual, primeros auxilios tácticos y uso de la fuerza no letal. Lo llevamos a tu jefatura:
      sin obras y en marcha en menos de una hora.
    </p>
    <div class="hero-actions">
      <a href="#contacto" class="btn btn-primary">Solicitar demostración <span class="arrow">→</span></a>
      <a href="#perfiles" class="btn btn-ghost">Ver soluciones</a>
    </div>
  </div>

  <div class="container">
    <ul class="hero-stats">
      {
        stats.map((s) => (
          <li>
            <span class="stat-value">
              {s.prefix}<span data-count={s.count ? s.value : undefined}>{s.value}</span>
              {s.unit && <small>{s.unit}</small>}
            </span>
            <span class="stat-label">{s.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  import { heroShader } from './hero-shader';

  // Vídeo del hero: se carga tras el fotograma inicial y se pinta con el shader de señal (ver hero-shader.ts).
  // Cortes de señal: en la costura del bucle (tapa el salto al primer fotograma), al arrancar y al azar cada pocos segundos.
  const hero = document.querySelector<HTMLElement>('.hero');
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-gl]');
  const status = document.querySelector('[data-hero-status]');
  const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const ahorro = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;

  if (hero && video && canvas && !quieto && !ahorro) {
    video.src = (innerWidth * devicePixelRatio > 1600 ? video.dataset.srcHd : video.dataset.srcSd) ?? '';
    video.play().then(
      () => {
        const gl = iniciarGL(hero, video, canvas);
        hero.classList.add(gl ? 'is-gl' : 'is-video');
      },
      () => {}, // sin autoplay (p. ej. modo de bajo consumo): se queda el fotograma
    );
  }

  function iniciarGL(hero: HTMLElement, video: HTMLVideoElement, canvas: HTMLCanvasElement) {
    const gl = canvas.getContext('webgl', { alpha: false, antialias: false, powerPreference: 'low-power' });
    if (!gl) return false;
    const shader = (tipo: number, src: string) => {
      const s = gl.createShader(tipo)!;
      gl.shaderSource(s, src);
      gl.compileShader(s);
      return gl.getShaderParameter(s, gl.COMPILE_STATUS) ? s : null;
    };
    const vs = shader(gl.VERTEX_SHADER, heroShader.vertex);
    const fs = shader(gl.FRAGMENT_SHADER, heroShader.fragment);
    if (!vs || !fs) return false;
    const prog = gl.createProgram()!;
    gl.attachShader(prog, vs);
    gl.attachShader(prog, fs);
    gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) return false;
    gl.useProgram(prog);

    gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
    const aPos = gl.getAttribLocation(prog, 'aPos');
    gl.enableVertexAttribArray(aPos);
    gl.vertexAttribPointer(aPos, 2, gl.FLOAT, false, 0, 0);

    gl.bindTexture(gl.TEXTURE_2D, gl.createTexture());
    gl.pixelStorei(gl.UNPACK_FLIP_Y_WEBGL, true);
    for (const [k, v] of [
      [gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE],
      [gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE],
      [gl.TEXTURE_MIN_FILTER, gl.LINEAR],
      [gl.TEXTURE_MAG_FILTER, gl.LINEAR],
    ])
      gl.texParameteri(gl.TEXTURE_2D, k, v);

    const u = (n: string) => gl.getUniformLocation(prog, n);
    const [uRes, uVid, uPos, uShift, uTime, uGlitch] = ['uRes', 'uVid', 'uPos', 'uShift', 'uTime', 'uGlitch'].map(u);

    // Encuadre: lo marcan las variables CSS --media-x y --media-shift (cambian con el ancho, ver estilos)
    const medir = () => {
      const r = Math.min(devicePixelRatio, 1.5);
      canvas.width = Math.min(Math.round(hero.clientWidth * r), 2200);
      canvas.height = Math.round(hero.clientHeight * (canvas.width / hero.clientWidth));
      gl.viewport(0, 0, canvas.width, canvas.height);
      const css = getComputedStyle(hero);
      gl.uniform2f(uRes, canvas.width, canvas.height);
      gl.uniform2f(uPos, parseFloat(css.getPropertyValue('--media-x')) || 0.5, 0.5);
      gl.uniform1f(uShift, parseFloat(css.getPropertyValue('--media-shift')) || 0);
    };
    new ResizeObserver(medir).observe(hero);

    const inicio = performance.now();
    let rafaga = { desde: 0, hasta: 0.7, fuerza: 1 }; // corte fuerte al aparecer el vídeo
    let proxima = 3;
    let visible = true;
    let pintando = false;

    const frame = (ahora: number) => {
      if (!visible || document.hidden) return (pintando = false);
      const t = (ahora - inicio) / 1000;
      if (t > proxima) {
        rafaga = { desde: t, hasta: t + 0.12 + Math.random() * 0.25, fuerza: 0.3 + Math.random() * 0.4 };
        proxima = t + 2.5 + Math.random() * 3;
      }
      const enRafaga = t >= rafaga.desde && t < rafaga.hasta ? rafaga.fuerza * (1 - (t - rafaga.desde) / (rafaga.hasta - rafaga.desde)) : 0;
      // Costura del bucle: sube en los últimos 0,35 s y baja en los primeros 0,25 s
      const d = video.duration ? Math.min(video.duration - video.currentTime, video.currentTime * 1.4) : 1;
      const costura = Math.max(0, 1 - d / 0.35) ** 1.5;
      const g = Math.min(1, Math.max(enRafaga, costura));
      if (status) status.textContent = costura > 0.4 ? 'SEÑAL · RESYNC' : 'SIM ACTIVO';

      if (video.readyState >= 2) {
        gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGB, gl.RGB, gl.UNSIGNED_BYTE, video);
        gl.uniform2f(uVid, video.videoWidth, video.videoHeight);
      }
      gl.uniform1f(uTime, t);
      gl.uniform1f(uGlitch, g);
      gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
      requestAnimationFrame(frame);
    };
    const arrancar = () => {
      if (visible && !document.hidden && !pintando) {
        pintando = true;
        requestAnimationFrame(frame);
      }
    };

    // Fuera de pantalla se para todo, también el vídeo
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      visible ? (video.play().catch(() => {}), arrancar()) : video.pause();
    }).observe(hero);
    document.addEventListener('visibilitychange', arrancar);
    medir();
    arrancar();
    return true;
  }
</script>

<script>
  // Reloj de la lectura del visor (no corre con «reducir movimiento»)
  const clock = document.querySelector('[data-hero-clock]');
  if (clock && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const start = performance.now();
    const pad = (n: number, l = 2) => String(n).padStart(l, '0');
    let on = false;
    const tick = () => {
      if (!on) return;
      const ms = Math.floor(performance.now() - start);
      clock.textContent = `T+${pad(Math.floor(ms / 60000))}:${pad(Math.floor(ms / 1000) % 60)}.${pad(ms % 1000, 3)}`;
      requestAnimationFrame(tick);
    };
    // Solo corre mientras el hero está en pantalla
    new IntersectionObserver(([e]) => {
      on = e.isIntersecting;
      if (on) requestAnimationFrame(tick);
    }).observe(clock);
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-top: calc(var(--header-h) + 48px);
    overflow: hidden;
    isolation: isolate;
  }

  /* Encuadre del vídeo, centrado para no cortar el arma del agente de la derecha.
     --media-shift (fracción del ancho) lo desplazaría a la derecha, fundiendo el borde a negro.
     El shader lee las mismas variables (Hero.astro, iniciarGL). */
  .hero {
    --fx-cycle: 7s;
    --media-x: 0.5;
    --media-shift: 0;
  }

  @media (max-width: 960px) {
    .hero {
      --media-x: 0.3;
    }
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: calc(var(--media-x) * 100%) 50%;
    z-index: -2;
  }

  .hero-poster,
  .hero-video {
    translate: calc(var(--media-shift) * 100%) 0;
  }

  .hero-video,
  .hero-gl {
    opacity: 0;
  }

  /* Con WebGL el vídeo sigue reproduciéndose (es la textura) pero solo se ve el canvas */
  .hero.is-video .hero-video,
  .hero.is-gl .hero-gl {
    opacity: 1;
  }

  .hero.is-video .hero-poster,
  .hero.is-gl .hero-poster {
    visibility: hidden;
  }

  /* Sin WebGL: el fotograma o el vídeo tiemblan un instante cada --fx-cycle */
  @media (prefers-reduced-motion: no-preference) {
    .hero-poster,
    .hero-video {
      animation: jitter var(--fx-cycle) steps(1, end) infinite;
    }
  }

  @keyframes jitter {
    0%,
    86% {
      transform: none;
    }
    87% {
      transform: translate(-3px, 0) skewX(-0.6deg);
    }
    88% {
      transform: translate(2px, 1px);
    }
    89% {
      transform: translate(-1px, 0);
    }
    90%,
    95% {
      transform: none;
    }
    96% {
      transform: translate(2px, 0);
    }
    97% {
      transform: none;
    }
  }

  .hero-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgba(11, 11, 11, 0.92) 0%, rgba(11, 11, 11, 0.55) 55%, rgba(11, 11, 11, 0.2) 100%),
      linear-gradient(0deg, var(--bg) 0%, transparent 40%);
  }

  .hero-content {
    max-width: var(--max);
  }

  .hero-content h1 {
    font-size: clamp(2.75rem, 5.4vw, 5.25rem);
    max-width: 12em;
  }

  .hero-content h1 .accent {
    display: block;
    margin-bottom: 1.5rem;
  }

  .hero-content .lead {
    color: #d6d6d0;
    max-width: 52ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 2rem;
  }

  .hero-stats {
    list-style: none;
    padding: 0;
    margin: clamp(48px, 8vh, 96px) 0 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--line-strong);
  }

  .hero-stats li {
    padding: 28px 24px 40px 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .hero-stats li + li {
    padding-left: 24px;
    border-left: 1px solid var(--line);
  }

  .stat-value {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    line-height: 1;
    color: var(--yellow);
  }

  .stat-value small {
    font-family: var(--font-data);
    font-size: 0.3em;
    text-transform: uppercase;
    margin-left: 0.25em;
    color: var(--text);
    letter-spacing: 0.05em;
  }

  /* Lectura tipo visor en la esquina superior derecha */
  .hero-readout {
    position: absolute;
    top: calc(var(--header-h) + 24px);
    right: var(--gutter);
    margin: 0;
    display: grid;
    justify-items: end;
    gap: 4px;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: rgba(242, 242, 240, 0.7);
  }

  .hero-readout i {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #ff5a5f;
    margin-right: 6px;
    animation: rec 1.2s steps(2) infinite;
  }

  @keyframes rec {
    50% {
      opacity: 0.2;
    }
  }

  @media (max-width: 960px) {
    .hero-readout {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-readout i {
      animation: none;
    }
  }

  .stat-label {
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  @media (max-width: 820px) {
    .hero-stats {
      grid-template-columns: 1fr 1fr;
    }

    .hero-stats li,
    .hero-stats li + li {
      padding: 20px 16px 20px 0;
      border-left: 0;
    }

    .hero-stats li:nth-child(even) {
      padding-left: 16px;
      border-left: 1px solid var(--line);
    }

    .hero-stats li:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }
</style>
