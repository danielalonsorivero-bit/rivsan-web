---
import { Image } from 'astro:assets';
import poster from '../../assets/img/hero-video-poster.jpg';
import video720 from '../../assets/video/hero-720.mp4?url';
import video1080 from '../../assets/video/hero-1080.mp4?url';
import SignalFx from '../SignalFx.astro';
import { hero as h } from '../../data/contenido/home.json';

// Textos y cifras editables desde el panel (Portada). `animar`: la cifra se anima desde 0 al aparecer
// (ver BaseLayout), solo si es un número entero.
const stats = h.cifras.map((c) => ({ ...c, animar: c.animar && /^\d+$/.test(c.valor) }));
---

<section class="hero">
  <!-- Fotograma inicial (carga al instante) → vídeo → el vídeo pasa por un shader de señal NTSC en el canvas.
       Con «reducir movimiento», ahorro de datos o sin autoplay se queda el fotograma. -->
  <Image
    src={poster}
    alt="Dos agentes con visores de realidad virtual avanzan en binomio y se giran empuñando armas simuladas"
    class="hero-bg hero-poster"
    widths={[800, 1400, 1920]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <video
    class="hero-bg hero-video"
    data-senal-video
    data-src-sd={video720}
    data-src-hd={video1080}
    muted
    loop
    playsinline
    preload="none"
    aria-hidden="true"></video>
  <canvas class="hero-bg hero-gl" data-senal-gl aria-hidden="true"></canvas>
  <div class="hero-shade" aria-hidden="true"></div>
  <SignalFx />
  <p class="hero-readout data" aria-hidden="true">
    <span><i></i> <b data-hero-status>SIM ACTIVO</b></span>
    <span data-hero-clock>T+00:00.000</span>
    <span>ESCENARIO 01 · BINOMIO</span>
  </p>

  <div class="container hero-content">
    {h.antetitulo && <p class="eyebrow">{h.antetitulo}</p>}
    <h1 class="h-xl">{h.titulo} {h.acento && <span class="accent">{h.acento}</span>}</h1>
    {h.entrada && <p class="lead">{h.entrada}</p>}
    <div class="hero-actions">
      <a href="#contacto" class="btn btn-primary">Solicitar demostración <span class="arrow">→</span></a>
      <a href="#perfiles" class="btn btn-ghost">Ver soluciones</a>
    </div>
  </div>

  <div class="container">
    <ul class="hero-stats">
      {
        stats.map((s) => (
          <li>
            <span class="stat-value">
              {s.prefijo}<span data-count={s.animar ? s.valor : undefined}>{s.valor}</span>
              {s.unidad && <small>{s.unidad}</small>}
            </span>
            <span class="stat-label">{s.texto}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  import { videoConSenal } from '../../scripts/senal';

  // Vídeo del hero con el shader de señal (ver scripts/senal.ts). En la costura del bucle la
  // lectura del visor avisa de que se resincroniza.
  const hero = document.querySelector<HTMLElement>('.hero');
  const status = document.querySelector('[data-hero-status]');
  if (hero)
    videoConSenal(hero, {
      alCorte: (corte) => status && (status.textContent = corte ? 'SEÑAL · RESYNC' : 'SIM ACTIVO'),
    });
</script>

<script>
  // Reloj de la lectura del visor (no corre con «reducir movimiento»)
  const clock = document.querySelector('[data-hero-clock]');
  if (clock && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const start = performance.now();
    const pad = (n: number, l = 2) => String(n).padStart(l, '0');
    let on = false;
    const tick = () => {
      if (!on) return;
      const ms = Math.floor(performance.now() - start);
      clock.textContent = `T+${pad(Math.floor(ms / 60000))}:${pad(Math.floor(ms / 1000) % 60)}.${pad(ms % 1000, 3)}`;
      requestAnimationFrame(tick);
    };
    // Solo corre mientras el hero está en pantalla
    new IntersectionObserver(([e]) => {
      on = e.isIntersecting;
      if (on) requestAnimationFrame(tick);
    }).observe(clock);
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-top: calc(var(--header-h) + 48px);
    overflow: hidden;
    isolation: isolate;
  }

  /* Encuadre del vídeo, centrado para no cortar el arma del agente de la derecha.
     --media-shift (fracción del ancho) lo desplazaría a la derecha, fundiendo el borde a negro.
     El shader lee las mismas variables (scripts/senal.ts). */
  .hero {
    --fx-cycle: 7s;
    --media-x: 0.5;
    --media-shift: 0;
    /* Botón de pausa del vídeo, bajo la lectura del visor */
    --pausa-top: calc(var(--header-h) + 108px);
    --pausa-right: var(--gutter);
  }

  @media (max-width: 960px) {
    .hero {
      --media-x: 0.3;
      --pausa-top: calc(var(--header-h) + 16px);
    }
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: calc(var(--media-x) * 100%) 50%;
    z-index: -2;
  }

  .hero-poster,
  .hero-video {
    translate: calc(var(--media-shift) * 100%) 0;
  }

  .hero-video,
  .hero-gl {
    opacity: 0;
  }

  /* Con WebGL el vídeo sigue reproduciéndose (es la textura) pero solo se ve el canvas */
  .hero.is-video .hero-video,
  .hero.is-gl .hero-gl {
    opacity: 1;
  }

  .hero.is-video .hero-poster,
  .hero.is-gl .hero-poster {
    visibility: hidden;
  }

  /* Sin WebGL: el fotograma o el vídeo tiemblan un instante cada --fx-cycle */
  @media (prefers-reduced-motion: no-preference) {
    .hero-poster,
    .hero-video {
      animation: jitter var(--fx-cycle) steps(1, end) infinite;
    }
  }

  @keyframes jitter {
    0%,
    86% {
      transform: none;
    }
    87% {
      transform: translate(-3px, 0) skewX(-0.6deg);
    }
    88% {
      transform: translate(2px, 1px);
    }
    89% {
      transform: translate(-1px, 0);
    }
    90%,
    95% {
      transform: none;
    }
    96% {
      transform: translate(2px, 0);
    }
    97% {
      transform: none;
    }
  }

  .hero-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgba(11, 11, 11, 0.92) 0%, rgba(11, 11, 11, 0.55) 55%, rgba(11, 11, 11, 0.2) 100%),
      linear-gradient(0deg, var(--bg) 0%, transparent 40%);
  }

  .hero-content {
    max-width: var(--max);
  }

  .hero-content h1 {
    font-size: clamp(2.75rem, 5.4vw, 5.25rem);
    max-width: 12em;
  }

  .hero-content h1 .accent {
    display: block;
    margin-bottom: 1.5rem;
  }

  .hero-content .lead {
    color: #d6d6d0;
    max-width: 52ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 2rem;
  }

  .hero-stats {
    list-style: none;
    padding: 0;
    margin: clamp(48px, 8vh, 96px) 0 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--line-strong);
  }

  .hero-stats li {
    padding: 28px 24px 40px 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .hero-stats li + li {
    padding-left: 24px;
    border-left: 1px solid var(--line);
  }

  .stat-value {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    line-height: 1;
    color: var(--yellow);
  }

  .stat-value small {
    font-family: var(--font-data);
    font-size: 0.3em;
    text-transform: uppercase;
    margin-left: 0.25em;
    color: var(--text);
    letter-spacing: 0.05em;
  }

  /* Lectura tipo visor en la esquina superior derecha */
  .hero-readout {
    position: absolute;
    top: calc(var(--header-h) + 24px);
    right: var(--gutter);
    margin: 0;
    display: grid;
    justify-items: end;
    gap: 4px;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: rgba(242, 242, 240, 0.7);
  }

  .hero-readout i {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #ff5a5f;
    margin-right: 6px;
    animation: rec 1.2s steps(2) infinite;
  }

  @keyframes rec {
    50% {
      opacity: 0.2;
    }
  }

  @media (max-width: 960px) {
    .hero-readout {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-readout i {
      animation: none;
    }
  }

  .stat-label {
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  @media (max-width: 820px) {
    .hero-stats {
      grid-template-columns: 1fr 1fr;
    }

    .hero-stats li,
    .hero-stats li + li {
      padding: 20px 16px 20px 0;
      border-left: 0;
    }

    .hero-stats li:nth-child(even) {
      padding-left: 16px;
      border-left: 1px solid var(--line);
    }

    .hero-stats li:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }
</style>
