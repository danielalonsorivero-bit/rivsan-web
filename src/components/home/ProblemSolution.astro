---
// v2: los dos modelos se comparan en una tabla, fila a fila: cada punto del modelo tradicional
// tiene enfrente su respuesta en el modelo RIVSAN.
const traditional = [
  'Desplazar a la plantilla a una galería externa, con turnos que cubrir.',
  'Réplicas de plástico que alteran el tacto y rompen los automatismos.',
  'Ejercicios en binomio o vídeo pasivo: la unidad nunca entrena junta.',
  'Munición, dietas y alquileres que se repiten cada año.',
  'Evaluación a ojo, sin datos de lo que pasó.',
];

const rivsan = [
  'El entrenamiento va a tu jefatura: los agentes no salen del municipio.',
  'Armas con el peso, equilibrio y tacto de las de dotación.',
  'Toda la unidad en el mismo escenario: entradas, perímetros, desescalada.',
  'Sin munición ni galería: el coste por sesión cae y se puede entrenar más a menudo.',
  'Cada intervención queda registrada y se revisa en 3D.',
];
---

<section class="section problem" id="solucion">
  <div class="container">
    <div class="intro">
      <p class="eyebrow">Por qué cambiar</p>
      <h2 class="h-lg">Entrenar más a menudo <span class="accent">cuesta menos</span></h2>
      <p class="lead">
        La calle exige coordinación y decisiones bajo presión, y en Andalucía la formación continua ya es obligatoria. El
        modelo de siempre no da para entrenar con la frecuencia necesaria.
      </p>
    </div>

    <table class="compare">
      <caption class="visually-hidden">Modelo tradicional frente a modelo RIVSAN</caption>
      <thead>
        <tr>
          <th scope="col" class="col-old">
            <span class="model">Modelo tradicional</span>
            <span class="cost"><strong>+21.500 €</strong> / año en costes logísticos estimados</span>
          </th>
          <th scope="col" class="col-new">
            <span class="model">Modelo RIVSAN</span>
            <span class="cost"><strong>Equipo móvil</strong> de instrucción desplegado en tu jefatura</span>
          </th>
        </tr>
      </thead>
      <tbody>
        {
          traditional.map((t, i) => (
            <tr>
              <td class="col-old">{t}</td>
              <td class="col-new">{rivsan[i]}</td>
            </tr>
          ))
        }
      </tbody>
    </table>

    <div class="next">
      <a href="/normativa/#calculadora" class="link-arrow">Calcula lo que te cuesta seguir igual</a>
      <a href="/normativa/" class="link-plain">Ley 6/2023 y Decreto 8/2026</a>
    </div>
  </div>
</section>

<style>
  .intro {
    max-width: 940px;
    margin-bottom: clamp(32px, 4vw, 56px);
  }

  .intro h2 {
    margin-bottom: 1.25rem;
  }

  .compare {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }

  th,
  td {
    width: 50%;
    text-align: left;
    vertical-align: top;
    padding: 18px clamp(16px, 2.4vw, 32px);
  }

  th {
    padding-block: 24px 28px;
    font-weight: 400;
  }

  th.col-old {
    border-top: 3px solid var(--line-strong);
  }

  /* La columna RIVSAN se rotula en amarillo */
  th.col-new {
    background: var(--yellow);
    color: var(--ink);
  }

  .model {
    display: block;
    font-weight: 700;
    margin-bottom: 10px;
  }

  .cost {
    display: block;
    font-size: 0.975rem;
  }

  .cost strong {
    display: block;
    font-family: var(--font-display);
    font-stretch: var(--wide);
    font-weight: 800;
    font-size: clamp(1.6rem, 2.6vw, 2.25rem);
    line-height: 1.05;
    text-transform: uppercase;
    margin-bottom: 4px;
  }

  th.col-old .cost {
    color: var(--text-muted);
  }

  th.col-old .cost strong {
    color: var(--text);
  }

  td {
    border-bottom: 1px solid var(--line);
  }

  td.col-old {
    color: var(--text-muted);
  }

  td.col-new {
    border-left: 3px solid var(--yellow);
    font-weight: 500;
  }

  .next {
    margin-top: 36px;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 12px 32px;
  }

  .link-plain {
    color: var(--text-muted);
  }

  .link-plain:hover {
    color: var(--text);
  }

  /* En móvil cada fila apila sus dos celdas: primero el problema, debajo la respuesta */
  @media (max-width: 720px) {
    .compare,
    .compare :is(thead, tbody, tr, th, td) {
      display: block;
      width: 100%;
    }

    tbody tr {
      padding-block: 16px;
      border-bottom: 1px solid var(--line);
    }

    td {
      border: 0;
      padding: 4px 0 4px 16px;
    }

    td.col-old::before,
    td.col-new::before {
      display: block;
      font-size: 0.875rem;
      font-weight: 700;
    }

    td.col-old::before {
      content: 'Modelo tradicional';
    }

    td.col-new::before {
      content: 'Modelo RIVSAN';
    }

    td.col-old {
      border-left: 3px solid var(--line-strong);
    }

    td.col-new {
      margin-top: 8px;
    }
  }
</style>
