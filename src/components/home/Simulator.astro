---
import { Image } from 'astro:assets';
import kit from '../../assets/img/kit-armas.jpg';
import team from '../../assets/img/equipo-4.jpg';
import aar from '../../assets/img/aar-pantalla.jpg';

const features = [
  {
    eyebrow: 'Fidelidad real',
    title: ['Entrena igual', 'que actúas'],
    text: 'Con el sistema SuitUp el agente trabaja con un arma que reproduce la de dotación: mismo peso, tacto, equilibrio y automatismos. Entrena bajo la fisiología real del estrés, en un entorno seguro.',
    points: ['Kit SuitUp sobre arma de dotación simulada', 'Movimiento 1:1, sin vicios de entrenamiento', 'Montado en menos de 60 minutos'],
    image: kit,
    alt: 'Kit de entrenamiento con visor de realidad virtual, pistola y fusil simulados',
  },
  {
    eyebrow: 'Trabajo en equipo',
    title: ['Más allá del binomio:', 'coordinación táctica real'],
    text: 'Hasta 12 agentes comparten el mismo escenario virtual para ensayar entradas en inmuebles, perímetros de seguridad, gestión de masas y desescalada verbal.',
    points: ['Hasta 12 agentes simultáneos', 'Verbalización y uso progresivo de la fuerza', 'Equipos en distintas localizaciones con Command Kit'],
    image: team,
    alt: 'Cuatro operadores con visores de realidad virtual avanzan en formación en un aula',
  },
  {
    eyebrow: 'Auditoría objetiva',
    title: ['Mide lo que', 'realmente entrenas'],
    text: 'El módulo After-Action Review registra el cono de visión, los tiempos de reacción en milisegundos y las trayectorias de disparo. Rebobina la intervención en 3D desde cualquier ángulo.',
    points: ['Tiempos de reacción en milisegundos', 'Conos de visión y trayectorias de disparo', 'Reproducción 3D para la revisión operativa'],
    image: aar,
    alt: 'Agente de policía junto a una pantalla con la reconstrucción 3D de un ejercicio',
  },
];

const weapons = [
  { name: 'Clase A', level: 'Entrenamiento básico', text: 'Réplica impresa en 3D con sensores conductivos en corredera y gatillo.' },
  { name: 'Clase B', level: 'Entrenamiento avanzado', text: 'Plataforma airsoft modificada y funcional, con o sin gas.' },
  { name: 'Clase C', level: 'Bajo demanda', text: 'Adaptación sobre el arma real de dotación (Mantis Blackbeard o fogueo).' },
];
---

<section class="section simulator" id="simulador">
  <div class="container">
    <div class="head reveal">
      <p class="eyebrow">Simulador VR · RE-liON</p>
      <h2 class="h-lg">La solución: <span class="accent">entrenamiento inmersivo</span></h2>
      <p class="lead">
        Un sistema móvil que se despliega en la propia jefatura y convierte un espacio común en una zona táctica de alta
        fidelidad. Sin obras, sin sensores fijos, sin cables.
      </p>
    </div>

    <div class="features">
      {
        features.map((f, i) => (
          <article class:list={['feature', 'reveal', { 'feature--flip': i % 2 === 1 }]}>
            <div class="feature-media hud">
              <Image src={f.image} alt={f.alt} widths={[600, 1000]} sizes="(max-width: 820px) 100vw, 50vw" />
            </div>
            <div class="feature-body">
              <p class="eyebrow">{f.eyebrow}</p>
              <h3 class="h-lg">
                {f.title[0]} <span class="accent">{f.title[1]}</span>
              </h3>
              <p class="muted">{f.text}</p>
              <ul>
                {f.points.map((p) => <li>{p}</li>)}
              </ul>
            </div>
          </article>
        ))
      }
    </div>

    <div class="weapons reveal">
      <div class="weapons-head">
        <h3 class="h-md">Sistemas de armas</h3>
        <p class="muted">Tres clases que cubren cualquier tipo de escenario.</p>
        <a href="/simulador/" class="link-arrow">Conocer el simulador a fondo <span aria-hidden="true">→</span></a>
      </div>
      <div class="weapons-grid">
        {
          weapons.map((w) => (
            <div class="weapon">
              <span class="weapon-name">{w.name}</span>
              <span class="weapon-level">{w.level}</span>
              <p>{w.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .simulator {
    background: var(--bg-2);
    border-block: 1px solid var(--line);
  }

  .head {
    max-width: 780px;
    margin-bottom: 72px;
  }

  .head h2 {
    margin-bottom: 1.25rem;
  }

  .features {
    display: grid;
    gap: clamp(64px, 9vw, 120px);
  }

  .feature {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
  }

  .feature--flip .feature-media {
    order: 2;
  }

  .feature-media img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    filter: saturate(0.85) contrast(1.05);
  }

  .feature-body h3 {
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    margin-bottom: 1.25rem;
  }

  .feature-body ul {
    list-style: none;
    padding: 20px 0 0;
    margin: 8px 0 0;
    border-top: 1px solid var(--line);
    display: grid;
    gap: 10px;
  }

  .feature-body li {
    padding-left: 22px;
    position: relative;
  }

  .feature-body li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 8px;
    height: 8px;
    background: var(--yellow);
  }

  .weapons {
    margin-top: clamp(80px, 10vw, 128px);
    padding-top: 48px;
    border-top: 1px solid var(--line);
    display: grid;
    grid-template-columns: 1fr 2.4fr;
    gap: 40px;
  }

  .weapons-head h3 {
    margin-bottom: 0.75rem;
  }

  .weapons-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .weapon {
    background: var(--surface);
    border: 1px solid var(--line);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .weapon-name {
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1;
    color: var(--yellow);
  }

  .weapon-level {
    font-family: var(--font-label);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.875rem;
    margin-bottom: 8px;
  }

  .weapon p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.975rem;
  }

  @media (max-width: 960px) {
    .weapons {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 820px) {
    .feature {
      grid-template-columns: 1fr;
    }

    .feature--flip .feature-media {
      order: 0;
    }

    .weapons-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
