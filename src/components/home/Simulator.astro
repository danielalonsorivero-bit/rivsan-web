---
import { Image } from 'astro:assets';
import kit from '../../assets/img/kit-armas.jpg';
import team from '../../assets/img/equipo-4.jpg';
import aar from '../../assets/img/aar-pantalla.jpg';

// Resumen del simulador. El detalle (armas, configuraciones, módulos) está en /simulador/.
const features = [
  {
    tag: 'Sistema SuitUp',
    title: 'Entrena igual que actúas',
    text: 'El arma reproduce la de dotación: peso, tacto, equilibrio y automatismos. El agente se mueve 1:1 y entrena bajo el estrés real de la intervención.',
    image: kit,
    alt: 'Kit de entrenamiento con visor de realidad virtual, pistola y fusil simulados',
    href: '/simulador/#armas',
  },
  {
    tag: 'Hasta 12 agentes',
    title: 'La unidad completa, en el mismo escenario',
    text: 'Entradas en inmuebles, perímetros, gestión de masas y desescalada verbal. Incluso con equipos en distintas sedes.',
    image: team,
    alt: 'Cuatro operadores con visores de realidad virtual avanzan en formación en un aula',
    href: '/simulador/#configuraciones',
  },
  {
    tag: 'After-Action Review',
    title: 'Revisión 3D de cada intervención',
    text: 'Tiempos de reacción en milisegundos, conos de visión y trayectorias de disparo. Rebobina y revisa desde cualquier ángulo.',
    image: aar,
    alt: 'Agente de policía junto a una pantalla con la reconstrucción 3D de un ejercicio',
    href: '/simulador/#aar',
  },
];
---

<section class="section simulator" id="simulador">
  <div class="container">
    <div class="head reveal">
      <div>
        <p class="eyebrow">Simulador VR · Tecnología RE-liON</p>
        <h2 class="h-lg">Tu jefatura, <span class="accent">convertida en zona táctica</span></h2>
      </div>
      <div>
        <p class="lead">
          Un sistema inalámbrico que se monta en cualquier espacio cubierto y se recoge al terminar. Sin obras, sin sensores
          fijos, sin cables.
        </p>
        <a href="/simulador/" class="link-arrow">Conocer el simulador a fondo <span aria-hidden="true">→</span></a>
      </div>
    </div>

    <div class="cards">
      {
        features.map((f) => (
          <article class="card reveal">
            <div class="card-media hud">
              <Image src={f.image} alt={f.alt} widths={[480, 800]} sizes="(max-width: 960px) 100vw, 33vw" />
            </div>
            <span class="tag">{f.tag}</span>
            <h3>
              <a href={f.href}>{f.title}</a>
            </h3>
            <p class="muted">{f.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .head {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 24px 64px;
    align-items: end;
    margin-bottom: 56px;
  }

  .head .lead {
    margin-bottom: 1rem;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(20px, 3vw, 40px);
  }

  .card-media {
    margin-bottom: 24px;
  }

  .card-media img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    filter: saturate(0.85) contrast(1.05);
  }

  .tag {
    font-family: var(--font-label);
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .card h3 {
    font-size: clamp(1.75rem, 2.6vw, 2.25rem);
    margin: 8px 0 12px;
  }

  .card h3 a {
    text-decoration: none;
  }

  .card h3 a:hover {
    color: var(--yellow);
  }

  @media (max-width: 960px) {
    .head,
    .cards {
      grid-template-columns: 1fr;
    }

    .cards {
      gap: 48px;
    }
  }
</style>
