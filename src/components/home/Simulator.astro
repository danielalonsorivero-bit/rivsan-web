---
import { Image } from 'astro:assets';
import AarDemo from '../AarDemo.astro';
import kit from '../../assets/img/kit-armas.jpg';
import team from '../../assets/img/equipo-4.jpg';
import aar from '../../assets/img/aar-pantalla.jpg';

// Resumen del simulador. El detalle (armas, configuraciones, módulos) está en /simulador/.
// La demo del AAR va primero y las tres capacidades quedan debajo en una franja compacta.
const features = [
  {
    tag: 'Sistema SuitUp',
    title: 'Entrena igual que actúas',
    text: 'El arma reproduce la de dotación: peso, tacto, equilibrio y automatismos. El agente se mueve 1:1 y entrena bajo el estrés real de la intervención.',
    image: kit,
    alt: 'Kit de entrenamiento con visor de realidad virtual, pistola y fusil simulados',
    href: '/simulador/#armas',
  },
  {
    tag: 'Hasta 12 agentes',
    title: 'La unidad completa, en el mismo escenario',
    text: 'Entradas en inmuebles, perímetros, gestión de masas y desescalada verbal. Incluso con equipos en distintas sedes.',
    image: team,
    alt: 'Cuatro operadores con visores de realidad virtual avanzan en formación en un aula',
    href: '/simulador/#configuraciones',
  },
  {
    tag: 'After-Action Review',
    title: 'Revisión 3D de cada intervención',
    text: 'Tiempos de reacción en milisegundos, conos de visión y trayectorias de disparo. Rebobina y revisa desde cualquier ángulo.',
    image: aar,
    alt: 'Agente de policía junto a una pantalla con la reconstrucción 3D de un ejercicio',
    href: '/simulador/#aar',
  },
];
---

<section class="section simulator" id="simulador">
  <div class="container">
    <div class="head reveal">
      <div>
        <p class="eyebrow">Simulador VR · Tecnología RE-liON</p>
        <h2 class="h-lg">Tu jefatura, <span class="accent">convertida en zona táctica</span></h2>
      </div>
      <div>
        <p class="lead">
          Un sistema inalámbrico que se monta en cualquier espacio cubierto y se recoge al terminar. Sin obras, sin sensores
          fijos, sin cables.
        </p>
        <a href="/simulador/" class="link-arrow">Conocer el simulador a fondo <span aria-hidden="true">→</span></a>
      </div>
    </div>

    <!-- La demo del After-Action Review abre la sección: es lo que más se parece a usar el sistema -->
    <div class="try">
      <div class="try-text reveal">
        <p class="eyebrow">Pruébalo</p>
        <h3 class="h-md">Revisa una intervención como lo hace tu instructor</h3>
        <p class="muted">
          Cada ejercicio queda registrado: quién vio qué, cuándo y cómo respondió. Dale al play o arrastra la línea de
          tiempo.
        </p>
      </div>
      <div class="reveal">
        <AarDemo />
      </div>
    </div>

    <!-- Las tres capacidades, en una franja compacta bajo la demo -->
    <ul class="features">
      {
        features.map((f) => (
          <li class="feature reveal">
            <Image src={f.image} alt={f.alt} widths={[240, 400]} sizes="(max-width: 960px) 30vw, 140px" />
            <div>
              <span class="tag">{f.tag}</span>
              <h3>
                <a href={f.href}>{f.title}</a>
              </h3>
              <p class="muted">{f.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .head {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 24px 64px;
    align-items: end;
    margin-bottom: 56px;
  }

  .head .lead {
    margin-bottom: 1rem;
  }

  .try {
    display: grid;
    grid-template-columns: 1fr 2.3fr;
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
  }

  .try h3 {
    font-size: clamp(2rem, 3.4vw, 2.75rem);
    margin-bottom: 1rem;
  }

  .features {
    list-style: none;
    margin: clamp(56px, 7vw, 96px) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--line-strong);
  }

  .feature {
    display: grid;
    grid-template-columns: 112px 1fr;
    gap: 20px;
    align-items: start;
    padding: 28px 24px 0;
  }

  .feature:first-child {
    padding-left: 0;
  }

  .feature + .feature {
    border-left: 1px solid var(--line);
  }

  .feature img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    filter: saturate(0.85) contrast(1.05);
  }

  .tag {
    font-family: var(--font-label);
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .feature h3 {
    font-size: clamp(1.4rem, 1.9vw, 1.75rem);
    margin: 6px 0 8px;
  }

  .feature h3 a {
    text-decoration: none;
  }

  .feature h3 a:hover {
    color: var(--yellow);
  }

  .feature p {
    margin: 0;
    font-size: 0.95rem;
  }

  @media (max-width: 960px) {
    .try,
    .head,
    .features {
      grid-template-columns: 1fr;
    }

    .feature,
    .feature:first-child {
      padding: 24px 0;
    }

    .feature + .feature {
      border-left: 0;
      border-top: 1px solid var(--line);
    }
  }
</style>
