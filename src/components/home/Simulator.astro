---
import { Image } from 'astro:assets';
import AarDemo from '../AarDemo.astro';
import kit from '../../assets/img/kit-armas.jpg';
import team from '../../assets/img/equipo-4.jpg';
import aar from '../../assets/img/aar-pantalla.jpg';

// Resumen del simulador. El detalle (armas, configuraciones, módulos) está en /simulador/.
// v2: las tres capacidades van en filas con la foto a un lado, no en tarjetas iguales.
const features = [
  {
    tag: 'Sistema SuitUp',
    title: 'Entrena igual que actúas',
    text: 'El arma reproduce la de dotación: peso, tacto, equilibrio y automatismos. El agente se mueve 1:1 y entrena bajo el estrés real de la intervención.',
    image: kit,
    alt: 'Kit de entrenamiento con visor de realidad virtual, pistola y fusil simulados',
    href: '/simulador/#armas',
  },
  {
    tag: 'Hasta 12 agentes',
    title: 'La unidad completa, en el mismo escenario',
    text: 'Entradas en inmuebles, perímetros, gestión de masas y desescalada verbal. Incluso con equipos en distintas sedes.',
    image: team,
    alt: 'Cuatro operadores con visores de realidad virtual avanzan en formación en un aula',
    href: '/simulador/#configuraciones',
  },
  {
    tag: 'After-Action Review',
    title: 'Revisión 3D de cada intervención',
    text: 'Tiempos de reacción en milisegundos, conos de visión y trayectorias de disparo. Rebobina y revisa desde cualquier ángulo.',
    image: aar,
    alt: 'Agente de policía junto a una pantalla con la reconstrucción 3D de un ejercicio',
    href: '/simulador/#aar',
  },
];
---

<section class="section simulator" id="simulador">
  <div class="container">
    <div class="head">
      <div>
        <p class="eyebrow">Simulador VR, tecnología RE-liON</p>
        <h2 class="h-lg">Tu jefatura, <span class="accent">convertida en zona táctica</span></h2>
      </div>
      <div>
        <p class="lead">
          Un sistema inalámbrico que se monta en cualquier espacio cubierto y se recoge al terminar. Sin obras, sin sensores
          fijos, sin cables.
        </p>
        <a href="/simulador/" class="link-arrow">Conocer el simulador a fondo</a>
      </div>
    </div>

    <ul class="features">
      {
        features.map((f) => (
          <li class="feature">
            <Image src={f.image} alt={f.alt} widths={[480, 800]} sizes="(max-width: 820px) 100vw, 34vw" />
            <div class="feature-text">
              <p class="tag">{f.tag}</p>
              <h3>
                <a href={f.href}>{f.title}</a>
              </h3>
              <p class="muted">{f.text}</p>
            </div>
          </li>
        ))
      }
    </ul>

    <div class="try">
      <div class="try-text">
        <p class="eyebrow">Pruébalo</p>
        <h3 class="h-md">Revisa una intervención como lo hace tu instructor</h3>
        <p class="muted">
          Cada ejercicio queda registrado: quién vio qué, cuándo y cómo respondió. Dale al play o arrastra la línea de
          tiempo.
        </p>
      </div>
      <AarDemo />
    </div>
  </div>
</section>

<style>
  .head {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 24px 64px;
    align-items: end;
    margin-bottom: clamp(40px, 5vw, 64px);
  }

  .head .lead {
    margin-bottom: 1.25rem;
  }

  .features {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 3px solid var(--paper);
  }

  .feature {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(20px, 4vw, 56px);
    align-items: center;
    padding-block: clamp(24px, 3vw, 36px);
    border-bottom: 1px solid var(--line);
  }

  .feature img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .tag {
    font-weight: 600;
    color: var(--text-muted);
    margin-bottom: 8px;
  }

  .feature h3 {
    font-family: var(--font-display);
    font-stretch: var(--wide);
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    line-height: 1.02;
    margin-bottom: 14px;
  }

  .feature h3 a {
    text-decoration: none;
  }

  .feature h3 a:hover {
    text-decoration: underline;
    text-decoration-color: var(--yellow);
    text-decoration-thickness: 4px;
    text-underline-offset: 6px;
  }

  .feature-text p:last-child {
    max-width: 56ch;
    margin: 0;
  }

  .try {
    margin-top: clamp(64px, 8vw, 112px);
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
  }

  .try h3 {
    margin-bottom: 1rem;
  }

  @media (max-width: 960px) {
    .try,
    .head {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 820px) {
    .feature {
      grid-template-columns: 1fr;
    }
  }
</style>
