---
import { Image } from 'astro:assets';
import { perfiles } from '../../data/perfiles';
import { videoPerfil } from '../../data/videos';

// v2: los perfiles son un índice en filas, no tarjetas. Cada fila lleva su fotograma a la derecha
// y reproduce el vídeo al pasar el cursor o al enfocarla (en táctil, cuando está centrada en pantalla).
const filas = perfiles.map((p) => ({ ...p, video: videoPerfil(p.slug) }));
---

<section class="section profiles theme-light" id="perfiles">
  <div class="container">
    <div class="head">
      <p class="eyebrow">Para quién</p>
      <h2 class="h-lg">Cada unidad tiene <span class="accent">su misión</span></h2>
    </div>

    <ul class="rows">
      {
        filas.map((p) => (
          <li class="row" data-card-video={p.video ? '' : undefined}>
            <h3>
              <a href={`/soluciones/${p.slug}/`} class="stretched">
                {p.label}
              </a>
            </h3>
            <p>{p.short}</p>
            <div class="media">
              <Image src={p.video?.poster ?? p.image} alt="" widths={[360, 640]} sizes="(max-width: 820px) 100vw, 300px" />
              {p.video && <video muted loop playsinline preload="none" data-src={p.video.sd} aria-hidden="true" />}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  // Reproducción al pasar el cursor; cada arranque empieza con un corte de señal breve
  const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const tactil = matchMedia('(hover: none)').matches;
  const filas = [...document.querySelectorAll<HTMLElement>('[data-card-video]')];

  const reproducir = (fila: HTMLElement) => {
    const v = fila.querySelector('video')!;
    if (!v.src) v.src = v.dataset.src!;
    v.play().then(
      () => {
        fila.classList.add('is-playing', 'is-cortando');
        setTimeout(() => fila.classList.remove('is-cortando'), 380);
      },
      () => {},
    );
  };
  const parar = (fila: HTMLElement) => {
    fila.classList.remove('is-playing');
    fila.querySelector('video')!.pause();
  };

  if (!quieto) {
    if (tactil) {
      // Sin cursor: se reproduce la fila que está en el centro de la pantalla
      const io = new IntersectionObserver(
        (entradas) => entradas.forEach((e) => (e.isIntersecting ? reproducir : parar)(e.target as HTMLElement)),
        { rootMargin: '-35% 0px -35% 0px' },
      );
      filas.forEach((c) => io.observe(c));
    } else {
      filas.forEach((c) => {
        c.addEventListener('pointerenter', () => reproducir(c));
        c.addEventListener('pointerleave', () => parar(c));
        c.addEventListener('focusin', () => reproducir(c));
        c.addEventListener('focusout', () => parar(c));
      });
    }
  }
</script>

<style>
  .head {
    max-width: 940px;
    margin-bottom: clamp(32px, 4vw, 56px);
  }

  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 3px solid var(--ink);
  }

  .row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr) 280px;
    gap: clamp(20px, 3vw, 48px);
    align-items: center;
    padding-block: clamp(20px, 2.4vw, 28px);
    border-bottom: 1px solid var(--line-strong);
  }

  .row h3 {
    font-stretch: var(--wide);
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(1.5rem, 2.6vw, 2.25rem);
    line-height: 1;
  }

  .row h3 a {
    text-decoration: none;
  }

  /* El enlace del título cubre toda la fila */
  .stretched::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .row:hover h3 a,
  .row:focus-within h3 a {
    text-decoration: underline;
    text-decoration-color: var(--yellow);
    text-decoration-thickness: 6px;
    text-underline-offset: 6px;
  }

  .row p {
    margin: 0;
    color: var(--text-muted);
  }

  .media {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--ink);
  }

  .media img,
  .media video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .media img {
    filter: grayscale(1) contrast(1.05);
    transition: filter 0.3s;
  }

  .row:hover .media img {
    filter: none;
  }

  .media video {
    opacity: 0;
    transition: opacity 0.3s;
  }

  .row.is-playing video {
    opacity: 1;
  }

  /* Corte de señal al arrancar: tirón horizontal y desdoble de color */
  .row.is-cortando video {
    animation: corte 0.38s steps(1, end);
  }

  @keyframes corte {
    0% {
      transform: translate(-8px, 0) skewX(-3deg);
      filter: contrast(1.6) saturate(2) hue-rotate(-30deg) drop-shadow(6px 0 0 rgba(255, 0, 60, 0.6));
    }
    25% {
      transform: translate(6px, 2px);
      filter: contrast(1.3) drop-shadow(-5px 0 0 rgba(0, 200, 255, 0.6));
    }
    50% {
      transform: translate(-3px, -1px) skewX(1.5deg);
      filter: brightness(1.4) drop-shadow(3px 0 0 rgba(247, 196, 0, 0.6));
    }
    75% {
      transform: translate(2px, 0);
      filter: none;
    }
    100% {
      transform: none;
      filter: none;
    }
  }

  @media (max-width: 820px) {
    .row {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .media {
      order: -1;
    }
  }
</style>
