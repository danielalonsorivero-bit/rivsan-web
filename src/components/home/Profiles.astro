---
import { Image } from 'astro:assets';
import { perfiles } from '../../data/perfiles';
---

<section class="section profiles" id="perfiles">
  <div class="container">
    <div class="head reveal">
      <p class="eyebrow">Para quién</p>
      <h2 class="h-lg">Cada unidad tiene <span class="accent">su misión</span></h2>
    </div>

    <div class="cards">
      {
        perfiles.map((p) => (
          <article class="card reveal">
            <Image src={p.image} alt="" widths={[480, 800]} sizes="(max-width: 820px) 100vw, 33vw" />
            <div class="card-body">
              <h3>
                <a href={`/soluciones/${p.slug}/`} class="stretched">
                  {p.label}
                </a>
              </h3>
              <p>{p.short}</p>
              <span class="link-arrow" aria-hidden="true">
                Ver solución →
              </span>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .head {
    max-width: 780px;
    margin-bottom: 48px;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .card {
    position: relative;
    isolation: isolate;
    min-height: 420px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    border: 1px solid var(--line);
  }

  .card img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
    filter: grayscale(0.4);
    transition: transform 0.6s ease, filter 0.6s ease;
  }

  .card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(0deg, rgba(11, 11, 11, 0.95) 25%, rgba(11, 11, 11, 0.2) 75%);
  }

  .card:hover img {
    transform: scale(1.04);
    filter: grayscale(0);
  }

  .card:hover {
    border-color: rgba(247, 196, 0, 0.5);
  }

  .card-body {
    padding: 28px;
  }

  .card h3 {
    font-size: clamp(2rem, 3vw, 2.5rem);
    margin-bottom: 10px;
  }

  .card h3 a {
    text-decoration: none;
  }

  /* El enlace del título cubre toda la tarjeta */
  .stretched::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card p {
    color: #d6d6d0;
    margin-bottom: 18px;
  }

  @media (max-width: 960px) {
    .cards {
      grid-template-columns: 1fr;
    }

    .card {
      min-height: 300px;
    }
  }
</style>
