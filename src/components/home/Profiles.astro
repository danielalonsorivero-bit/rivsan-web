---
import { Image } from 'astro:assets';
import { perfiles } from '../../data/perfiles';
import { videoPerfil } from '../../data/videos';

// Con vídeo, la tarjeta muestra su primer fotograma y lo reproduce al pasar el cursor
// (en pantallas táctiles, mientras la tarjeta está centrada en pantalla).
const tarjetas = perfiles.map((p) => ({ ...p, video: videoPerfil(p.slug) }));
---

<section class="section profiles" id="perfiles">
  <div class="container">
    <div class="head reveal">
      <p class="eyebrow">Para quién</p>
      <h2 class="h-lg">Cada unidad tiene <span class="accent">su misión</span></h2>
    </div>

    <div class="cards">
      {
        tarjetas.map((p) => (
          <article class="card reveal" data-card-video={p.video ? '' : undefined}>
            <Image src={p.video?.poster ?? p.image} alt="" widths={[480, 800]} sizes="(max-width: 820px) 100vw, 33vw" />
            {p.video && <video muted loop playsinline preload="none" data-src={p.video.sd} aria-hidden="true" />}
            <div class="card-body">
              <h3>
                <a href={`/soluciones/${p.slug}/`} class="stretched">
                  {p.label}
                </a>
              </h3>
              <p>{p.short}</p>
              <span class="link-arrow" aria-hidden="true">
                Ver solución →
              </span>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Reproducción al pasar el cursor; cada arranque empieza con un corte de señal breve
  const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const tactil = matchMedia('(hover: none)').matches;
  const tarjetas = [...document.querySelectorAll<HTMLElement>('[data-card-video]')];

  const reproducir = (card: HTMLElement) => {
    const v = card.querySelector('video')!;
    if (!v.src) v.src = v.dataset.src!;
    v.play().then(
      () => {
        card.classList.add('is-playing', 'is-cortando');
        setTimeout(() => card.classList.remove('is-cortando'), 380);
      },
      () => {},
    );
  };
  const parar = (card: HTMLElement) => {
    card.classList.remove('is-playing');
    card.querySelector('video')!.pause();
  };

  if (!quieto) {
    if (tactil) {
      // Sin cursor: se reproduce la tarjeta que está en el centro de la pantalla
      const io = new IntersectionObserver(
        (entradas) => entradas.forEach((e) => (e.isIntersecting ? reproducir : parar)(e.target as HTMLElement)),
        { rootMargin: '-35% 0px -35% 0px' },
      );
      tarjetas.forEach((c) => io.observe(c));
    } else {
      tarjetas.forEach((c) => {
        c.addEventListener('pointerenter', () => reproducir(c));
        c.addEventListener('pointerleave', () => parar(c));
        c.addEventListener('focusin', () => reproducir(c));
        c.addEventListener('focusout', () => parar(c));
      });
    }
  }
</script>

<style>
  .head {
    max-width: 780px;
    margin-bottom: 48px;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .card {
    position: relative;
    isolation: isolate;
    min-height: 420px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    border: 1px solid var(--line);
  }

  .card img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
    filter: grayscale(0.4);
    transition: transform 0.6s ease, filter 0.6s ease;
  }

  .card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(0deg, rgba(11, 11, 11, 0.95) 25%, rgba(11, 11, 11, 0.2) 75%);
  }

  .card:hover img {
    transform: scale(1.04);
    filter: grayscale(0);
  }

  .card video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .card.is-playing video {
    opacity: 1;
  }

  /* Líneas de barrido sobre el vídeo, como en el hero */
  .card[data-card-video]::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.25) 0 1px, transparent 1px 3px);
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .card.is-playing::before {
    opacity: 0.6;
  }

  /* Corte de señal al arrancar: tirón horizontal y desdoble de color */
  .card.is-cortando video {
    animation: corte 0.38s steps(1, end);
  }

  @keyframes corte {
    0% {
      transform: translate(-8px, 0) skewX(-3deg);
      filter: contrast(1.6) saturate(2) hue-rotate(-30deg) drop-shadow(6px 0 0 rgba(255, 0, 60, 0.6));
    }
    25% {
      transform: translate(6px, 2px);
      filter: contrast(1.3) drop-shadow(-5px 0 0 rgba(0, 200, 255, 0.6));
    }
    50% {
      transform: translate(-3px, -1px) skewX(1.5deg);
      filter: brightness(1.4) drop-shadow(3px 0 0 rgba(247, 196, 0, 0.6));
    }
    75% {
      transform: translate(2px, 0);
      filter: none;
    }
    100% {
      transform: none;
      filter: none;
    }
  }

  .card:hover {
    border-color: rgba(247, 196, 0, 0.5);
  }

  .card-body {
    padding: 28px;
  }

  .card h3 {
    font-size: clamp(2rem, 3vw, 2.5rem);
    margin-bottom: 10px;
  }

  .card h3 a {
    text-decoration: none;
  }

  /* El enlace del título cubre toda la tarjeta */
  .stretched::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card p {
    color: #d6d6d0;
    margin-bottom: 18px;
  }

  @media (max-width: 960px) {
    .cards {
      grid-template-columns: 1fr;
    }

    .card {
      min-height: 300px;
    }
  }
</style>
