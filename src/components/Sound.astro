---
// Sonidos de interfaz leves, sintetizados con Web Audio (sin archivos):
// un «bip» al pasar el ratón por un elemento interactivo y un «clic» al pulsar.
// Solo con ratón. Los navegadores no dejan sonar una página hasta que el usuario hace clic o
// pulsa una tecla en ella (pasar el ratón o hacer scroll no cuenta). El audio se prepara al cargar
// por si el navegador ya lo permite; si no, el interruptor lo indica y se activa con el primer clic.
// Se puede apagar con el interruptor fijo (la elección se recuerda en el navegador).
---

<button type="button" class="sound-toggle data" aria-pressed="true" data-sound-toggle hidden>
  <span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>
  <span data-sound-label>Sonido</span>
</button>

<script>
  const fine = matchMedia('(hover: hover) and (pointer: fine)');
  const toggle = document.querySelector<HTMLButtonElement>('[data-sound-toggle]');
  const INTERACTIVE = 'a, button, select, summary, label, [role="button"], input[type="range"], input[type="checkbox"], input[type="radio"]';
  const KEY = 'rivsan-sound';

  if (fine.matches && toggle) {
    let on = true;
    try {
      on = localStorage.getItem(KEY) !== 'off';
    } catch {}

    let ctx: AudioContext | null = null;
    let master: GainNode;
    let noise: AudioBuffer;
    let lastTarget: Element | null = null;
    let lastBip = 0;

    const setup = () => {
      if (ctx) return;
      ctx = new AudioContext();
      master = ctx.createGain();
      master.gain.value = 1;
      ctx.addEventListener('statechange', render);
      master.connect(ctx.destination);
      // 20 ms de ruido blanco para el clic
      noise = ctx.createBuffer(1, Math.round(ctx.sampleRate * 0.02), ctx.sampleRate);
      const data = noise.getChannelData(0);
      for (let i = 0; i < data.length; i++) data[i] = Math.random() * 2 - 1;
    };

    // Bip corto y agudo, con ataque y caída rápidos
    const bip = () => {
      if (!ctx || !on) return;
      const t = ctx.currentTime;
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      // Onda triangular: sus armónicos se oyen mejor en altavoces pequeños de portátil
      osc.type = 'triangle';
      osc.frequency.setValueAtTime(2000, t);
      osc.frequency.exponentialRampToValueAtTime(1600, t + 0.04);
      gain.gain.setValueAtTime(0, t);
      gain.gain.linearRampToValueAtTime(0.16, t + 0.004);
      gain.gain.exponentialRampToValueAtTime(0.0001, t + 0.05);
      osc.connect(gain).connect(master);
      osc.start(t);
      osc.stop(t + 0.06);
    };

    // Clic seco: ruido filtrado muy corto
    const click = () => {
      if (!ctx || !on) return;
      const t = ctx.currentTime;
      const src = ctx.createBufferSource();
      const filter = ctx.createBiquadFilter();
      const gain = ctx.createGain();
      src.buffer = noise;
      filter.type = 'highpass';
      filter.frequency.value = 1800;
      gain.gain.setValueAtTime(0.45, t);
      gain.gain.exponentialRampToValueAtTime(0.0001, t + 0.022);
      src.connect(filter).connect(gain).connect(master);
      src.start(t);
    };

    const label = toggle.querySelector('[data-sound-label]')!;
    function render() {
      // Encendido pero bloqueado por el navegador hasta el primer clic
      const waiting = on && ctx?.state !== 'running';
      toggle.setAttribute('aria-pressed', String(on));
      toggle.setAttribute('aria-label', on ? 'Desactivar sonidos de la interfaz' : 'Activar sonidos de la interfaz');
      toggle.classList.toggle('is-off', !on);
      toggle.classList.toggle('is-waiting', waiting);
      label.textContent = waiting ? 'Sonido · clic para activar' : 'Sonido';
    }

    // El primer gesto del usuario desbloquea el audio
    const unlock = () => {
      setup();
      if (ctx?.state === 'suspended') ctx.resume();
    };
    addEventListener('pointerdown', unlock, { capture: true });
    addEventListener('keydown', unlock, { capture: true });
    // Se intenta arrancar ya: algunos navegadores lo permiten si el usuario interactuó antes con la web
    unlock();

    document.addEventListener('pointerover', (e) => {
      if (e.pointerType !== 'mouse') return;
      const target = (e.target as Element).closest?.(INTERACTIVE) ?? null;
      if (target === lastTarget) return;
      lastTarget = target;
      const now = performance.now();
      if (target && target !== toggle && now - lastBip > 70) {
        lastBip = now;
        bip();
      }
    });

    document.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse' && e.button === 0) click();
    });

    toggle.addEventListener('click', () => {
      on = !on;
      try {
        localStorage.setItem(KEY, on ? 'on' : 'off');
      } catch {}
      render();
      if (on) bip();
    });

    toggle.hidden = false;
    render();
  } else if (toggle) {
    toggle.hidden = true;
  }
</script>

<style>
  .sound-toggle {
    position: fixed;
    left: 16px;
    bottom: 16px;
    z-index: 60;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 10px;
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    background: rgba(11, 11, 11, 0.8);
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    backdrop-filter: blur(6px);
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s;
  }

  .sound-toggle:hover {
    color: var(--text);
    border-color: var(--yellow);
  }

  /* Sin JS, en táctil o hasta que el script decide: oculto */
  .sound-toggle[hidden] {
    display: none;
  }

  .bars {
    display: inline-flex;
    align-items: flex-end;
    gap: 2px;
    height: 10px;
  }

  .bars i {
    width: 2px;
    background: var(--yellow);
    animation: eq 1.1s ease-in-out infinite;
  }

  .bars i:nth-child(1) {
    height: 40%;
  }

  .bars i:nth-child(2) {
    height: 100%;
    animation-delay: -0.4s;
  }

  .bars i:nth-child(3) {
    height: 65%;
    animation-delay: -0.7s;
  }

  @keyframes eq {
    50% {
      transform: scaleY(0.4);
    }
  }

  .bars i {
    transform-origin: bottom;
  }

  .sound-toggle.is-waiting {
    color: var(--text);
    border-color: rgba(247, 196, 0, 0.6);
  }

  .is-waiting .bars i {
    animation: none;
    height: 30%;
  }

  .is-off .bars i {
    animation: none;
    height: 2px;
    background: var(--text-dim);
  }

  @media (prefers-reduced-motion: reduce) {
    .bars i {
      animation: none;
    }
  }
</style>
