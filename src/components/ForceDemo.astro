---
// Esquema interactivo del uso progresivo de la fuerza: al subir la conducta del sujeto,
// se muestra la respuesta congruente del agente y el curso RIVSAN que la entrena.
// Esquema didáctico, no un protocolo: cada intervención se valora caso a caso.

const levels = [
  {
    subject: 'Cooperación',
    detail: 'Atiende las indicaciones y se identifica.',
    response: 'Presencia policial',
    responseDetail: 'Uniforme, posición y distancia de seguridad.',
    course: { label: 'Simulador · desescalada', href: '/simulador/#cqb' },
  },
  {
    subject: 'Resistencia verbal',
    detail: 'Se niega, discute o eleva el tono.',
    response: 'Verbalización',
    responseDetail: 'Órdenes claras, comunicación táctica y desescalada.',
    course: { label: 'Simulador · desescalada', href: '/simulador/#cqb' },
  },
  {
    subject: 'Resistencia pasiva',
    detail: 'No obedece y se queda inmóvil o se aferra.',
    response: 'Control de contacto',
    responseDetail: 'Guiado y control articular de baja intensidad.',
    course: { label: 'Control y arresto', href: '/formacion/control-y-arresto/' },
  },
  {
    subject: 'Resistencia activa',
    detail: 'Forcejea, empuja o intenta huir.',
    response: 'Reducción e inmovilización',
    responseDetail: 'Técnicas de reducción, control en suelo y engrilletamiento.',
    course: { label: 'Grappling táctico operativo', href: '/formacion/grappling-tactico-operativo/' },
  },
  {
    subject: 'Agresión con arma',
    detail: 'Ataca con un arma blanca o un objeto contundente.',
    response: 'Defensa y neutralización',
    responseDetail: 'Distancia, defensa ante armas y uso de medios reglamentarios.',
    course: { label: 'Defensa ante armas de filo e impacto', href: '/formacion/defensa-armas-filo-impacto/' },
  },
];
---

<div class="force" data-force>
  <div class="screen hud">
    <div class="screen-bar data" aria-hidden="true">
      <span>USO PROGRESIVO DE LA FUERZA</span>
      <span data-force-step>NIVEL 1 / {levels.length}</span>
    </div>

    <div class="board">
      <div class="heads data" aria-hidden="true">
        <span>Conducta del sujeto</span>
        <span>Respuesta del agente</span>
      </div>
      <!-- De menos a más grave, en orden de lectura: cada fila une conducta y respuesta -->
      <ol class="rows">
        {
          levels.map((l, i) => (
            <li data-i={i}>
              <button type="button" class="cell cell--subject">
                <strong>{l.subject}</strong>
                <span>{l.detail}</span>
              </button>
              <span class="arrow" aria-hidden="true" />
              <div class="cell cell--agent">
                <strong>{l.response}</strong>
                <span>{l.responseDetail}</span>
                <a href={l.course.href} class="course">
                  Se entrena en: {l.course.label} →
                </a>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <ul class="principles data" aria-label="Principios">
      <li>Congruencia</li>
      <li>Oportunidad</li>
      <li>Proporcionalidad</li>
    </ul>
  </div>

  <label class="control">
    <span class="data">Conducta del sujeto</span>
    <input type="range" min="1" max={levels.length} step="1" value="1" data-force-range aria-valuetext={levels[0].subject} />
  </label>
  <p class="note">
    Esquema didáctico. La respuesta se adapta siempre a la situación concreta, según los principios de la Ley Orgánica
    2/1986.
  </p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-force]').forEach((root) => {
    const range = root.querySelector<HTMLInputElement>('[data-force-range]')!;
    const step = root.querySelector('[data-force-step]')!;
    const rows = [...root.querySelectorAll<HTMLElement>('.rows li')];
    const total = Number(range.max);
    const names = [...root.querySelectorAll('.cell--subject strong')].map((s) => s.textContent ?? '');

    const set = (n: number) => {
      const i = n - 1;
      rows.forEach((r) => {
        const j = Number(r.dataset.i);
        r.classList.toggle('is-active', j === i);
        r.classList.toggle('is-below', j < i);
      });
      step.textContent = `NIVEL ${n} / ${total}`;
      range.value = String(n);
      range.setAttribute('aria-valuetext', names[i]);
      range.style.setProperty('--p', `${(i / (total - 1)) * 100}%`);
    };

    range.addEventListener('input', () => set(Number(range.value)));
    // Clic en la conducta de una fila también cambia el nivel
    rows.forEach((li) =>
      li.querySelector('.cell--subject')!.addEventListener('click', () => set(Number(li.dataset.i) + 1)),
    );
    set(1);
  });
</script>

<style>
  .screen {
    background: #070707;
    border: 1px solid var(--line-strong);
    color: var(--text);
  }

  .screen-bar {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 16px;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--text-muted);
    border-bottom: 1px solid var(--line);
  }

  .board {
    padding: 16px;
  }

  .heads,
  .rows li {
    display: grid;
    grid-template-columns: 1fr 40px 1fr;
  }

  .heads {
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 10px;
  }

  .heads span:last-child {
    grid-column: 3;
  }

  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .cell {
    padding: 10px 12px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.02);
    display: grid;
    align-content: start;
    gap: 2px;
    opacity: 0.35;
    transition: opacity 0.3s, border-color 0.3s, background 0.3s;
  }

  /* Botón que fija el nivel: hereda el aspecto de celda */
  .cell--subject {
    font: inherit;
    color: inherit;
    text-align: left;
    cursor: pointer;
  }

  li:not(.is-active) .cell--subject:hover {
    opacity: 0.8;
  }

  .cell strong {
    font-weight: 600;
    font-size: 0.975rem;
  }

  .cell > span {
    font-size: 0.8125rem;
    color: var(--text-muted);
    display: none;
  }

  .is-below .cell {
    opacity: 0.6;
  }

  .is-active .cell {
    opacity: 1;
  }

  .is-active .cell > span {
    display: block;
  }

  .is-active .cell--subject {
    border-color: #ff5a5f;
    background: rgba(255, 90, 95, 0.08);
  }

  .is-active .cell--agent {
    border-color: var(--yellow);
    background: rgba(247, 196, 0, 0.08);
  }

  .course {
    display: none;
    margin-top: 6px;
    font-family: var(--font-data);
    font-size: 0.75rem;
    color: var(--yellow);
    text-decoration: none;
  }

  .course:hover {
    text-decoration: underline;
  }

  .is-active .course {
    display: block;
  }

  /* Flecha de la conducta a la respuesta, solo en la fila activa */
  .arrow {
    position: relative;
    align-self: center;
    height: 2px;
    margin-inline: 6px;
    background: linear-gradient(90deg, #ff5a5f, var(--yellow));
    opacity: 0;
    transform: scaleX(0);
    transform-origin: left;
    transition: opacity 0.3s, transform 0.3s;
  }

  .arrow::after {
    content: '';
    position: absolute;
    right: -2px;
    top: -4px;
    border: 5px solid transparent;
    border-left-color: var(--yellow);
    border-right: 0;
  }

  .is-active .arrow {
    opacity: 1;
    transform: none;
  }

  .principles {
    list-style: none;
    margin: 0;
    padding: 12px 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    border-top: 1px solid var(--line);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .principles li::before {
    content: '✓ ';
    color: var(--yellow);
  }

  .control {
    display: grid;
    gap: 8px;
    margin-top: 16px;
  }

  .control > span {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  input[type='range'] {
    --p: 0%;
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 20px;
    margin: 0;
    background: transparent;
    cursor: pointer;
  }

  input[type='range']::-webkit-slider-runnable-track {
    height: 4px;
    background: linear-gradient(90deg, #ff5a5f var(--p), var(--line-strong) var(--p));
  }

  input[type='range']::-moz-range-track {
    height: 4px;
    background: linear-gradient(90deg, #ff5a5f var(--p), var(--line-strong) var(--p));
  }

  input[type='range']::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 16px;
    height: 16px;
    margin-top: -6px;
    background: #fff;
    border: 3px solid #ff5a5f;
    border-radius: 50%;
  }

  input[type='range']::-moz-range-thumb {
    width: 12px;
    height: 12px;
    background: #fff;
    border: 3px solid #ff5a5f;
    border-radius: 50%;
  }

  .note {
    margin: 8px 0 0;
    font-size: 0.8125rem;
    color: var(--text-dim);
  }

  @media (max-width: 640px) {
    .heads,
    .rows li {
      grid-template-columns: 1fr 16px 1fr;
    }

    .arrow {
      margin-inline: 2px;
    }

    .arrow::after {
      display: none;
    }
  }
</style>
