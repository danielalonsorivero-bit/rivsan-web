---
// Formulario de solicitud reutilizable (demo general y solicitud de un curso).
// TODO: conectar con el envío real cuando esté el alojamiento.
import { site } from '../data/site';

// Valores enlazados desde otras secciones con ?interes=<valor>#contacto
const interests = [
  { value: 'demo', label: 'Demostración operativa del simulador' },
  { value: 'jornada', label: 'Jornada formativa con simulador' },
  { value: 'renting', label: 'Renting anual del simulador' },
  { value: 'compra', label: 'Compra llave en mano' },
  { value: 'auxilios', label: 'Curso de primeros auxilios tácticos' },
  { value: 'fuerza', label: 'Curso de uso de la fuerza no letal' },
  { value: 'ahorro', label: 'Memoria justificativa / estudio de ahorro' },
  { value: 'tienda', label: 'Tienda de material táctico' },
  { value: 'otro', label: 'Otro' },
];

interface Props {
  /** Si se indica, el formulario es la solicitud de este curso */
  curso?: { titulo: string; id: string };
  /** Convocatorias para elegir (solo con `curso`) */
  convocatorias?: { id: string; label: string; disabled?: boolean }[];
  aDemanda?: boolean;
  submitLabel?: string;
  /** «ficha»: rejilla compacta horizontal para la ventana de inscripción (sin scroll en escritorio) */
  variant?: 'default' | 'ficha';
}

const { curso, convocatorias = [], aDemanda = true, submitLabel = 'Enviar solicitud', variant = 'default' } = Astro.props;
const uid = curso ? `f-${curso.id}` : 'f-demo';
---

<form class:list={['form', { 'form--ficha': variant === 'ficha' }]} data-request-form novalidate>
  {
    curso && (
      <>
        <input type="hidden" name="curso" value={curso.id} />
        <label class="f-conv">
          <span>Convocatoria *</span>
          <select name="convocatoria" required>
            {convocatorias.map((c) => (
              <option value={c.id} disabled={c.disabled}>
                {c.label}
              </option>
            ))}
            {aDemanda && <option value="a-demanda">En nuestras instalaciones / otra fecha</option>}
          </select>
        </label>
      </>
    )
  }

  <div class="row">
    <label class="f-nombre">
      <span>Nombre y apellidos *</span>
      <input name="nombre" autocomplete="name" required />
    </label>
    <label class="f-cargo">
      <span>Cargo *</span>
      <input name="cargo" placeholder="Ej. Intendente, Jefe de formación" required />
    </label>
  </div>

  <label class="f-unidad">
    <span>Jefatura / Unidad *</span>
    <input name="unidad" autocomplete="organization" placeholder="Ej. Policía Local de …" required />
  </label>

  <div class="row">
    <label class="f-email">
      <span>Email profesional *</span>
      <input name="email" type="email" autocomplete="email" required />
    </label>
    <label class="f-tel">
      <span>Teléfono</span>
      <input name="telefono" type="tel" autocomplete="tel" />
    </label>
  </div>

  {
    !curso && (
      <label>
        <span>¿Qué te interesa? *</span>
        <select name="interes" required>
          {interests.map((i) => (
            <option value={i.value}>{i.label}</option>
          ))}
        </select>
      </label>
    )
  }

  <div class="row">
    <label class="f-agentes">
      <span>{curso ? 'Nº de plazas que necesitas' : 'Nº de agentes a formar'}</span>
      <input name="agentes" type="number" min="1" inputmode="numeric" />
    </label>
    {
      !curso && (
        <label>
          <span>Fecha preferente</span>
          <input name="fecha" type="date" />
        </label>
      )
    }
  </div>

  <label class="f-msg">
    <span>Mensaje</span>
    <textarea
      name="mensaje"
      rows={variant === 'ficha' ? 2 : 4}
      placeholder={curso ? 'Dudas sobre el curso, necesidades de tu unidad…' : 'Cuéntanos qué necesitas: espacio disponible, objetivos de formación…'}
    ></textarea>
  </label>

  <label class="check f-check">
    <input type="checkbox" name="privacidad" required id={`${uid}-priv`} />
    <span>He leído y acepto la <a href="/legal/privacidad/" target="_blank">política de privacidad</a>. *</span>
  </label>

  <p class="gdpr">
    <strong>Responsable:</strong> {site.legalName}. <strong>Finalidad:</strong> atender tu solicitud.
    <strong>Legitimación:</strong> tu consentimiento. <strong>Destinatarios:</strong> no se ceden datos salvo
    obligación legal. <strong>Derechos:</strong> acceso, rectificación, supresión y otros, en
    <a href={`mailto:${site.privacyEmail}`}>{site.privacyEmail}</a>.
  </p>

  <button type="submit" class="btn btn-primary">{submitLabel} <span class="arrow">→</span></button>
  <p class="status" role="status" aria-live="polite" data-status></p>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-request-form]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('[data-status]')!;

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!form.checkValidity()) {
        form.classList.add('was-validated');
        status.textContent = 'Revisa los campos marcados.';
        status.dataset.state = 'error';
        form.querySelector<HTMLElement>(':invalid')?.focus();
        return;
      }
      status.textContent = 'Gracias. Te contactaremos en menos de 48 horas laborables. (Maqueta: el formulario aún no envía.)';
      status.dataset.state = 'ok';
      form.reset();
      form.classList.remove('was-validated');
    });
  });
</script>

<style>
  .form {
    background: var(--surface);
    border: 1px solid var(--line);
    padding: clamp(24px, 4vw, 48px);
    display: grid;
    gap: 20px;
  }

  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  label {
    display: grid;
    gap: 8px;
  }

  label > span {
    font-family: var(--font-label);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  input,
  select,
  textarea {
    width: 100%;
    font: inherit;
    font-size: 1rem;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    padding: 0.8em 0.9em;
    transition: border-color 0.2s;
    color-scheme: dark;
  }

  input::placeholder,
  textarea::placeholder {
    color: var(--text-dim);
  }

  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--yellow);
  }

  .was-validated :invalid {
    border-color: #e5484d;
  }

  .check {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .check input {
    width: 20px;
    height: 20px;
    flex: none;
    accent-color: var(--yellow);
    margin-top: 2px;
  }

  .check span {
    font-family: var(--font-body);
    text-transform: none;
    letter-spacing: 0;
    font-size: 0.95rem;
  }

  .check a {
    color: var(--yellow);
  }

  .gdpr {
    margin: -8px 0 0;
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--text-dim);
  }

  .gdpr strong {
    color: var(--text-muted);
    font-weight: 600;
  }

  .gdpr a {
    color: var(--text-muted);
  }

  .form .btn {
    justify-self: start;
  }

  .status {
    margin: 0;
    min-height: 1.5em;
    font-size: 0.95rem;
  }

  .status[data-state='ok'] {
    color: var(--yellow);
  }

  .status[data-state='error'] {
    color: #ff6b6b;
  }

  /* Variante ficha: todos los campos en una rejilla de tres columnas */
  .form--ficha {
    padding: 0;
    gap: 14px 16px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-areas:
      'conv conv agentes'
      'nombre cargo unidad'
      'email tel tel'
      'msg msg msg'
      'check check check'
      'gdpr gdpr gdpr'
      'btn status status';
    align-items: start;
  }

  .form--ficha .row {
    display: contents;
  }

  .form--ficha label {
    gap: 6px;
  }

  .form--ficha label > span {
    font-size: 0.75rem;
  }

  .form--ficha :is(input, select, textarea) {
    padding: 0.65em 0.8em;
  }

  .form--ficha .f-conv { grid-area: conv; }
  .form--ficha .f-agentes { grid-area: agentes; }
  .form--ficha .f-nombre { grid-area: nombre; }
  .form--ficha .f-cargo { grid-area: cargo; }
  .form--ficha .f-unidad { grid-area: unidad; }
  .form--ficha .f-email { grid-area: email; }
  .form--ficha .f-tel { grid-area: tel; }
  .form--ficha .f-msg { grid-area: msg; }
  .form--ficha .f-check { grid-area: check; }
  .form--ficha .gdpr { grid-area: gdpr; margin: -6px 0 0; font-size: 0.72rem; }
  .form--ficha .btn { grid-area: btn; }
  .form--ficha .status { grid-area: status; align-self: center; font-size: 0.875rem; }

  @media (max-width: 760px) {
    .form--ficha {
      grid-template-columns: 1fr 1fr;
      grid-template-areas:
        'conv conv'
        'agentes agentes'
        'nombre nombre'
        'cargo unidad'
        'email tel'
        'msg msg'
        'check check'
        'gdpr gdpr'
        'btn btn'
        'status status';
    }
  }

  @media (max-width: 480px) {
    .form--ficha {
      grid-template-columns: 1fr;
      grid-template-areas: 'conv' 'agentes' 'nombre' 'cargo' 'unidad' 'email' 'tel' 'msg' 'check' 'gdpr' 'btn' 'status';
    }
  }

  @media (max-width: 560px) {
    .row {
      grid-template-columns: 1fr;
    }

    .form .btn {
      justify-self: stretch;
    }
  }
</style>
