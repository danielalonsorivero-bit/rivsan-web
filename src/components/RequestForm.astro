---
// Formulario de solicitud reutilizable (demo general y solicitud de un curso).
// Envía a /api/solicitud/ (solicitudes/enviar.mjs) en Vercel y en `npm run dev`; en una
// compilación estática (GitHub Pages) no hay servidor y se queda en modo maqueta.
import { site } from '../data/site';

import { intereses as interests } from '../data/intereses.mjs';
import { fechas as fechasDemo } from '../data/contenido/demos.json';

// Fechas de demostración (panel → Fechas de demostración). Las pasadas se quitan aquí al compilar
// y en el navegador (la web puede llevar días sin recompilarse). Sin fechas: calendario libre.
const hoyCompilacion = new Date().toISOString().slice(0, 10);
const fechasLibres = fechasDemo.filter((f) => f.fecha > hoyCompilacion);
const fechaLarga = (iso: string) =>
  new Date(`${iso}T12:00:00Z`).toLocaleDateString('es-ES', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'UTC' });

interface Props {
  /** Si se indica, el formulario es la solicitud de este curso */
  curso?: { titulo: string; id: string };
  /** Convocatorias para elegir (solo con `curso`) */
  convocatorias?: { id: string; label: string; disabled?: boolean }[];
  aDemanda?: boolean;
  submitLabel?: string;
  /** «ficha»: rejilla compacta horizontal para la ventana de inscripción (sin scroll en escritorio) */
  variant?: 'default' | 'ficha';
}

const { curso, convocatorias = [], aDemanda = true, submitLabel = 'Enviar solicitud', variant = 'default' } = Astro.props;
const uid = curso ? `f-${curso.id}` : 'f-demo';
const conEnvio = !!process.env.VERCEL || process.env.ADMIN_SERVIDOR === '1' || import.meta.env.DEV;
const endpoint = conEnvio ? `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}api/solicitud/` : undefined;
---

<form
  class:list={['form', { 'form--ficha': variant === 'ficha' }]}
  data-request-form
  data-endpoint={endpoint}
  data-email={site.email}
  novalidate
>
  {
    curso && (
      <>
        <input type="hidden" name="curso" value={curso.titulo} />
        <label class="f-conv">
          <span>Convocatoria *</span>
          <select name="convocatoria" required>
            {convocatorias.map((c) => (
              <option value={c.id} disabled={c.disabled}>
                {c.label}
              </option>
            ))}
            {aDemanda && <option value="a-demanda">En nuestras instalaciones / otra fecha</option>}
          </select>
        </label>
      </>
    )
  }

  <div class="row">
    <label class="f-nombre">
      <span>Nombre y apellidos *</span>
      <input name="nombre" autocomplete="name" required />
    </label>
    <label class="f-cargo">
      <span>Cargo *</span>
      <input name="cargo" autocomplete="organization-title" placeholder="Ej. Intendente, Jefe de formación…" required />
    </label>
  </div>

  <label class="f-unidad">
    <span>Jefatura / Unidad *</span>
    <input name="unidad" autocomplete="organization" placeholder="Ej. Policía Local de …" required />
  </label>

  <div class="row">
    <label class="f-email">
      <span>Email profesional *</span>
      <input name="email" type="email" autocomplete="email" spellcheck="false" required />
    </label>
    <label class="f-tel">
      <span>Teléfono</span>
      <input name="telefono" type="tel" autocomplete="tel" />
    </label>
  </div>

  {
    !curso && (
      <label>
        <span>¿Qué te interesa? *</span>
        <select name="interes" required>
          {interests.map((i) => (
            <option value={i.value}>{i.label}</option>
          ))}
        </select>
      </label>
    )
  }

  <div class="row">
    <label class="f-agentes">
      <span>{curso ? 'Nº de plazas que necesitas' : 'Nº de agentes a formar'}</span>
      <input name="agentes" type="number" min="1" inputmode="numeric" />
    </label>
    {
      !curso && (
        <label>
          <span>Fecha preferente</span>
          {fechasLibres.length ? (
            <select name="fecha" data-fechas>
              <option value="">A convenir</option>
              {fechasLibres.map((f) => (
                <option value={f.fecha}>
                  {fechaLarga(f.fecha)}
                  {f.lugar && ` · ${f.lugar}`}
                </option>
              ))}
            </select>
          ) : (
            <input name="fecha" type="date" data-fecha />
          )}
        </label>
      )
    }
  </div>

  <label class="f-msg">
    <span>Mensaje</span>
    <textarea
      name="mensaje"
      rows={variant === 'ficha' ? 2 : 4}
      placeholder={curso ? 'Dudas sobre el curso, necesidades de tu unidad…' : 'Cuéntanos qué necesitas: espacio disponible, objetivos de formación…'}
    ></textarea>
  </label>

  <label class="check f-check">
    <input type="checkbox" name="privacidad" required id={`${uid}-priv`} />
    <span>He leído y acepto la <a href="/legal/privacidad/" target="_blank">política de privacidad</a>. *</span>
  </label>

  <p class="gdpr">
    <strong>Responsable:</strong> {site.legalName}. <strong>Finalidad:</strong> atender tu solicitud.
    <strong>Legitimación:</strong> tu consentimiento. <strong>Destinatarios:</strong> no se ceden datos salvo
    obligación legal. <strong>Derechos:</strong> acceso, rectificación, supresión y otros, en
    <a href={`mailto:${site.privacyEmail}`}>{site.privacyEmail}</a>.
  </p>

  <!-- Trampa para bots: invisible para las personas -->
  <label class="trampa" aria-hidden="true">
    <span>No rellenar</span>
    <input name="web" tabindex="-1" autocomplete="off" />
  </label>

  <button type="submit" class="btn btn-primary">{submitLabel} <span class="arrow">→</span></button>
  <p class="status" role="status" aria-live="polite" data-status></p>
</form>

<script>
  const cargado = performance.now();

  document.querySelectorAll<HTMLFormElement>('[data-request-form]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const boton = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const fecha = form.querySelector<HTMLInputElement>('[data-fecha]');
    const campos = [...form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input:not([type="hidden"]):not([name="web"]), select, textarea')];

    // Errores junto a cada campo: el texto va dentro de su <label> (oculto para el nombre accesible)
    // y se enlaza con aria-describedby para que el lector de pantalla lo lea al enfocar el campo
    const mensaje = (c: (typeof campos)[number]) => {
      const v = c.validity;
      if (c.type === 'checkbox') return 'Acepta la política de privacidad para enviar la solicitud.';
      if (v.valueMissing) return 'Este campo es obligatorio.';
      if (v.typeMismatch && c.type === 'email') return 'Escribe un email válido, p. ej. nombre@ayuntamiento.es.';
      if (v.rangeUnderflow) return `Indica ${(c as HTMLInputElement).min} o más.`;
      if (v.badInput) return 'Escribe solo números.';
      return c.validationMessage;
    };
    const marcar = (c: (typeof campos)[number]) => {
      const label = c.closest('label')!;
      let err = label.querySelector<HTMLElement>('.f-error');
      if (c.validity.valid) {
        c.removeAttribute('aria-invalid');
        err?.remove();
        return;
      }
      if (!err) {
        err = document.createElement('span');
        err.className = 'f-error';
        err.id = `${c.name}-${Math.random().toString(36).slice(2, 8)}-error`;
        err.setAttribute('aria-hidden', 'true');
        label.append(err);
        c.setAttribute('aria-describedby', err.id);
      }
      err.textContent = mensaje(c);
      c.setAttribute('aria-invalid', 'true');
    };
    // Tras el primer intento de envío, cada campo se revalida al corregirlo
    campos.forEach((c) =>
      ['input', 'change'].forEach((ev) =>
        c.addEventListener(ev, () => form.classList.contains('was-validated') && marcar(c)),
      ),
    );
    const limpiar = () => campos.forEach((c) => (c.removeAttribute('aria-invalid'), c.closest('label')!.querySelector('.f-error')?.remove()));

    // Fecha preferente: desde mañana. Más adelante se cruzará con las fechas disponibles.
    const hoyIso = () => {
      const d = new Date();
      return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
    };
    form.querySelectorAll<HTMLOptionElement>('[data-fechas] option[value]').forEach((o) => {
      if (o.value && o.value <= hoyIso()) o.remove();
    });
    if (fecha) {
      const m = new Date();
      m.setDate(m.getDate() + 1);
      fecha.min = `${m.getFullYear()}-${String(m.getMonth() + 1).padStart(2, '0')}-${String(m.getDate()).padStart(2, '0')}`;
    }
    const aviso = (texto: string, estado: 'ok' | 'error' | '') => {
      status.textContent = texto;
      status.dataset.state = estado;
    };
    const terminar = () => {
      aviso('Gracias. Te hemos enviado un correo de confirmación y te contactaremos en menos de 48 horas laborables.', 'ok');
      form.reset();
      form.classList.remove('was-validated');
      limpiar();
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.checkValidity()) {
        form.classList.add('was-validated');
        campos.forEach(marcar);
        const n = campos.filter((c) => !c.validity.valid).length;
        aviso(n === 1 ? 'Falta 1 campo por completar.' : `Faltan ${n} campos por completar.`, 'error');
        form.querySelector<HTMLElement>(':invalid')?.focus();
        return;
      }
      const endpoint = form.dataset.endpoint;
      if (!endpoint) {
        aviso('Gracias. Te contactaremos en menos de 48 horas laborables. (Maqueta: el formulario aún no envía.)', 'ok');
        form.reset();
        form.classList.remove('was-validated');
        limpiar();
        return;
      }

      // Los desplegables se envían con su texto visible, que es lo que se lee en los correos
      const datos: Record<string, unknown> = Object.fromEntries(new FormData(form));
      form.querySelectorAll('select').forEach((s) => (datos[s.name] = s.selectedOptions[0]?.text ?? ''));
      // La fecha va como AAAA-MM-DD (el servidor la valida y la escribe larga en los correos)
      const sel = form.querySelector<HTMLSelectElement>('[data-fechas]');
      if (sel) datos.fecha = sel.value;
      Object.assign(datos, { privacidad: datos.privacidad === 'on', pagina: location.href, t: Math.round(performance.now() - cargado) });

      boton.disabled = true;
      aviso('Enviando…', '');
      try {
        const res = await fetch(endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(datos) });
        const r = await res.json().catch(() => ({}));
        if (res.ok) terminar();
        else aviso(`${(r.error || 'No se ha podido enviar').replace(/\.$/, '')}. También puedes escribirnos a ${form.dataset.email}.`, 'error');
      } catch {
        aviso(`No se ha podido enviar. Comprueba la conexión o escríbenos a ${form.dataset.email}.`, 'error');
      } finally {
        boton.disabled = false;
      }
    });
  });
</script>

<style>
  .form {
    background: var(--surface);
    border: 1px solid var(--line);
    padding: clamp(24px, 4vw, 48px);
    display: grid;
    gap: 20px;
  }

  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    /* Un error bajo un campo no estira el campo vecino */
    align-items: start;
  }

  label {
    display: grid;
    gap: 8px;
  }

  label > span {
    font-family: var(--font-label);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  input,
  select,
  textarea {
    width: 100%;
    font: inherit;
    font-size: 1rem;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    padding: 0.8em 0.9em;
    transition: border-color 0.2s;
    color-scheme: dark;
  }

  input::placeholder,
  textarea::placeholder {
    color: var(--text-dim);
  }

  /* El anillo de foco global (:focus-visible) se mantiene; aquí solo se acerca al borde */
  input:focus,
  select:focus,
  textarea:focus {
    border-color: var(--yellow);
  }

  :is(input, select, textarea):focus-visible {
    outline-offset: 1px;
  }

  .was-validated :invalid {
    border-color: #e5484d;
  }

  /* Mensaje de error de un campo: va dentro de su <label>, así que deshace el estilo de etiqueta.
     Lo crea el script, sin el atributo de ámbito de Astro: de ahí :global */
  .form :global(.f-error) {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 0.85rem;
    line-height: 1.4;
    letter-spacing: 0;
    text-transform: none;
    color: #ff6b6b;
  }

  .check {
    flex-wrap: wrap;
  }

  .form .check :global(.f-error) {
    flex-basis: 100%;
    padding-left: 32px;
  }

  .check {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .check input {
    width: 20px;
    height: 20px;
    flex: none;
    accent-color: var(--yellow);
    margin-top: 2px;
  }

  .check span {
    font-family: var(--font-body);
    text-transform: none;
    letter-spacing: 0;
    font-size: 0.95rem;
  }

  .check a {
    color: var(--yellow);
  }

  .gdpr {
    margin: -8px 0 0;
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--text-dim);
  }

  .gdpr strong {
    color: var(--text-muted);
    font-weight: 600;
  }

  .gdpr a {
    color: var(--text-muted);
  }

  .form .btn {
    justify-self: start;
  }

  .status {
    margin: 0;
    min-height: 1.5em;
    font-size: 0.95rem;
  }

  .status[data-state='ok'] {
    color: var(--yellow);
  }

  .status[data-state='error'] {
    color: #ff6b6b;
  }

  /* Variante ficha: todos los campos en una rejilla de tres columnas */
  .form--ficha {
    padding: 0;
    gap: 14px 16px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-areas:
      'conv conv agentes'
      'nombre cargo unidad'
      'email tel tel'
      'msg msg msg'
      'check check check'
      'gdpr gdpr gdpr'
      'btn status status';
    align-items: start;
  }

  .form--ficha .row {
    display: contents;
  }

  .form--ficha label {
    gap: 6px;
  }

  .form--ficha label > span {
    font-size: 0.75rem;
  }

  .form--ficha :is(input, select, textarea) {
    padding: 0.65em 0.8em;
  }

  .form--ficha .f-conv { grid-area: conv; }
  .form--ficha .f-agentes { grid-area: agentes; }
  .form--ficha .f-nombre { grid-area: nombre; }
  .form--ficha .f-cargo { grid-area: cargo; }
  .form--ficha .f-unidad { grid-area: unidad; }
  .form--ficha .f-email { grid-area: email; }
  .form--ficha .f-tel { grid-area: tel; }
  .form--ficha .f-msg { grid-area: msg; }
  .form--ficha .f-check { grid-area: check; }
  .form--ficha .gdpr { grid-area: gdpr; margin: -6px 0 0; font-size: 0.72rem; }
  .form--ficha .btn { grid-area: btn; }
  .form--ficha .status { grid-area: status; align-self: center; font-size: 0.875rem; }

  @media (max-width: 760px) {
    .form--ficha {
      grid-template-columns: 1fr 1fr;
      grid-template-areas:
        'conv conv'
        'agentes agentes'
        'nombre nombre'
        'cargo unidad'
        'email tel'
        'msg msg'
        'check check'
        'gdpr gdpr'
        'btn btn'
        'status status';
    }
  }

  @media (max-width: 480px) {
    .form--ficha {
      grid-template-columns: 1fr;
      grid-template-areas: 'conv' 'agentes' 'nombre' 'cargo' 'unidad' 'email' 'tel' 'msg' 'check' 'gdpr' 'btn' 'status';
    }
  }

  @media (max-width: 560px) {
    .row {
      grid-template-columns: 1fr;
    }

    .form .btn {
      justify-self: stretch;
    }
  }

  .trampa {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>
