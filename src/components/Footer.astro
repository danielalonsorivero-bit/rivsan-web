---
import Logo from './Logo.astro';
import { site, nav } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <Logo />
      <p class="muted">
        Socio exclusivo de <a href={site.partner.url} target="_blank" rel="noopener">{site.partner.name}</a> en España.
        Simulación táctica inmersiva y formación especializada para quienes nos protegen.
      </p>
    </div>

    <div>
      <h2 class="footer-title">Explorar</h2>
      <ul>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </div>

    <div>
      <h2 class="footer-title">Contacto</h2>
      <ul>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a href={`tel:${site.phoneHref}`}>{site.phone}</a></li>
        <li class="muted">{site.address}</li>
      </ul>
      <a href="/#contacto" class="btn btn-primary footer-cta">Solicitar demo</a>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>© {year} {site.legalName} · CIF {site.cif}</p>
    <ul>
      <li><a href="/legal/aviso-legal/">Aviso legal</a></li>
      <li><a href="/legal/privacidad/">Privacidad</a></li>
      <li><a href="/legal/cookies/">Cookies</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    background: #070707;
    border-top: 1px solid var(--line);
    padding-top: 72px;
    font-size: 0.975rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: 48px;
    padding-bottom: 56px;
  }

  .footer-brand :global(.logo) {
    font-size: 19px;
    margin-bottom: 20px;
  }

  .footer-brand p {
    max-width: 40ch;
  }

  .footer-brand a {
    color: var(--yellow);
  }

  .footer-title {
    font-family: var(--font-label);
    font-weight: 600;
    font-size: 0.85rem;
    letter-spacing: 0.24em;
    color: var(--yellow);
    margin-bottom: 16px;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }

  ul a {
    text-decoration: none;
    color: var(--text);
  }

  ul a:hover {
    color: var(--yellow);
  }

  .footer-cta {
    margin-top: 24px;
    font-size: 0.875rem;
  }

  .footer-bottom {
    border-top: 1px solid var(--line);
    padding-block: 24px;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    color: var(--text-dim);
    font-size: 0.875rem;
  }

  .footer-bottom p {
    margin: 0;
  }

  .footer-bottom ul {
    display: flex;
    gap: 20px;
  }

  .footer-bottom a {
    color: var(--text-dim);
  }

  @media (max-width: 820px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }
</style>
