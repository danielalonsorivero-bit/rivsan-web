---
import Logo from './Logo.astro';
import { site, nav, footerExtra } from '../data/site';
const year = new Date().getFullYear();

// Una columna por cada desplegable del menú y otra con los enlaces sueltos
const groups = nav.filter((i) => i.children);
const loose = [...nav.filter((i) => !i.children), ...footerExtra];
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <Logo />
      <p class="muted">
        Socio exclusivo de <a href={site.partner.url} target="_blank" rel="noopener">{site.partner.name}</a> en España.
        Simulación táctica inmersiva y formación especializada para quienes nos protegen.
      </p>
    </div>

    {
      groups.map((g) => (
        <div>
          <h2 class="footer-title">{g.label}</h2>
          <ul>
            {g.children!.map((c) => (
              <li>
                <a href={c.href}>{c.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }

    <div>
      <h2 class="footer-title">RIVSAN</h2>
      <ul>
        {
          loose.map((item) => (
            <li>
              <a href={item.href}>
                {item.label}
                {item.soon && <span class="soon">Pronto</span>}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="footer-title">Contacto</h2>
      <ul>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a href={`tel:${site.phoneHref}`}>{site.phone}</a></li>
        <li class="muted">{site.address}</li>
      </ul>
      <a href="/#contacto" class="btn btn-primary footer-cta">Solicitar demo</a>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>© {year} {site.legalName}, CIF {site.cif}</p>
    <ul>
      <li><a href="/legal/aviso-legal/">Aviso legal</a></li>
      <li><a href="/legal/privacidad/">Privacidad</a></li>
      <li><a href="/legal/cookies/">Cookies</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    background: #1a1718;
    border-top: 6px solid var(--yellow);
  }

  /* Tras una sección amarilla (el contacto de la portada) el filete sobra */
  :global(main:has(> :last-child.theme-signal)) + .site-footer {
    border-top: 0;
    padding-top: 72px;
    font-size: 0.975rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr repeat(5, 1fr);
    gap: 40px;
    padding-bottom: 56px;
  }

  .footer-brand :global(.logo) {
    font-size: 19px;
    margin-bottom: 20px;
  }

  .footer-brand p {
    max-width: 40ch;
  }

  .footer-brand a {
    text-decoration-color: var(--yellow);
    text-decoration-thickness: 2px;
  }

  .footer-title {
    font-family: var(--font-body);
    font-stretch: 100%;
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0;
    text-transform: none;
    color: var(--text-muted);
    margin-bottom: 16px;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }

  ul a {
    text-decoration: none;
    color: var(--text);
  }

  ul a:hover {
    text-decoration: underline;
    text-decoration-color: var(--yellow);
    text-decoration-thickness: 2px;
  }

  .soon {
    margin-left: 6px;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 1px 6px;
    background: var(--yellow);
    color: var(--ink);
  }

  .footer-cta {
    margin-top: 24px;
    font-size: 0.875rem;
  }

  .footer-bottom {
    border-top: 1px solid var(--line);
    padding-block: 24px;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    color: var(--text-dim);
    font-size: 0.875rem;
  }

  .footer-bottom p {
    margin: 0;
  }

  .footer-bottom ul {
    display: flex;
    gap: 20px;
  }

  .footer-bottom a {
    color: var(--text-dim);
  }

  @media (max-width: 1080px) {
    .footer-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 620px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 32px 24px;
    }
  }
</style>
