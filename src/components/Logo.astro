---
// Logotipo horizontal: símbolo (de logo/rivsan_logo_blanco.svg) + texto en Montserrat.
interface Props {
  variant?: 'light' | 'dark';
  showTagline?: boolean;
  class?: string;
}
const { variant = 'light', showTagline = true, class: className } = Astro.props;
---

<span class:list={['logo', `logo--${variant}`, className]}>
  <svg class="logo-mark" viewBox="-73 -7 94 91" aria-hidden="true">
    <path
      class="logo-shape"
      d="M0,76.649L11.533,69.862L0.777,63.688L-10.816,70.321L0,76.649ZM-66.485,65.594L-55.972,59.577L-55.964,45.917L-66.582,52.061L-66.485,65.594ZM-12.072,19.39L-12.119,8.185L-23.727,1.366L-23.853,12.699L-12.072,19.39ZM-11.994,40.808L-7.157,43.821L-7.169,53.492L13.978,65.746L13.903,51.99L-26.387,28.903L-37.198,35.078L-37.405,29.669L-28.688,24.743L-28.678,1.231L-40.455,8.078L-40.446,53.338L-29.442,59.925L-34.255,62.646L-42.913,57.563L-64.152,69.888L-52.567,76.625L-12.091,53.421L-11.994,40.808ZM-20.495,70.458L-4.031,60.9L-9.602,57.623L-52.56,82.36L-71.55,71.141L-71.466,49.247L-51.043,37.511L-51.054,56.53L-45.49,53.356L-45.483,5.291L-26.436,-5.711L-7.175,5.409L-7.178,27.857L-23.655,18.376L-23.85,24.665L18.798,49.198L18.931,71.175L0.058,82.349L-20.495,70.458Z"
    ></path>
    <path
      class="logo-dot"
      transform="translate(-32.878 44.892)"
      d="M0,0.482C0.119,-2.24 1.434,-4.211 2.914,-5.213C5.105,-6.697 7.652,-6.822 9.789,-5.511C12.744,-3.696 13.897,-0.571 12.741,2.559C11.708,5.357 8.875,7.304 5.619,6.883C2.892,6.531 -0.152,3.97 0,0.482"
    ></path>
  </svg>
  <span class="logo-text" aria-hidden="true">
    <span class="logo-word">RIV<span class="logo-san">SAN</span></span>
    {showTagline && <span class="logo-tag">Formación táctica inmersiva</span>}
  </span>
  <span class="visually-hidden">RIVSAN — Formación Táctica Inmersiva</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    font-family: var(--font-brand);
    line-height: 1;
  }

  .logo-mark {
    width: 2.6em;
    height: auto;
    flex: none;
  }

  .logo--light .logo-shape {
    fill: #fff;
  }

  .logo--dark .logo-shape {
    fill: var(--ink);
  }

  .logo-dot {
    fill: var(--yellow);
  }

  .logo-text {
    display: flex;
    flex-direction: column;
  }

  .logo-word {
    font-weight: 400;
    font-size: 1.65em;
    letter-spacing: 0.01em;
  }

  .logo--light .logo-word {
    color: #fff;
  }

  .logo--dark .logo-word {
    color: var(--ink);
  }

  .logo-san {
    color: var(--yellow);
  }

  .logo-tag {
    font-weight: 300;
    font-size: 0.42em;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-top: 0.35em;
    white-space: nowrap;
  }

  .logo--light .logo-tag {
    color: #fff;
  }

  .logo--dark .logo-tag {
    color: var(--ink);
  }
</style>
